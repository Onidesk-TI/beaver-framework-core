    // ─── Maintenance: multi-operation service ──────────
    'service_maintenance' => [
        'titulo'    => 'Service — manutenção do sistema',
        'categoria' => 'Serviços',
        'descricao' => 'Um service que agrega várias operações: últimos jobs, limpar cache e otimizar BD.',
        'tags'      => ['Services', 'Maintenance', 'Cache', 'Database', 'Jobs'],
        'snippet'   => '// app/Services/MaintenanceService.php' . "\n" .
                       'namespace App\\Services;' . "\n\n" .
                       'use Beaver\\Cache\\Cache;' . "\n" .
                       'use Beaver\\Database\\Database;' . "\n" .
                       'use Beaver\\Scheduling\\ScheduledJob;' . "\n" .
                       'use PDO;' . "\n" .
                       'use Throwable;' . "\n\n" .
                       'class MaintenanceService' . "\n" .
                       '{' . "\n" .
                       '    public function __construct(' . "\n" .
                       '        private ?Cache $cache = null,' . "\n" .
                       '        private ?Database $db = null,' . "\n" .
                       '    ) {' . "\n" .
                       '        $this->cache ??= new Cache();' . "\n" .
                       '        $this->db    ??= Database::getInstance();' . "\n" .
                       '    }' . "\n\n" .
                       '    /** Runs everything and returns a summary. */' . "\n" .
                       '    public function runAll(int $limit = 5): array' . "\n" .
                       '    {' . "\n" .
                       '        return [' . "\n" .
                       '            "jobs"       => $this->recentJobs($limit),' . "\n" .
                       '            "cache_ok"   => $this->clearCache(),' . "\n" .
                       '            "optimize"   => $this->optimizeDatabase(),' . "\n" .
                       '        ];' . "\n" .
                       '    }' . "\n\n" .
                       '    /** Last N jobs that ran. */' . "\n" .
                       '    public function recentJobs(int $limit = 5): array' . "\n" .
                       '    {' . "\n" .
                       '        $jobs = ScheduledJob::query()' . "\n" .
                       '            ->whereNotNull("last_run_at")' . "\n" .
                       '            ->orderBy("last_run_at", "desc")' . "\n" .
                       '            ->limit($limit)' . "\n" .
                       '            ->get();' . "\n\n" .
                       '        return array_map(fn($j) => [' . "\n" .
                       '            "name"        => $j->name,' . "\n" .
                       '            "last_run_at" => $j->last_run_at,' . "\n" .
                       '            "last_status" => $j->last_status,' . "\n" .
                       '        ], $jobs);' . "\n" .
                       '    }' . "\n\n" .
                       '    /** Clears the whole cache. */' . "\n" .
                       '    public function clearCache(): bool' . "\n" .
                       '    {' . "\n" .
                       '        try {' . "\n" .
                       '            $this->cache->flush();' . "\n" .
                       '            return true;' . "\n" .
                       '        } catch (Throwable) {' . "\n" .
                       '            return false;' . "\n" .
                       '        }' . "\n" .
                       '    }' . "\n\n" .
                       '    /** Optimizes the database according to the driver. */' . "\n" .
                       '    public function optimizeDatabase(): array' . "\n" .
                       '    {' . "\n" .
                       '        $pdo    = $this->db->getPdo();' . "\n" .
                       '        $driver = $this->db->getDriverName();' . "\n\n" .
                       '        return match ($driver) {' . "\n" .
                       '            "sqlite" => $this->optimizeSqlite($pdo),' . "\n" .
                       '            "mysql"  => $this->optimizeMysql($pdo),' . "\n" .
                       '            "pgsql"  => $this->optimizePgsql($pdo),' . "\n" .
                       '            default  => ["ok" => false, "driver" => $driver],' . "\n" .
                       '        };' . "\n" .
                       '    }' . "\n\n" .
                       '    private function optimizeSqlite(PDO $pdo): array' . "\n" .
                       '    {' . "\n" .
                       '        $pdo->exec("PRAGMA optimize");' . "\n" .
                       '        $pdo->exec("VACUUM");' . "\n" .
                       '        return ["ok" => true, "driver" => "sqlite"];' . "\n" .
                       '    }' . "\n\n" .
                       '    private function optimizeMysql(PDO $pdo): array' . "\n" .
                       '    {' . "\n" .
                       '        $tables = $pdo->query("SHOW TABLES")->fetchAll(PDO::FETCH_COLUMN);' . "\n" .
                       '        foreach ($tables as $t) {' . "\n" .
                       '            $t = str_replace("`", "``", (string) $t);' . "\n" .
                       '            $pdo->exec("OPTIMIZE TABLE `{$t}`");' . "\n" .
                       '        }' . "\n" .
                       '        return ["ok" => true, "driver" => "mysql"];' . "\n" .
                       '    }' . "\n\n" .
                       '    private function optimizePgsql(PDO $pdo): array' . "\n" .
                       '    {' . "\n" .
                       '        $pdo->exec("VACUUM ANALYZE");' . "\n" .
                       '        return ["ok" => true, "driver" => "pgsql"];' . "\n" .
                       '    }' . "\n" .
                       '}' . "\n\n" .
                       '// From a Job:' . "\n" .
                       '// $s = new MaintenanceService();' . "\n" .
                       '// $r = $s->runAll(limit: 5);' . "\n" .
                       '// log_info("Maintenance", $r);',
        'lang'      => 'php',
    ],
];
