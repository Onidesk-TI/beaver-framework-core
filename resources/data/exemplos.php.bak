                       '$themes->deactivate();' . "\n\n" .
                       '// CLI' . "\n" .
                       '// php beaver theme:list' . "\n" .
                       '// php beaver theme:activate dark',
        'lang'      => 'php',
    ],

    // ─── Validação de email (caso real) ─────────────────
    'email_validation' => [
        'titulo'    => 'Validar email antes do POST',
        'categoria' => 'Validação',
        'descricao' => 'Valida o email no controller antes de gravar. Com regras encadeadas.',
        'tags'      => ['Validation', 'Email', 'HTTP', 'POST'],
        'snippet'   => '// POST /registar' . "\n" .
                       'public function registar(Request $req): Response' . "\n" .
                       '{' . "\n" .
                       '    // Validar ANTES de tocar na BD' . "\n" .
                       '    $errors = validate(' . "\n" .
                       '        $req->all(),' . "\n" .
                       '        [' . "\n" .
                       '            "email"    => "required|email",' . "\n" .
                       '            "password" => "required|min:8|confirmed",' . "\n" .
                       '            "idade"    => "integer|min:18",' . "\n" .
                       '        ],' . "\n" .
                       '        [' . "\n" .
                       '            "email"    => "Email",' . "\n" .
                       '            "password" => "Password",' . "\n" .
                       '            "idade"    => "Idade",' . "\n" .
                       '        ],' . "\n" .
                       '    );' . "\n\n" .
                       '    //  Se houver erros, devolver 422 com mensagens' . "\n" .
                       '    if ($errors !== []) {' . "\n" .
                       '        return Response::json([' . "\n" .
                       '            "ok"     => false,' . "\n" .
                       '            "errors" => $errors,' . "\n" .
                       '        ], 422);' . "\n" .
                       '    }' . "\n\n" .
                       '    //   Validar unicidade ANTES de criar' . "\n" .
                       '    $existe = User::where("email", $req->input("email"))->first();' . "\n" .
                       '    if ($existe !== null) {' . "\n" .
                       '        return Response::json([' . "\n" .
                       '            "ok"     => false,' . "\n" .
                       '            "errors" => [' . "\n" .
                       '                "email" => ["Email já registado."],' . "\n" .
                       '            ],' . "\n" .
                       '        ], 422);' . "\n" .
                       '    }' . "\n\n" .
                       '    //   Só agora criar' . "\n" .
                       '    $user = User::create([' . "\n" .
                       '        "email"    => $req->input("email"),' . "\n" .
                       '        "password" => hash_make($req->input("password")),' . "\n" .
                       '    ]);' . "\n\n" .
                       '    return Response::json([' . "\n" .
                       '        "ok"   => true,' . "\n" .
                       '        "user" => $user->toArray(),' . "\n" .
                       '    ], 201);' . "\n" .
                       '}',
        'lang'      => 'php',
    ],

