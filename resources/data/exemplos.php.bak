                       '$t->hooks->emit(HooksCatalog::ORDER_PLACED, $order);' . "\n\n" .
                       '$t->hooks->wasEmitted("order.placed");   // bool' . "\n" .
                       '$t->hooks->emitted("order.placed");      // array' . "\n" .
                       '$t->hooks->allEmitted();                 // array' . "\n\n" .
                       '// Reset entre testes' . "\n" .
                       '$t->hooks->reset();' . "\n\n" .
                       '// Manifest carregado' . "\n" .
                       '$manifest = $t->manifest();',
        'lang'      => 'php',
    ],

    'sdk_theme' => [
        'titulo'    => 'SDK — Temas',
        'categoria' => 'SDK',
        'descricao' => 'Gestão de temas (ativar, listar, assets e views).',
        'tags'      => ['SDK', 'Temas', 'Assets'],
        'snippet'   => 'use Beaver\\Sdk\\Theme\\ThemeManager;' . "\n" .
                       'use Beaver\\Sdk\\Theme\\ThemePaths;' . "\n" .
                       'use Beaver\\Sdk\\Theme\\ThemeManifest;' . "\n" .
                       'use Beaver\\Sdk\\Theme\\ThemeValidator;' . "\n\n" .
                       '// Paths a partir da config' . "\n" .
                       '$paths  = ThemePaths::fromConfig(config("themes"));' . "\n" .
                       '$themes = new ThemeManager($paths);' . "\n\n" .
                       '// Listar e procurar' . "\n" .
                       '$themes->all();                      // array<string, ThemeManifest>' . "\n" .
                       '$themes->exists("dark");             // bool' . "\n" .
                       '$manifest = $themes->find("dark");   // ?ThemeManifest' . "\n\n" .
                       '// Ativar / desativar' . "\n" .
                       '$themes->activate("dark");' . "\n" .
                       '$themes->active();                    // "dark"|null' . "\n" .
                       '$themes->deactivate();' . "\n\n" .
                       '// Paths do tema ativo' . "\n" .
                       '$themes->activeBase();                // /themes/dark' . "\n" .
                       '$themes->viewsBase();' . "\n" .
                       '$themes->assetsBase("css");' . "\n\n" .
                       '// Manifest do tema' . "\n" .
                       '$manifest->hasSupport("dark_mode");  // bool' . "\n" .
                       '$manifest->isChild();                // bool' . "\n" .
                       '$manifest->get("colors.primary");    // mixed' . "\n\n" .
                       '// Validação' . "\n" .
                       'ThemeValidator::validateOrFail($manifest->toArray());',
        'lang'      => 'php',
    ],

    'sdk_manifest' => [
        'titulo'    => 'SDK — Manifest',
        'categoria' => 'SDK',
        'descricao' => 'Carrega e valida o plugin.json de um plugin.',
        'tags'      => ['SDK', 'Manifest', 'Validação'],
        'snippet'   => 'use Beaver\\Sdk\\Manifest;' . "\n" .
                       'use Beaver\\Sdk\\ManifestValidator;' . "\n\n" .
                       '// Carregar do ficheiro' . "\n" .
                       '$data = json_decode(' . "\n" .
                       '    file_get_contents(__DIR__ . "/plugin.json"),' . "\n" .
                       '    true,' . "\n" .
                       ');' . "\n\n" .
                       '// Validar contra o schema' . "\n" .
                       '$errors = ManifestValidator::validate($data);' . "\n\n" .
                       'if ($errors === []) {' . "\n" .
                       '    $manifest = Manifest::fromArray($data);' . "\n" .
                       '    $manifest->className();      // "Beaver\\\\Plugins\\\\X\\\\XPlugin"' . "\n" .
                       '    $manifest->hasPermission("db.write");  // bool' . "\n" .
                       '}' . "\n\n" .
                       '// Permissões permitidas (catálogo)' . "\n" .
                       'ManifestValidator::allowedPermissions();' . "\n\n" .
                       '// CLI: php beaver plugin:validate <slug>',
        'lang'      => 'php',
    ],

