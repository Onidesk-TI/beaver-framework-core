    'sdk_context' => [
        'titulo'    => 'SDK — Permissões',
        'categoria' => 'SDK',
        'descricao' => 'Contexto e permissões declaradas no manifest do plugin.',
        'tags'      => ['SDK', 'Permissões', 'Segurança'],
        'snippet'   => 'use Beaver\\Sdk\\Context;' . "\n" .
                       'use Beaver\\Sdk\\PermissionDeniedException;' . "\n\n" .
                       '// O PluginManager injeta o Context no boot()' . "\n" .
                       '// Permissões em plugin.json: "permissions": ["db.write"]' . "\n\n" .
                       '$ctx = $this->context();' . "\n\n" .
                       '$ctx->has("db.write");              // bool (sem efeitos)' . "\n" .
                       '$ctx->check("db.write", "users");    // bool + audit' . "\n" .
                       '$ctx->granted();                     // ["db.read", ...]' . "\n" .
                       '$ctx->mode();                        // "off"|"audit"|"enforce"' . "\n\n" .
                       '// Em mode "enforce", check() lança exceção se negado:' . "\n" .
                       'try {' . "\n" .
                       '    $ctx->check("db.write", "users");' . "\n" .
                       '} catch (PermissionDeniedException $e) {' . "\n" .
                       '    // acesso bloqueado' . "\n" .
                       '}' . "\n\n" .
                       '// Atalho no PluginBase' . "\n" .
                       'if ($this->hasPermission("db.write")) { /* ... */ }',
        'lang'      => 'php',
    ],

