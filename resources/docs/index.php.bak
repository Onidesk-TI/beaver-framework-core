<?php

declare(strict_types=1);

/**
 * Documentação do beaver-installer
 * Chamada pela rota /docs do Beaver Framework
 */

$BASE      = dirname(__DIR__, 2) . '/scripts';
$README    = $BASE . '/README.md';
$INSTALLER = $BASE . '/beaver-installer.sh';
$BVPK      = $BASE . '/bvpk.sh';

// ─── Helpers ──────────────────────────────────────────────────

function h(string $s): string
{
    return htmlspecialchars($s, ENT_QUOTES | ENT_HTML5, 'UTF-8');
}

function lerArq(string $p): string
{
    return is_readable($p) ? (string) file_get_contents($p) : '';
}

function infoArq(string $p): array
{
    if (!is_readable($p)) {
        return ['existe' => false];
    }

    return [
        'existe'  => true,
        'tamanho' => (int) filesize($p),
        'linhas'  => count((array) file($p, FILE_IGNORE_NEW_LINES)),
        'mod'     => (int) filemtime($p),
    ];
}

function humanBytes(int $b): string
{
    $u = ['B', 'KB', 'MB', 'GB'];
    $i = 0;

    while ($b >= 1024 && $i < 3) {
        $b /= 1024;
        $i++;
    }

    return sprintf('%.2f %s', $b, $u[$i]);
}

/**
 * Converte Markdown simples em HTML.
 *
 * Suporta:
 *   - blocos ```lang ... ```
 *   - headings # até ######
 *   - `código inline`
 *   - **negrito**, *itálico*
 *   - [links](url)
 *   - listas com - ou *
 *   - --- como <hr>
 *   - parágrafos
 */
function markdown(string $src): string
{
    $src = str_replace(["\r\n", "\r"], "\n", $src);

    // ─── 1. Blocos de código (guardar antes de escapar) ──────
    $blocos = [];
    $src = (string) preg_replace_callback(
        '/```(\w*)\n(.*?)```/s',
        function (array $m) use (&$blocos): string {
            $lang  = $m[1] !== '' ? ' class="language-' . h($m[1]) . '"' : '';
            $idx   = count($blocos);
            $blocos[] = '<pre><code' . $lang . '>' . h($m[2]) . '</code></pre>';
            return "\x00B{$idx}\x00";
        },
        $src
    );

    // ─── 2. Escapar o resto ──────────────────────────────────
    $src = h($src);

    // ─── 3. Headings ─────────────────────────────────────────
    $src = (string) preg_replace('/^###### (.+)$/m', '<h6>$1</h6>', $src);
    $src = (string) preg_replace('/^##### (.+)$/m', '<h5>$1</h5>', $src);
    $src = (string) preg_replace('/^#### (.+)$/m', '<h4>$1</h4>', $src);
    $src = (string) preg_replace('/^### (.+)$/m', '<h3>$1</h3>', $src);
    $src = (string) preg_replace('/^## (.+)$/m', '<h2>$1</h2>', $src);
    $src = (string) preg_replace('/^# (.+)$/m', '<h1>$1</h1>', $src);

    // ─── 4. Inline ───────────────────────────────────────────
    $src = (string) preg_replace('/`([^`\n]+)`/', '<code>$1</code>', $src);
    $src = (string) preg_replace('/\*\*(.+?)\*\*/s', '<strong>$1</strong>', $src);
    $src = (string) preg_replace('/(?<!\*)\*(?!\s)(.+?)(?<!\s)\*(?!\*)/s', '<em>$1</em>', $src);
    $src = (string) preg_replace('/\[([^\]]+)\]\(([^)]+)\)/', '<a href="$2" target="_blank" rel="noopener">$1</a>', $src);

    // ─── 5. <hr> ─────────────────────────────────────────────
    $src = (string) preg_replace('/^-{3,}$/m', '<hr>', $src);

    // ─── 6. Listas ───────────────────────────────────────────
    $src = (string) preg_replace_callback(
        '/(?:^[ \t]*[-*] .+\n?)+/m',
        function (array $m): string {
            $items = preg_split('/\n/', trim($m[0])) ?: [];
            $html  = '<ul>';

            foreach ($items as $it) {
                $it = (string) preg_replace('/^[ \t]*[-*] /', '', $it);
                $html .= "<li>{$it}</li>";
            }

            return $html . '</ul>';
        },
        $src
    );

    // ─── 7. Parágrafos ───────────────────────────────────────
    // Só apanha linhas que não são tags HTML nem placeholders.
    $src = (string) preg_replace_callback(
        '/^(?![<])([^\n\x00]+(?:\n(?![<])(?!\n)[^\n\x00]+)*)/m',
        function (array $m): string {
            $t = trim($m[1]);

            if ($t === '') {
                return $m[0];
            }

            return "<p>{$t}</p>";
        },
        $src
    );

    // ─── 8. Restaurar blocos de código ───────────────────────
    foreach ($blocos as $i => $b) {
        $src = str_replace("\x00B{$i}\x00", $b, $src);
    }

    return $src;
}

/**
 * Extrai os comandos do beaver-installer.sh a partir do bloco
 * `case "$cmd" in ... esac`.
 *
 * Suporta dois formatos:
 *   criar) cmd_criar ;;
 *   criar)
 *       cmd_criar
 *       ;;
 */
function extrairComandos(string $script): array
{
    $out = [];

    if (!is_readable($script)) {
        return $out;
    }

    $src = (string) file_get_contents($script);

    if (!preg_match('/case "\$cmd" in(.*?)esac/s', $src, $m)) {
        return $out;
    }

    // Apanha "nome) cmd_funcao" com ou sem newline no meio
    preg_match_all(
        '/^\s*([a-z][a-z_|]*)\)\s*\n?\s*cmd_(\w+)/mi',
        $m[1],
        $ms,
        PREG_SET_ORDER
    );

    foreach ($ms as $mm) {
        $aliases = explode('|', $mm[1]);
        $out[] = [
            'nome'    => $aliases[0],
            'aliases' => array_slice($aliases, 1),
            'funcao'  => $mm[2],
        ];
    }

    return $out;
}

// ─── Recolha de dados ────────────────────────────────────────

$readme     = lerArq($README);
$readmeHtml = $readme !== ''
    ? markdown($readme)
    : '<p><em>README.md não encontrado.</em></p>';

$cmdList  = extrairComandos($INSTALLER);
$infoInst = infoArq($INSTALLER);
$infoBvpk = infoArq($BVPK);
$infoRead = infoArq($README);

$versao  = 'desconhecida';
$instSrc = lerArq($INSTALLER);

if ($instSrc !== '' && preg_match('/VERSAO_INSTALLER="([^"]+)"/', $instSrc, $m)) {
    $versao = $m[1];
}
?>
