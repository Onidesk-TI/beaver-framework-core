<?php

declare(strict_types=1);

namespace Beaver\Plugins\FrankeiTrial\Http;

use Beaver\Http\Request;
use Beaver\Http\Response;
use Beaver\Plugins\FrankeiTrial\Support\TrialLimits;

class TrialTestController
{
    public function list(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $root = $this->projectRoot();
        $all  = [];
        $porSuite = [];

        foreach (TrialLimits::allowedSuites() as $suite) {
            $dir = $root . '/tests/' . $suite;
            $files = is_dir($dir) ? (glob($dir . '/*Test.php') ?: []) : [];
            sort($files);
            $porSuite[$suite] = count($files);

            foreach ($files as $f) {
                $name = basename($f, '.php');
                $all[] = [
                    'name'  => $name,
                    'suite' => $suite,
                    'class' => 'Tests\\' . $suite . '\\' . $name,
                    'path'  => 'tests/' . $suite . '/' . basename($f),
                    'size'  => filesize($f) ?: 0,
                    'mtime' => date('c', filemtime($f) ?: time()),
                ];
            }
        }

        $total = count($all);
        $limit = TrialLimits::maxTests();
        $shown = ($limit === PHP_INT_MAX) ? $all : array_slice($all, 0, $limit);

        return Response::json([
            'ok'        => true,
            'plan'      => TrialLimits::plan(),
            'total'     => $total,
            'shown'     => count($shown),
            'limit'     => $limit === PHP_INT_MAX ? null : $limit,
            'truncated' => $total > $limit,
            'tests'     => $shown,
            'suites'    => TrialLimits::allowedSuites(),
            'por_suite' => $porSuite,
        ]);
    }

    public function run(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $body   = $req->body ?? [];
        $suite  = (string) ($body['suite']  ?? 'all');
        $engine = (string) ($body['engine'] ?? 'pest');

        if (!in_array($engine, ['pest', 'phpunit'], true)) {
            $engine = 'pest';
        }

        $cmd = 'beaver test --engine=' . $engine;
        if ($suite !== 'all' && in_array($suite, TrialLimits::allowedSuites(), true)) {
            $cmd .= ' --testsuite=' . $suite;
        }

        $result = $this->executar($cmd);
        if ($result === null) {
            return Response::json([
                'ok'    => false,
                'error' => 'Terminal indisponível.',
            ], 503);
        }

        $output    = (string) ($result['output'] ?? '');
        $allLines  = explode("\n", $output);
        $maxLines  = max(200, TrialLimits::maxFindings() * 8);
        $truncated = count($allLines) > $maxLines;
        $lines     = $truncated ? array_slice($allLines, 0, $maxLines) : $allLines;

        return Response::json([
            'ok'          => (bool) ($result['ok'] ?? false),
            'plan'        => TrialLimits::plan(),
            'suite'       => $suite,
            'engine'      => $engine,
            'command'     => $cmd,
            'elapsed_ms'  => (int) ($result['elapsed_ms'] ?? 0),
            'exit_code'   => (int) ($result['exit_code'] ?? -1),
            'lines'       => $lines,
            'truncated'   => $truncated,
            'total_lines' => count($allLines),
            'error'       => $result['error'] ?? null,
        ]);
    }


    /**
     * GET /api/frankei-trial/tests/classes?page=1&perPage=25
     * Lê o junit.xml e agrega por classe.
     */
    public function classes(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $userId = $this->userId();
        $root   = $this->projectRoot();
        $file   = $root . '/storage/frankei-reports/' . $userId . '/current/junit.xml';

        if (!is_file($file)) {
            return Response::json([
                'ok'      => true,
                'total'   => 0,
                'page'    => 1,
                'perPage' => 25,
                'pages'   => 0,
                'classes' => [],
                'message' => 'Sem resultados. Corre os testes primeiro.',
            ]);
        }

        $xml = @simplexml_load_file($file);
        if ($xml === false) {
            return Response::json(['ok' => false, 'error' => 'junit.xml inválido'], 500);
        }

        // Agregar por className
        $porClasse = [];

        // Percorrer recursivamente
        $walk = function ($suites, $suitePai) use (&$walk, &$porClasse) {
            foreach ($suites as $suite) {
                $name = (string) ($suite['name'] ?? '');
                $temFilhos = isset($suite->testsuite) && count($suite->testsuite) > 0;
                $temTests  = isset($suite->testcase)  && count($suite->testcase) > 0;

                if ($temFilhos) {
                    $walk($suite->testsuite, $name ?: $suitePai);
                    continue;
                }
                if (!$temTests) continue;

                // Esta é uma classe de teste
                $className = $name;
                if (!isset($porClasse[$className])) {
                    $porClasse[$className] = [
                        'classname'  => $className,
                        'shortname'  => self::calcShortName($className),
                        'suite'      => $suitePai ?: 'Unit',
                        'tests'      => 0,
                        'assertions' => 0,
                        'failures'   => 0,
                        'errors'     => 0,
                        'skipped'    => 0,
                        'time'       => 0.0,
                        'testcases'  => [],
                    ];
                }

                foreach ($suite->testcase as $tc) {
                    $tcName  = (string) ($tc['name'] ?? '');
                    $tcTime  = (float) ($tc['time'] ?? 0);
                    $tcAssrt = (int) ($tc['assertions'] ?? 0);
                    $isSkip  = isset($tc->skipped);
                    $isFail  = isset($tc->failure);
                    $isError = isset($tc->error);

                    $status = 'pass';
                    if ($isFail)       $status = 'fail';
                    elseif ($isError)  $status = 'error';
                    elseif ($isSkip)   $status = 'skip';

                    $porClasse[$className]['tests']++;
                    $porClasse[$className]['assertions'] += $tcAssrt;
                    $porClasse[$className]['time']       += $tcTime;
                    if ($isFail)  $porClasse[$className]['failures']++;
                    if ($isError) $porClasse[$className]['errors']++;
                    if ($isSkip)  $porClasse[$className]['skipped']++;

                    $porClasse[$className]['testcases'][] = [
                        'name'       => $tcName,
                        'status'     => $status,
                        'time'       => $tcTime,
                        'assertions' => $tcAssrt,
                        'file'       => (string) ($tc['file'] ?? ''),
                    ];
                }
            }
        };

        $walk($xml->testsuite, '');

        // Determinar status final
        foreach ($porClasse as &$c) {
            if ($c['failures'] > 0 || $c['errors'] > 0) $c['status'] = 'failed';
            elseif ($c['skipped'] === $c['tests'])       $c['status'] = 'skipped';
            elseif ($c['skipped'] > 0)                    $c['status'] = 'partial';
            else                                          $c['status'] = 'passed';
        }
        unset($c);

        // Ordenar por nome
        $classes = array_values($porClasse);
        usort($classes, function ($a, $b) {
            return strcmp($a['classname'], $b['classname']);
        });

        // Paginação
        $page    = max(1, (int) ($req->query['page']    ?? 1));
        $perPage = max(5, min(100, (int) ($req->query['perPage'] ?? 25)));
        $total   = count($classes);
        $pages   = $total > 0 ? (int) ceil($total / $perPage) : 0;
        $offset  = ($page - 1) * $perPage;
        $slice   = array_slice($classes, $offset, $perPage);

        return Response::json([
            'ok'      => true,
            'total'   => $total,
            'page'    => $page,
            'perPage' => $perPage,
            'pages'   => $pages,
            'classes' => $slice,
        ]);
    }


    /**
     * POST /api/frankei-trial/tests/run-class
     * Corre apenas uma classe específica (via --filter).
     */
    public function runClass(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $body   = $req->body ?? [];
        $class  = trim((string) ($body['class']  ?? ''));
        $engine = (string) ($body['engine'] ?? 'pest');

        if ($class === '') {
            return Response::json(['ok' => false, 'error' => 'class obrigatória'], 422);
        }

        // Sanitizar: só letras, números, \ e _
        if (!preg_match('/^[A-Za-z0-9_\\\\]+$/', $class)) {
            return Response::json(['ok' => false, 'error' => 'class inválida'], 422);
        }

        if (!in_array($engine, ['pest', 'phpunit'], true)) {
            $engine = 'pest';
        }

        $cmd = 'beaver test --engine=' . $engine . ' --filter=' . escapeshellarg($class);

        $result = $this->executar($cmd);
        if ($result === null) {
            return Response::json([
                'ok'    => false,
                'error' => 'Terminal indisponível.',
            ], 503);
        }

        $output    = (string) ($result['output'] ?? '');
        $allLines  = explode("\n", $output);
        $maxLines  = max(200, TrialLimits::maxFindings() * 8);
        $truncated = count($allLines) > $maxLines;
        $lines     = $truncated ? array_slice($allLines, 0, $maxLines) : $allLines;

        return Response::json([
            'ok'          => (bool) ($result['ok'] ?? false),
            'class'       => $class,
            'engine'      => $engine,
            'command'     => $cmd,
            'elapsed_ms'  => (int) ($result['elapsed_ms'] ?? 0),
            'exit_code'   => (int) ($result['exit_code'] ?? -1),
            'lines'       => $lines,
            'truncated'   => $truncated,
            'total_lines' => count($allLines),
            'error'       => $result['error'] ?? null,
        ]);
    }

    private static function calcShortName(string $fqcn): string
    {
        // FQCN completo: "Tests\\Unit\\ForumControllerTest"
        // Precisa de calcular o último segmento após o backslash
        $ns = strrpos($fqcn, '\\');
        if ($ns === false) {
            return $fqcn;  // sem namespace
        }
        return substr($fqcn, $ns + 1);
    }


    /**
     * POST /api/frankei-trial/tests/convert
     * Converte um teste Pest <-> PHPUnit.
     * Devolve o código convertido SEM gravar (o user revê no editor).
     */
    public function convert(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $body    = $req->body ?? [];
        $class   = trim((string) ($body['class']  ?? ''));
        $toEngine = (string) ($body['engine'] ?? 'phpunit');

        if ($class === '') {
            return Response::json(['ok' => false, 'error' => 'class obrigatória'], 422);
        }
        if (!in_array($toEngine, ['pest', 'phpunit'], true)) {
            return Response::json(['ok' => false, 'error' => 'engine inválido'], 422);
        }

        // 1. Encontrar ficheiro
        $file = $this->findTestFile($class);
        if (!$file) {
            return Response::json(['ok' => false, 'error' => 'Ficheiro do teste não encontrado'], 404);
        }

        $code = (string) file_get_contents($file);
        if ($code === '') {
            return Response::json(['ok' => false, 'error' => 'Ficheiro vazio'], 422);
        }

        // 2. Detectar engine de origem
        $fromEngine = $this->detectEngine($code);
        if ($fromEngine === null) {
            return Response::json([
                'ok'     => false,
                'error'  => 'Não consegui detectar o motor do teste actual',
            ], 422);
        }

        if ($fromEngine === $toEngine) {
            return Response::json([
                'ok'      => true,
                'code'    => $code,
                'from'    => $fromEngine,
                'to'      => $toEngine,
                'warnings' => ['O teste já está em ' . strtoupper($toEngine) . '. Nada a converter.'],
            ]);
        }

        // 3. Converter
        if ($fromEngine === 'pest' && $toEngine === 'phpunit') {
            $result = $this->convertPestToPhpunit($code, $class);
        } else {
            $result = $this->convertPhpunitToPest($code);
        }

        return Response::json([
            'ok'       => true,
            'code'     => $result['code'],
            'from'     => $fromEngine,
            'to'       => $toEngine,
            'warnings' => $result['warnings'],
            'class'    => $class,
        ]);
    }

    /* ────────────────────────────────────────────────────────────
     HELPERS DE CONVERSÃO
     ──────────────────────────────────────────────────────────── */

    private function findTestFile(string $classname): ?string
    {
        $root = $this->projectRoot();

        // Tentar caminho directo: tests/Unit/{Classe}.php
        $short = substr($classname, strrpos($classname, '\\') !== false
            ? strrpos($classname, '\\') + 1
            : 0);

        $candidatos = [
            $root . '/tests/Unit/' . $short . '.php',
            $root . '/tests/Feature/' . $short . '.php',
            $root . '/tests/' . $short . '.php',
        ];

        foreach ($candidatos as $c) {
            if (is_file($c)) return $c;
        }

        // Busca recursiva
        try {
            $it = new \RecursiveIteratorIterator(
                new \RecursiveDirectoryIterator($root . '/tests', \FilesystemIterator::SKIP_DOTS)
            );
            foreach ($it as $f) {
                if ($f->getExtension() !== 'php') continue;
                if ($f->getBasename('.php') === $short) return $f->getPathname();
            }
        } catch (\Throwable $e) {}

        return null;
    }

    private function detectEngine(string $code): ?string
    {
        if (preg_match('/use\s+function\s+Pest/i', $code) ||
            preg_match('/^\s*it\s*\(/m', $code) ||
            preg_match('/^\s*test\s*\(/m', $code) ||
            preg_match('/\bexpect\s*\(/', $code)) {
            return 'pest';
        }
        if (preg_match('/extends\s+[\w\\\\]*TestCase\b/i', $code) ||
            preg_match('/public\s+function\s+test[A-Z_]/i', $code) ||
            preg_match('/\$this->assert[A-Z]/', $code)) {
            return 'phpunit';
        }
        return null;
    }

    /**
     * Extrai o bloco { ... } a partir da posição de uma chaveta de abertura.
     * Devolve [conteudo, posicao_final_da_chaveta_de_fecho] ou [null, -1].
     */
    private function extractBlock(string $code, int $start): array
    {
        if ($start < 0 || $start >= strlen($code) || $code[$start] !== '{') {
            return [null, -1];
        }
        $depth = 0;
        $i = $start;
        $len = strlen($code);
        $inString = false;
        $stringChar = '';
        while ($i < $len) {
            $ch = $code[$i];
            // Ignorar strings (simplificado)
            if (!$inString && ($ch === "'" || $ch === '"')) {
                $inString = true;
                $stringChar = $ch;
            } elseif ($inString && $ch === $stringChar && $code[$i-1] !== '\\') {
                $inString = false;
            }
            if (!$inString) {
                if ($ch === '{') $depth++;
                elseif ($ch === '}') {
                    $depth--;
                    if ($depth === 0) {
                        return [substr($code, $start + 1, $i - $start - 1), $i];
                    }
                }
            }
            $i++;
        }
        return [null, -1];
    }

    /** Extrai as asserções Pest → PHPUnit dentro de um bloco de código */
    private function convertAssertionsPestToPhpunit(string $body, array &$warnings): string
    {
        $map = [
            '/expect\(\s*([^;]+?)\s*\)->toBeTrue\(\)/'      => '$this->assertTrue($1)',
            '/expect\(\s*([^;]+?)\s*\)->toBeFalse\(\)/'     => '$this->assertFalse($1)',
            '/expect\(\s*([^;]+?)\s*\)->toBeNull\(\)/'      => '$this->assertNull($1)',
            '/expect\(\s*([^;]+?)\s*\)->not->toBeNull\(\)/' => '$this->assertNotNull($1)',
            '/expect\(\s*([^;]+?)\s*\)->toBeEmpty\(\)/'     => '$this->assertEmpty($1)',
            '/expect\(\s*([^;]+?)\s*\)->not->toBeEmpty\(\)/' => '$this->assertNotEmpty($1)',
            '/expect\(\s*([^;]+?)\s*\)->toBe\(([^;]+?)\)/'  => '$this->assertSame($2, $1)',
            '/expect\(\s*([^;]+?)\s*\)->toEqual\(([^;]+?)\)/' => '$this->assertEquals($2, $1)',
            '/expect\(\s*([^;]+?)\s*\)->toHaveCount\(([^;]+?)\)/' => '$this->assertCount($2, $1)',
            '/expect\(\s*([^;]+?)\s*\)->toBeInstanceOf\(([^;]+?)\)/' => '$this->assertInstanceOf($2, $1)',
            '/expect\(\s*([^;]+?)\s*\)->toBeGreaterThan\(([^;]+?)\)/' => '$this->assertGreaterThan($2, $1)',
            '/expect\(\s*([^;]+?)\s*\)->toBeLessThan\(([^;]+?)\)/' => '$this->assertLessThan($2, $1)',
            '/expect\(\s*([^;]+?)\s*\)->toContain\(([^;]+?)\)/' => '$this->assertContains($2, $1)',
            '/expect\(\s*([^;]+?)\s*\)->toHaveKey\(([^;]+?)\)/' => '$this->assertArrayHasKey($2, $1)',
        ];

        $resultado = $body;
        $convertidas = 0;
        foreach ($map as $pat => $rep) {
            $count = 0;
            $resultado = preg_replace($pat, $rep, $resultado, -1, $count);
            $convertidas += $count;
        }

        // Contar quantas expect() sobraram
        $sobraram = preg_match_all('/\bexpect\s*\(/', $resultado);
        if ($sobraram > 0) {
            $warnings[] = $sobraram . ' chamada(s) expect() não convertida(s) (padrão complexo)';
        }

        return $resultado;
    }

    /** Pest → PHPUnit */
    private function convertPestToPhpunit(string $code, string $classname): array
    {
        $warnings = [];
        $tests = [];

        // Encontrar it()/test() { ... }
        $offset = 0;
        while (preg_match(
            '/\b(it|test)\s*\(\s*([\'"])(.*?)\2\s*,\s*function\s*\([^)]*\)\s*(?:use\s*\([^)]*\)\s*)?\{/s',
            $code,
            $m,
            PREG_OFFSET_CAPTURE,
            $offset
        )) {
            $matchStr = $m[0][0];
            $matchPos = $m[0][1];
            $testName = $m[3][0];

            // Posição da chaveta de abertura no código original
            $bracePos = $matchPos + strlen($matchStr) - 1;

            [$body, $endBracePos] = $this->extractBlock($code, $bracePos);
            if ($body === null) {
                $warnings[] = 'Bloco de "' . $testName . '" não fechou correctamente';
                $offset = $bracePos + 1;
                continue;
            }

            // Normalizar + converter asserções
            $body = $this->normalizeBody($body);
            $bodyConv = $this->convertAssertionsPestToPhpunit($body, $warnings);

            // Nome do método
            $metodo = 'test_' . preg_replace('/[^a-z0-9]+/i', '_', $testName);
            $metodo = strtolower(trim($metodo, '_'));

            $tests[] = "    public function {$metodo}(): void\n    {\n" . $this->indent($bodyConv, 8) . "\n    }";

            $offset = $endBracePos + 1;
        }

        if (empty($tests)) {
            $warnings[] = 'Nenhum teste it()/test() encontrado';
            return ['code' => $code, 'warnings' => $warnings];
        }

        // Nome da classe final
        $shortClass = substr($classname, strrpos($classname, '\\') !== false
            ? strrpos($classname, '\\') + 1
            : 0);
        if ($shortClass === '') $shortClass = 'ConvertedTest';

        $bodyClasses = implode("\n\n", $tests);

        $out = "<?php\n\ndeclare(strict_types=1);\n\n";
        $out .= "namespace Tests\\Unit;\n\n";
        $out .= "use Tests\\TestCase;\n\n";
        $out .= "class {$shortClass} extends TestCase\n{\n";
        $out .= $bodyClasses . "\n";
        $out .= "}\n";

        // Injetar avisos como comentário no topo
        $out = $this->injectWarnings($out, $warnings);

        return ['code' => $out, 'warnings' => $warnings];
    }

    /** PHPUnit → Pest */
    private function convertPhpunitToPest(string $code): array
    {
        $warnings = [];
        $tests = [];

        // FK_USE_PRESERVE — extrair use statements do original
        $useStatements = [];
        $topLevel = $code;
        if (preg_match('/^(.*?)^class\s+\w+/ms', $code, $mTop)) {
            $topLevel = $mTop[1];
        }
        if (preg_match_all('/^use\s+[^;]+;/m', $topLevel, $mUse)) {
            foreach ($mUse[0] as $u) {
                $uTrim = trim($u);
                // Ignorar TestCase (redundante em Pest)
                if (stripos($uTrim, 'TestCase') !== false) continue;
                $useStatements[] = $uTrim;
            }
        }

        // Encontrar public function test_xxx(): void { ... }
        $offset = 0;
        while (preg_match(
            '/public\s+function\s+(test[A-Z_]\w*)\s*\([^)]*\)\s*(?::\s*[^{]+)?\{/s',
            $code,
            $m,
            PREG_OFFSET_CAPTURE,
            $offset
        )) {
            $matchStr = $m[0][0];
            $matchPos = $m[0][1];
            $methodName = $m[1][0];

            $bracePos = $matchPos + strlen($matchStr) - 1;
            [$body, $endBracePos] = $this->extractBlock($code, $bracePos);
            if ($body === null) {
                $warnings[] = 'Método ' . $methodName . ' não fechou correctamente';
                $offset = $bracePos + 1;
                continue;
            }

            $body = $this->normalizeBody($body);
            $bodyConv = $this->convertAssertionsPhpunitToPest($body, $warnings);

            // test_soma_corretamente → "soma corretamente"
            $humanName = preg_replace('/^test_?/', '', $methodName);
            $humanName = str_replace('_', ' ', $humanName);

            $tests[] = "it('" . addslashes($humanName) . "', function () {\n" . $this->indent($bodyConv, 4) . "\n});";

            $offset = $endBracePos + 1;
        }

        if (empty($tests)) {
            $warnings[] = 'Nenhum método test*() encontrado';
            return ['code' => $code, 'warnings' => $warnings];
        }

        $out = "<?php\n\n";

        // FK_USE_PRESERVE — prepend use statements preservados
        if (!empty($useStatements)) {
            $out .= "// ── use preservados do original ──\n";
            $out .= implode("\n", $useStatements) . "\n\n";
            $warnings[] = count($useStatements) . ' use statement(s) preservado(s) do original — confirma antes de gravar';
        }

        $out .= implode("\n\n", $tests) . "\n";

        // Injetar avisos como comentário no topo
        $out = $this->injectWarnings($out, $warnings);

        return ['code' => $out, 'warnings' => $warnings];
    }

    /** Converte asserções PHPUnit → Pest */
    private function convertAssertionsPhpunitToPest(string $body, array &$warnings): string
    {
        $map = [
            '/\$this->assertTrue\(\s*([^;]+?)\s*\)/'      => 'expect($1)->toBeTrue()',
            '/\$this->assertFalse\(\s*([^;]+?)\s*\)/'     => 'expect($1)->toBeFalse()',
            '/\$this->assertNull\(\s*([^;]+?)\s*\)/'      => 'expect($1)->toBeNull()',
            '/\$this->assertNotNull\(\s*([^;]+?)\s*\)/'   => 'expect($1)->not->toBeNull()',
            '/\$this->assertEmpty\(\s*([^;]+?)\s*\)/'     => 'expect($1)->toBeEmpty()',
            '/\$this->assertNotEmpty\(\s*([^;]+?)\s*\)/'  => 'expect($1)->not->toBeEmpty()',
            '/\$this->assertSame\(\s*([^,]+?)\s*,\s*([^)]+?)\s*\)/' => 'expect($2)->toBe($1)',
            '/\$this->assertEquals\(\s*([^,]+?)\s*,\s*([^)]+?)\s*\)/' => 'expect($2)->toEqual($1)',
            '/\$this->assertCount\(\s*([^,]+?)\s*,\s*([^)]+?)\s*\)/' => 'expect($2)->toHaveCount($1)',
            '/\$this->assertInstanceOf\(\s*([^,]+?)\s*,\s*([^)]+?)\s*\)/' => 'expect($2)->toBeInstanceOf($1)',
        ];

        $resultado = $body;
        foreach ($map as $pat => $rep) {
            $resultado = preg_replace($pat, $rep, $resultado);
        }

        $sobraram = preg_match_all('/\$this->assert[A-Z]/', $resultado);
        if ($sobraram > 0) {
            $warnings[] = $sobraram . ' assertion(s) não convertida(s)';
        }

        return $resultado;
    }

    /**
     * Normaliza um corpo extraído (entre { e }):
     *  - remove linhas em branco à esquerda e à direita
     *  - faz rtrim de cada linha
     *  - remove a indentação comum (min indent das linhas não vazias)
     * Devolve o corpo pronto a ser indentado para o destino.
     */
    private function normalizeBody(string $body): string
    {
        $linhas = explode("\n", $body);

        // rtrim + tirar \r
        $linhas = array_map(function ($l) {
            return rtrim(str_replace("\r", '', $l));
        }, $linhas);

        // Remover linhas em branco à esquerda
        while (!empty($linhas) && trim($linhas[0]) === '') {
            array_shift($linhas);
        }
        // Remover linhas em branco à direita
        while (!empty($linhas) && trim(end($linhas)) === '') {
            array_pop($linhas);
        }

        if (empty($linhas)) return '';

        // Indentação mínima das linhas não vazias
        $min = PHP_INT_MAX;
        foreach ($linhas as $l) {
            if (trim($l) === '') continue;
            preg_match('/^([ \t]*)/', $l, $m);
            $n = strlen($m[1]);
            if ($n < $min) $min = $n;
        }
        if ($min === PHP_INT_MAX) $min = 0;

        // Dedent comum
        if ($min > 0) {
            foreach ($linhas as &$l) {
                if (trim($l) === '') { $l = ''; continue; }
                $l = substr($l, $min);
            }
            unset($l);
        }

        return implode("\n", $linhas);
    }

    private function indent(string $text, int $spaces): string
    {
        $pad = str_repeat(' ', $spaces);
        $linhas = explode("\n", $text);
        return implode("\n", array_map(function ($l) use ($pad) {
            // Linhas vazias ou só com espaços → ''
            if (trim($l) === '') return '';
            return $pad . $l;
        }, $linhas));
    }

    /**
     * POST /api/frankei-trial/tests/save
     * Guarda o teste no sítio certo, com backup identificável.
     * Body: { class, content, from_engine, to_engine }
     */
    /**
     * Gera o nome do ficheiro "irmão" para o engine destino.
     *   target=ForumController, to=pest    → ForumControllerPestTest
     *   target=ForumController, to=phpunit → ForumControllerTest
     */
    /**
     * Injeta um bloco de comentário com os avisos no topo do código PHP.
     * Mantém a linha `<?php` e insere o aviso logo a seguir.
     */
    private function injectWarnings(string $code, array $warnings): string
    {
        if (empty($warnings)) {
            return $code;
        }

        $linhas = ["/*", " * ⚠️  CONVERSÃO COM AVISOS (" . count($warnings) . ")", " * ─────────────────────────────"];
        foreach ($warnings as $i => $w) {
            $linhas[] = " * " . ($i + 1) . ". " . str_replace("\n", " ", $w);
        }
        $linhas[] = " *";
        $linhas[] = " * Revê o código abaixo antes de gravar.";
        $linhas[] = " */";
        $banner = implode("\n", $linhas) . "\n";

        // Inserir depois de `<?php` (primeira linha)
        if (preg_match('/^<\?php\s*\n/', $code, $m)) {
            return substr($code, 0, strlen($m[0])) . "\n" . $banner . substr($code, strlen($m[0]));
        }
        // Fallback: prepend
        return "<?php\n\n" . $banner . "\n" . $code;
    }

    private function siblingName(string $target, string $toEngine): string
    {
        $sufixo = $toEngine === 'pest' ? 'PestTest' : 'Test';
        return $target . $sufixo;
    }

    /**
     * GET /api/frankei-trial/tests/engines
     * Devolve {classname_curto: 'pest'|'phpunit'} para todos os testes.
     */
    public function engines(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $root     = $this->projectRoot();
        $testsDir = $root . '/tests';
        $map      = [];

        if (is_dir($testsDir)) {
            try {
                $it = new \RecursiveIteratorIterator(
                    new \RecursiveDirectoryIterator($testsDir, \FilesystemIterator::SKIP_DOTS)
                );
                foreach ($it as $f) {
                    if (!$f->isFile()) continue;
                    if ($f->getExtension() !== 'php') continue;
                    $stem    = $f->getBasename('.php');
                    $content = (string) @file_get_contents($f->getPathname());
                    $eng     = $this->detectEngine($content);
                    if ($eng) {
                        $map[$stem] = $eng;
                    }
                }
            } catch (\Throwable $e) {}
        }

        return Response::json(['ok' => true, 'engines' => $map, 'total' => count($map)]);
    }

    public function save(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $body       = $req->body ?? [];
        $class      = trim((string) ($body['class']  ?? ''));
        $content    = (string) ($body['content'] ?? '');
        $fromEngine = (string) ($body['from_engine'] ?? '');
        $toEngine   = (string) ($body['to_engine']   ?? '');

        if ($class === '') {
            return Response::json(['ok' => false, 'error' => 'class obrigatória'], 422);
        }
        if (trim($content) === '') {
            return Response::json(['ok' => false, 'error' => 'conteúdo vazio'], 422);
        }
        if (strpos(ltrim($content), '<?php') !== 0) {
            return Response::json(['ok' => false, 'error' => 'ficheiro tem de começar por <?php'], 422);
        }

        // ─── Encontrar ficheiro ───
        $file = $this->findTestFile($class);
        if (!$file) {
            return Response::json(['ok' => false, 'error' => 'Ficheiro não encontrado: ' . $class], 404);
        }

        $real = realpath($file);
        $root = $this->projectRoot();
        if ($real === false || strpos($real, $root . '/tests/') !== 0) {
            return Response::json(['ok' => false, 'error' => 'Path inválido'], 403);
        }

        // ─── CONVERSÃO: criar sibling, preservar original ───
        if ($fromEngine !== '' && $toEngine !== '' && $fromEngine !== $toEngine) {
            $target  = $this->targetName($class);
            $sibNome = $this->siblingName($target, $toEngine);
            $sibPath = dirname($real) . '/' . $sibNome . '.php';

            // Bloquear se for criar novo e target no limite
            if (!file_exists($sibPath)) {
                $detalhes = $this->detalhesTarget($target);
                if (count($detalhes) >= $this->maxTestFilesPerTarget()) {
                    return $this->blockedResponse($target, $detalhes);
                }
            }

            // Lint
            $tmp = tempnam(sys_get_temp_dir(), 'fk-conv-');
            file_put_contents($tmp, $content);
            $out = []; $code = 0;
            @exec('php -l ' . escapeshellarg($tmp) . ' 2>&1', $out, $code);
            @unlink($tmp);
            if ($code !== 0) {
                return Response::json([
                    'ok'    => false,
                    'error' => 'Erro de sintaxe — NÃO gravado',
                    'lint'  => trim(implode("\n", $out)),
                ], 422);
            }

            $jaExistia = file_exists($sibPath);
            if ($jaExistia) {
                @copy($sibPath, $sibPath . '.bak.' . date('Ymd-His') . '.php');
            }

            $bytes = @file_put_contents($sibPath, $content);
            if ($bytes === false) {
                return Response::json(['ok' => false, 'error' => 'Falha ao gravar sibling'], 500);
            }
            @chmod($sibPath, 0664);

            $warnings = [];
            $detalhesDepois = $this->detalhesTarget($target);
            if (count($detalhesDepois) >= $this->maxTestFilesPerTarget()) {
                $warnings[] = 'Limite de ' . $this->maxTestFilesPerTarget() . ' atingido — ' . count($detalhesDepois) . " ficheiros para '{$target}'";
            }

            return Response::json([
                'ok'              => true,
                'file'            => ltrim(str_replace($root, '', $sibPath), '/'),
                'original'        => ltrim(str_replace($root, '', $real), '/'),
                'created_sibling' => !$jaExistia,
                'overwrote'       => $jaExistia,
                'bytes'           => $bytes,
                'from_engine'     => $fromEngine,
                'to_engine'       => $toEngine,
                'warnings'        => $warnings,
                'mtime'           => date('c'),
            ]);
        }

        // ─── Bloquear se for novo ficheiro e target já no limite ───
        if (!file_exists($real)) {
            $target   = $this->targetName($class);
            $detalhes = $this->detalhesTarget($target);
            if (count($detalhes) >= $this->maxTestFilesPerTarget()) {
                return $this->blockedResponse($target, $detalhes);
            }
        }

        // ─── Backup identificável ───
        $sufixo = '';
        if ($fromEngine && $toEngine && $fromEngine !== $toEngine) {
            $sufixo = '.bak.' . $fromEngine . '-para-' . $toEngine;
        } else {
            $sufixo = '.bak';
        }
        $bak = $real . $sufixo . '.' . date('Ymd-His') . '.php';

        // ─── Lint ANTES de gravar ───
        $tmp = tempnam(sys_get_temp_dir(), 'fk-save-');
        if ($tmp === false || file_put_contents($tmp, $content) === false) {
            return Response::json(['ok' => false, 'error' => 'Falha ao preparar validação'], 500);
        }
        $lintOut = [];
        $lintCode = 0;
        @exec('php -l ' . escapeshellarg($tmp) . ' 2>&1', $lintOut, $lintCode);
        @unlink($tmp);

        if ($lintCode !== 0) {
            return Response::json([
                'ok'    => false,
                'error' => 'Erro de sintaxe — NÃO gravado',
                'lint'  => trim(implode("\n", $lintOut)),
            ], 422);
        }

        // ─── Backup ───
        if (!@copy($real, $bak)) {
            return Response::json(['ok' => false, 'error' => 'Falha ao criar backup'], 500);
        }

        // ─── Gravar ───
        $bytes = @file_put_contents($real, $content);
        if ($bytes === false) {
            // Restaurar backup
            @copy($bak, $real);
            return Response::json(['ok' => false, 'error' => 'Falha ao gravar — backup restaurado'], 500);
        }

        return Response::json([
            'ok'           => true,
            'file'         => ltrim(substr($real, strlen($root)), '/'),
            'backup'       => basename($bak),
            'bytes'        => $bytes,
            'mtime'        => date('c'),
            'from_engine'  => $fromEngine,
            'to_engine'    => $toEngine,
        ]);
    }

    /**
     * POST /api/frankei-trial/tests/undo-conversion
     * Devolve o conteúdo do backup mais recente do tipo .bak.<from>-para-<to>.*.php
     * Body: { class, prefer_engine }
     */
    public function undoConversion(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $body         = $req->body ?? [];
        $class        = trim((string) ($body['class'] ?? ''));
        $preferEngine = (string) ($body['prefer_engine'] ?? '');

        if ($class === '') {
            return Response::json(['ok' => false, 'error' => 'class obrigatória'], 422);
        }

        $file = $this->findTestFile($class);
        if (!$file) {
            return Response::json(['ok' => false, 'error' => 'Ficheiro não encontrado'], 404);
        }

        $real = realpath($file);
        $root = $this->projectRoot();
        if ($real === false || strpos($real, $root . '/tests/') !== 0) {
            return Response::json(['ok' => false, 'error' => 'Path inválido'], 403);
        }

        // ─── Procurar backups .bak.*-para-*.php ───
        $dir  = dirname($real);
        $base = basename($real, '.php');

        $pattern = $dir . '/' . $base . '.bak.*-para-*.php';
        $baks = glob($pattern);
        if (empty($baks)) {
            // fallback: qualquer .bak.*.php
            $baks = glob($dir . '/' . $base . '.bak.*.php');
        }

        if (empty($baks)) {
            return Response::json([
                'ok'    => false,
                'error' => 'Sem backups disponíveis para ' . $base,
            ], 404);
        }

        // Ordenar por mtime (mais recente primeiro)
        usort($baks, function ($a, $b) {
            return filemtime($b) <=> filemtime($a);
        });

        // Se prefer_engine foi dado, tentar encontrar o backup cujo nome indica esse engine
        $escolhido = null;
        if ($preferEngine !== '') {
            foreach ($baks as $b) {
                if (preg_match('/\.bak\.([a-z]+)-para-([a-z]+)\./i', $b, $m)) {
                    // m[1] = from_engine (o que o backup ERA)
                    if (strtolower($m[1]) === strtolower($preferEngine)) {
                        $escolhido = $b;
                        break;
                    }
                }
            }
        }
        if ($escolhido === null) {
            $escolhido = $baks[0];  // mais recente
        }

        $content = (string) @file_get_contents($escolhido);
        if ($content === '') {
            return Response::json(['ok' => false, 'error' => 'Backup vazio'], 422);
        }

        // Detectar engine do conteúdo restaurado
        $engine = $this->detectEngine($content);

        return Response::json([
            'ok'         => true,
            'code'       => $content,
            'engine'     => $engine,
            'backup'     => basename($escolhido),
            'backup_at'  => date('c', filemtime($escolhido)),
        ]);
    }

    /**
     * POST /api/frankei-trial/tests/create
     * Cria um ficheiro de teste novo a partir de um template.
     * Body: { class, engine, content }
     */
    public function create(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $body    = $req->body ?? [];
        $class   = trim((string) ($body['class']  ?? ''));
        $engine  = (string) ($body['engine'] ?? 'pest');
        $content = (string) ($body['content'] ?? '');

        if ($class === '') {
            return Response::json(['ok' => false, 'error' => 'class obrigatória'], 422);
        }
        if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/', $class)) {
            return Response::json(['ok' => false, 'error' => 'Nome de classe inválido (usa só letras/números/underscore)'], 422);
        }
        if (!in_array($engine, ['pest', 'phpunit'], true)) {
            return Response::json(['ok' => false, 'error' => 'engine inválido'], 422);
        }
        if (trim($content) === '' || strpos(ltrim($content), '<?php') !== 0) {
            return Response::json(['ok' => false, 'error' => 'conteúdo tem de começar por <?php'], 422);
        }

        $root = $this->projectRoot();

        // ─── Verificar limite de ficheiros por target ───
        $limit   = $this->maxTestFilesPerTarget();
        $target  = $this->targetName($class);
        $existe  = $this->findTestFilesForTarget($target);

        if (count($existe) >= $limit) {
            return Response::json([
                'ok'      => false,
                'error'   => "Limite de {$limit} ficheiro(s) de teste para '{$target}' atingido (existem " . count($existe) . "). Ajusta FK_TRIAL_MAX_TEST_FILES_PER_TARGET no .env ou apaga um dos existentes.",
                'limit'   => $limit,
                'current' => count($existe),
                'target'  => $target,
                'files'   => array_map(function ($p) use ($root) {
                    return ltrim(str_replace($root, '', $p), '/');
                }, $existe),
            ], 409);
        }

        $dir  = $root . '/tests/Unit';
        if (!is_dir($dir)) {
            @mkdir($dir, 0775, true);
        }

        $file = $dir . '/' . $class . '.php';
        $avisos = $avisos ?? [];
        if (file_exists($file)) {
            $bak = $file . '.bak.' . date('Ymd-His') . '.php';
            @copy($file, $bak);
            $avisos[] = 'Ficheiro já existia — backup: ' . basename($bak);
        }

        // Lint antes de gravar
        $tmp = tempnam(sys_get_temp_dir(), 'fk-create-');
        file_put_contents($tmp, $content);
        $out = []; $code = 0;
        @exec('php -l ' . escapeshellarg($tmp) . ' 2>&1', $out, $code);
        @unlink($tmp);
        if ($code !== 0) {
            return Response::json([
                'ok'    => false,
                'error' => 'Erro de sintaxe — NÃO criado',
                'lint'  => trim(implode("\n", $out)),
            ], 422);
        }

        $bytes = @file_put_contents($file, $content);
        if ($bytes === false) {
            return Response::json(['ok' => false, 'error' => 'Falha ao criar ficheiro'], 500);
        }
        @chmod($file, 0664);

        return Response::json([
            'ok'      => true,
            'file'    => 'tests/Unit/' . $class . '.php',
            'bytes'   => $bytes,
            'engine'  => $engine,
            'created' => true,
            'mtime'   => date('c'),
        ]);
    }

    /* ────────────────────────────────────────────────────────────
     LIMITE DE FICHEIROS DE TESTE POR TARGET (configurável via .env)
     ──────────────────────────────────────────────────────────── */

    /** Lê uma variável de ambiente (via $_ENV, getenv, ou parse do .env). */
    private function envInt(string $key, int $default): int
    {
        $v = $_ENV[$key] ?? $_SERVER[$key] ?? getenv($key);
        if ($v !== false && $v !== null && $v !== '') {
            return (int) $v;
        }

        $envFile = $this->projectRoot() . '/.env';
        if (is_file($envFile)) {
            foreach (file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
                $line = trim($line);
                if ($line === '' || $line[0] === '#') continue;
                if (strpos($line, '=') === false) continue;
                [$k, $val] = explode('=', $line, 2);
                if (trim($k) === $key) {
                    $val = trim($val, " \t\"'");
                    if ($val !== '') return (int) $val;
                }
            }
        }
        return $default;
    }

    /** Normaliza o nome de uma classe de teste → nome do objecto testado.
     *  ForumControllerTest      → ForumController
     *  ForumControllerPestTest  → ForumController
     *  ForumControllerPhpUnitTest → ForumController
     *  Tests\Unit\FooTest       → Foo
     */
    private function targetName(string $testClass): string
    {
        $short = substr($testClass, strrpos($testClass, '\\') !== false
            ? strrpos($testClass, '\\') + 1
            : 0);
        if ($short === '') $short = $testClass;

        $base = $short;
        $changed = true;
        while ($changed) {
            $changed = false;
            foreach (['Tests', 'Test', 'Pest', 'PhpUnit', 'PHPUnit', 'Spec'] as $suf) {
                $len = strlen($suf);
                if ($len > 0 && substr($base, -$len) === $suf && strlen($base) > $len) {
                    $base = substr($base, 0, -$len);
                    $changed = true;
                }
            }
        }
        return $base !== '' ? $base : $short;
    }

    /** Devolve a lista de ficheiros de teste existentes que apontam para o mesmo target. */
    private function findTestFilesForTarget(string $target): array
    {
        $root = $this->projectRoot();
        $testsDir = $root . '/tests';
        if (!is_dir($testsDir)) return [];

        $found = [];
        try {
            $it = new \RecursiveIteratorIterator(
                new \RecursiveDirectoryIterator($testsDir, \FilesystemIterator::SKIP_DOTS)
            );
            foreach ($it as $f) {
                if (!$f->isFile()) continue;
                if ($f->getExtension() !== 'php') continue;
                $stem = $f->getBasename('.php');
                if (substr($stem, -4) !== 'Test') continue;
                if ($this->targetName($stem) === $target) {
                    $found[] = $f->getPathname();
                }
            }
        } catch (\Throwable $e) {}
        return $found;
    }

    /** Devolve o limite configurado (default 2). */
    private function maxTestFilesPerTarget(): int
    {
        $v = $this->envInt('FK_TRIAL_MAX_TEST_FILES_PER_TARGET', 2);
        return $v > 0 ? $v : 2;
    }

