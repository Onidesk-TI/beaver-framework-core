    /**
     * Devolve detalhes dos ficheiros de teste existentes para um target.
     * [{file, engine}, ...]
     */
    private function detalhesTarget(string $target): array
    {
        $root  = $this->projectRoot();
        $files = $this->findTestFilesForTarget($target);
        $out   = [];
        foreach ($files as $path) {
            $content = (string) @file_get_contents($path);
            $eng     = $this->detectEngine($content);
            $out[] = [
                'file'   => ltrim(str_replace($root, '', $path), '/'),
                'engine' => $eng ?: 'unknown',
            ];
        }
        return $out;
    }

    /** Resumo "2 pest + 1 phpunit" */
    private function resumoEngines(array $detalhes): string
    {
        $cont = [];
        foreach ($detalhes as $d) {
            $e = $d['engine'] ?? 'unknown';
            $cont[$e] = ($cont[$e] ?? 0) + 1;
        }
        $parts = [];
        foreach ($cont as $eng => $n) {
            $parts[] = $n . ' ' . $eng;
        }
        return implode(' + ', $parts);
    }

    /** Resposta 409 de bloqueio por limite */
    private function blockedResponse(string $target, array $detalhes): Response
    {
        $limite = $this->maxTestFilesPerTarget();
        $resumo = $this->resumoEngines($detalhes);
        return Response::json([
            'ok'              => false,
            'error'           => "Não é possível gravar: já existem " . count($detalhes) . " testes para '{$target}' ({$resumo}). Usa o botão 📋 Copiar para levar o código, ou apaga um dos existentes.",
            'blocked_by_limit'=> true,
            'copy_hint'       => true,
            'target'          => $target,
            'limit'           => $limite,
            'current'         => count($detalhes),
            'files'           => $detalhes,
        ], 409);
    }

    private function autenticado(): bool
    {
        try { return \App\Services\UserService::autenticado(); }
        catch (\Throwable $e) { return false; }
    }

    private function userId(): int
    {
        try { return (int) (\App\Services\UserService::id() ?? 0); }
        catch (\Throwable $e) { return 0; }
    }

    private function projectRoot(): string
    {
        try {
            return \Beaver\Foundation\Application::getInstance()->basePath ?? getcwd();
        } catch (\Throwable $e) {
            return getcwd();
        }
    }

    private function executar(string $command): ?array
    {
        $class = '\\Beaver\\Plugins\\Frankei\\Frankei\\Terminal\\TerminalRunner';

        if (!class_exists($class)) {
            $file = $this->projectRoot() . '/plugins/frankei/src/Frankei/Terminal/TerminalRunner.php';
            if (is_file($file)) require_once $file;
        }

        if (!class_exists($class)) return null;

        try {
            $runner = new $class($this->projectRoot());
            return $runner->run($command);
        } catch (\Throwable $e) {
            return [
                'ok' => false, 'output' => '', 'exit_code' => -1, 'elapsed_ms' => 0,
                'error' => $e->getMessage(),
            ];
        }
    }
}
