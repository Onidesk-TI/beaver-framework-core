    public function forTarget(Request $req): Response
    {
        if (!$this->autenticado()) {
            return Response::json(['ok' => false, 'error' => 'Não autenticado'], 401);
        }

        $class = trim((string) ($req->query['class'] ?? $req->query['classname'] ?? ''));
