<?php

declare(strict_types=1);

namespace Beaver\Plugins\FrankeiTrial\Http;

use Beaver\Http\Request;
use Beaver\Http\Response;

/**
 * TrialAiController
 * Liga o Frankei Trial a API DeepSeek para gerar testes completos.
 */
class TrialAiController
{
    public function status(Request $request): Response
    {
        $key = $this->envStr('DEEPSEEK_API_KEY');

        return Response::json([
            'ok'         => true,
            'configured' => $key !== '',
            'model'      => $this->envStr('DEEPSEEK_MODEL', 'deepseek-chat'),
            'endpoint'   => $this->envStr('DEEPSEEK_API_URL', 'https://api.deepseek.com/v1/chat/completions'),
            'message'    => $key === ''
                ? 'DEEPSEEK_API_KEY nao configurada no .env'
                : 'Pronto para gerar testes',
        ]);
    }

    public function generateTest(Request $request): Response
    {
        $body   = $request->body ?? [];
        $code   = trim((string) ($body['code']   ?? ''));
        $engine = strtolower((string) ($body['engine'] ?? 'phpunit'));
        $target = trim((string) ($body['target'] ?? ''));
        $hints  = trim((string) ($body['hints']  ?? ''));

        if ($code === '') {
            return Response::json(['ok' => false, 'error' => 'Codigo da classe obrigatorio'], 422);
        }
        if (strlen($code) > 30000) {
            return Response::json(['ok' => false, 'error' => 'Codigo demasiado grande (max 30k)'], 413);
        }
        if (!in_array($engine, ['pest', 'phpunit'], true)) {
            return Response::json(['ok' => false, 'error' => 'engine deve ser pest ou phpunit'], 422);
        }

        $key = $this->envStr('DEEPSEEK_API_KEY');
        if ($key === '') {
            return Response::json([
                'ok'      => false,
                'error'   => 'DEEPSEEK_API_KEY nao configurada. Edita o .env',
                'action'  => 'configure_env',
                'env_key' => 'DEEPSEEK_API_KEY',
            ], 412);
        }

        $model   = $this->envStr('DEEPSEEK_MODEL', 'deepseek-chat');
        $url     = $this->envStr('DEEPSEEK_API_URL', 'https://api.deepseek.com/v1/chat/completions');
        $timeout = (int) ($this->envStr('DEEPSEEK_TIMEOUT', '60') ?: 60);

        // FK_AI_CACHE — cache sem TTL, so invalidado se o codigo mudar
        $force       = !empty($body['force']);
        $cacheDir    = $this->projectRoot() . '/plugins/frankei-trial/storage/ai_cache';
        if (!is_dir($cacheDir)) { @mkdir($cacheDir, 0775, true); }
        $targetClass = $target !== '' ? $target : $this->guessTargetClass($code);
        $cacheKey    = preg_replace('/[^A-Za-z0-9_]/', '_', $targetClass !== '' ? $targetClass : 'anom_' . substr(md5($code), 0, 8));
        $cacheFile   = $cacheDir . '/' . $cacheKey . '.json';
        // FK_AI_CACHE_ORIG - invalida pela classe original, nao pelo teste
        $codeHash    = $this->originalClassHash($code) ?? hash('sha256', trim($code));
        $now         = time();

        if (!$force && is_file($cacheFile)) {
            $cached = json_decode((string) @file_get_contents($cacheFile), true);
            if (
                is_array($cached)
                && ($cached['hash'] ?? '') === $codeHash
                && !empty($cached['code'])
            ) {
                return Response::json([
                    'ok'          => true,
                    'code'        => $cached['code'],
                    'raw'         => $cached['raw'] ?? $cached['code'],
                    'explanation' => $cached['explanation'] ?? '',
                    'engine'      => $cached['engine'] ?? $engine,
                    'target'      => $target,
                    'model'       => $cached['model'] ?? '(cache)',
                    'usage'       => null,
                    'from_cache'  => true,
                    'cached_age'  => $now - (int) ($cached['generated_at'] ?? 0),
                ]);
            }
        }

        $prompt = $this->buildPrompt($code, $engine, $target, $hints);

        $payload = [
            'model'       => $model,
            'messages'    => [
                ['role' => 'system', 'content' => $this->systemPrompt($engine)],
                ['role' => 'user',   'content' => $prompt],
            ],
            'temperature' => 0.25,
            'max_tokens'  => 800,
            'stream'      => false,
            'keep_alive'  => '24h',
            'num_ctx'     => 8192,
        ];

        $resp = $this->httpPost($url, $payload, $key, $timeout);

        if (!$resp['ok']) {
            return Response::json([
                'ok'    => false,
                'error' => $resp['error'],
                'raw'   => $resp['raw'] ?? null,
            ], 502);
        }

        $json = $resp['json'] ?? null;
        if (!is_array($json)) {
            return Response::json(['ok' => false, 'error' => 'Resposta invalida da API'], 502);
        }

        $content = (string) ($json['choices'][0]['message']['content'] ?? '');
        if ($content === '') {
            return Response::json(['ok' => false, 'error' => 'API nao devolveu conteudo'], 502);
        }

        [$codeOut, $explanation] = $this->extractCode($content);

        // FK_AI_CACHE — gravar cache (sem TTL)
        @file_put_contents($cacheFile, json_encode([
            'hash'         => $codeHash,
            'generated_at' => $now,
            'code'         => $codeOut,
            'raw'          => $content,
            'explanation'  => $explanation,
            'engine'       => $engine,
            'model'        => $model,
            'target_class' => $targetClass,
        ], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT));

        return Response::json([
            'ok'          => true,
            'code'        => $codeOut,
            'raw'         => $content,
            'explanation' => $explanation,
            'engine'      => $engine,
            'target'      => $target,
            'model'       => $model,
            'usage'       => $json['usage'] ?? null,
            'from_cache'  => false,
        ]);
    }

    private function systemPrompt(string $engine): string
    {
        // FK_BEAVER_CONTEXT — injeta o manual do framework
        $ctx = '';
        $aiDir = $this->projectRoot() . '/plugins/frankei-trial/resources/ai/';
        foreach (['BEAVER_FRAMEWORK.txt', 'PHPUNIT_PEST.txt'] as $f) {
            $file = $aiDir . $f;
            if (is_file($file)) {
                $ctx .= "=== " . $f . " ===\n\n"
                      . file_get_contents($file)
                      . "\n\n=== FIM " . $f . " ===\n\n";
            }
        }

        // FK_BEAVER_CTX_USE — injeta o contexto no inicio do prompt
        $base = $ctx . "És um engenheiro de software sénior especializado em testes PHP. "
              . "Devolve SEMPRE apenas um bloco de código ```php ... ``` sem texto antes ou depois. "
              . "Nunca uses markTestIncomplete, markTestSkipped ou placeholders vazios. "
              . "Cada teste tem de ter asserções concretas.\n\n";

        if ($engine === 'pest') {
            return $base
              . "ESTÁS A GERAR UM FICHEIRO **PEST**. Regras ESTRITAS:\n\n"
              . "PROIBIDO (não uses estas linhas em Pest):\n"
              . "  X namespace Tests\\Unit; ou qualquer 'namespace'\n"
              . "  X class XxxTest extends TestCase\n"
              . "  X public function test_algo(): void\n"
              . "  X \$this->assertSame(...) ou \$this->assert*\n"
              . "  X use PHPUnit\\Framework\\TestCase;\n\n"
              . "OBRIGATÓRIO (usa exactamente estas estruturas):\n"
              . "  OK Ficheiro começa por <?php seguido de uses(TestCase::class); (sem namespace)\n"
              . "  OK Cada teste é it('descrição', function () { ... });\n"
              . "  OK Asserções usam expect(\$valor)->toBe(...), ->toEqual(...), ->toBeTrue(), etc.\n"
              . "  OK Imports de classes com use App\\...; (sem namespace)\n\n"
              . "EXEMPLO DE OUTPUT ESPERADO (imita este estilo):\n"
              . "<?php\n"
              . "use Tests\\TestCase;\n"
              . "use App\\Services\\Calc;\n"
              . "uses(TestCase::class);\n"
              . "it('soma dois inteiros', function () {\n"
              . "    \$calc = new Calc();\n"
              . "    expect(\$calc->soma(2, 3))->toBe(5);\n"
              . "});\n";
        }

        return $base
          . "ESTÁS A GERAR UM FICHEIRO **PHPUNIT**. Regras ESTRITAS:\n"
          . "  OK namespace Tests\\Unit;\n"
          . "  OK use Tests\\TestCase;\n"
          . "  OK class XxxTest extends TestCase { ... }\n"
          . "  OK public function test_algo(): void { \$this->assertX(...); }\n"
          . "PROIBIDO:\n"
          . "  X it('...', function () { ... });\n"
          . "  X expect(...)->...\n"
          . "  X uses(TestCase::class);\n";
    }

    private function buildPrompt(string $code, string $engine, string $target, string $hints): string
    {
        $motor = $engine === 'pest' ? 'Pest' : 'PHPUnit';
        $p = "Gera um ficheiro de teste completo em {$motor} para a seguinte classe PHP";

        if ($target !== '') $p .= " (FQCN: {$target})";
        $p .= ":\n\n```php\n{$code}\n```\n";

        $p .= "\nRequisitos:\n";
        $p .= "- Cobre o comportamento publico da classe.\n";
        $p .= "- Inclui assercoes concretas (nao assertTrue(true)).\n";
        $p .= "- Usa exemplos realistas de entrada/saida.\n";
        $p .= "- Se houver dependencias, cria mocks/stubs apropriados.\n";

        if ($hints !== '') {
            $p .= "\nInstrucoes adicionais:\n" . $hints . "\n";
        }

        return $p;
    }

    private function extractCode(string $raw): array
    {
        $explanation = '';
        $code = $raw;

        if (preg_match('/```(?:php)?\s*\n([\s\S]*?)```/i', $raw, $m)) {
            $code = trim($m[1]);
            $explanation = trim(str_replace($m[0], '', $raw));
        }

        if (stripos(ltrim($code), '<?php') !== 0) {
            $code = "<?php\n\n" . ltrim($code);
        }

        return [$code, $explanation];
    }

    private function envStr(string $key, string $default = ''): string
    {
        $v = $_ENV[$key] ?? $_SERVER[$key] ?? getenv($key);
        if ($v !== false && $v !== null && $v !== '') {
            return (string) $v;
        }

        $envFile = $this->projectRoot() . '/.env';
        if (is_file($envFile)) {
            foreach (file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
                $line = trim($line);
                if ($line === '' || $line[0] === '#') continue;
                if (strpos($line, '=') === false) continue;
                [$k, $val] = explode('=', $line, 2);
                if (trim($k) === $key) {
                    return trim($val, " \t\"'");
                }
            }
        }
        return $default;
    }

    private function guessTargetClass(string $code): string
    {
        if (preg_match('/^\s*(?:abstract\s+|final\s+)?class\s+([A-Za-z_][A-Za-z0-9_]*)/m', $code, $m)) {
            return $m[1];
        }
        if (preg_match('/^\s*namespace\s+([^;]+);/m', $code, $m)) {
            $parts = explode('\\', trim($m[1]));
            return (string) end($parts);
        }
        return '';
    }

    private function originalClassHash(string $testCode): ?string
    {
        // FK_AI_CACHE_ORIG - extrai FQCN do teste e faz hash do conteudo original
        if (!preg_match_all('/^use\s+((?:App|Beaver|Tests)\\\\[\w\\\\]+);/m', $testCode, $m)) {
            return null;
        }

        $root = $this->projectRoot();
        $contents = [];

        foreach (array_unique($m[1]) as $fqcn) {
            if (strpos($fqcn, 'Tests\\') === 0) {
                continue;
            }

            $file = null;

            if (strpos($fqcn, 'App\\') === 0) {
                $rel = 'app/' . str_replace('\\', '/', substr($fqcn, 4)) . '.php';
                $candidate = $root . '/' . $rel;
                if (is_file($candidate)) {
                    $file = $candidate;
                }
            } elseif (strpos($fqcn, 'Beaver\\Plugins\\') === 0) {
                if (preg_match('/^Beaver\\Plugins\\(\w+)\\(.+)$/', $fqcn, $pm)) {
                    $plugin = strtolower($pm[1]);
                    $rel = 'plugins/' . $plugin . '/src/' . str_replace('\\', '/', $pm[2]) . '.php';
                    $candidate = $root . '/' . $rel;
                    if (is_file($candidate)) {
                        $file = $candidate;
                    }
                }
            }

            if ($file !== null) {
                $contents[] = $fqcn . "\n" . file_get_contents($file);
            }
        }

        if (empty($contents)) {
            return null;
        }

        return hash('sha256', implode("\n\n", $contents));
    }

    private function projectRoot(): string
    {
        return dirname(__DIR__, 4);
    }

    private function httpPost(string $url, array $payload, string $bearer, int $timeout): array
    {
        if (!function_exists('curl_init')) {
            return ['ok' => false, 'error' => 'Extensao cURL indisponivel'];
        }

        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST           => true,
            CURLOPT_POSTFIELDS     => json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
            CURLOPT_HTTPHEADER     => [
                'Content-Type: application/json',
                'Authorization: Bearer ' . $bearer,
                'Accept: application/json',
            ],
            CURLOPT_TIMEOUT        => $timeout,
            CURLOPT_CONNECTTIMEOUT => 10,
            CURLOPT_SSL_VERIFYPEER => true,
        ]);

        $out  = curl_exec($ch);
        $err  = curl_error($ch);
        $code = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        if ($out === false) {
            return ['ok' => false, 'error' => 'Falha cURL: ' . $err];
        }

        $json = json_decode((string) $out, true);

        if ($code >= 200 && $code < 300 && is_array($json)) {
            return ['ok' => true, 'json' => $json, 'raw' => (string) $out];
        }

        $msg = 'HTTP ' . $code;
        if (is_array($json) && isset($json['error']['message'])) {
            $msg .= ' - ' . $json['error']['message'];
        }

        return ['ok' => false, 'error' => $msg, 'raw' => (string) $out];
    }
}
