  // 4. Tokens (nunca re-escape do que já tem HTML, porque só vê marcadores)
  t = t.replace(/\$[A-Za-z_][A-Za-z0-9_]*/g, function (m) {
    return putT('<span class="fk-hl-var">' + m + '</span>');
