  /* ══════════════════════════════════════════════════════════════
     Helper global: ativa/desativa o botão Gravar de forma robusta.
     Faz query ao DOM sempre — evita closure stale.
     ══════════════════════════════════════════════════════════════ */
  window.__fkSetDirty = function (dirty) {
    var btn = document.getElementById('fkEditSave');
    if (!btn) {
      console.warn('[fk-dirty] botão #fkEditSave não existe (ainda)');
      return;
    }
    if (dirty) {
      btn.disabled = false;
      btn.removeAttribute('disabled');
      btn.classList.add('is-dirty');
    } else {
      btn.disabled = true;
      btn.setAttribute('disabled', 'disabled');
      btn.classList.remove('is-dirty');
    }
    // Pontinho amarelo
    var dot = document.querySelector('.fk-edit-dot');
    if (dot) dot.style.background = dirty ? '#f59e0b' : 'transparent';
  };

  /* ══════════════════════════════════════════════════════════════
