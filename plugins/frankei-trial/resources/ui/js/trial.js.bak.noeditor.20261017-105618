/* ══════════════════════════════════════════════════════════════
   FK_LINENUMS_V2
   Números de linha para o editor. Usa position:absolute para
   não partir o layout (que acontecia com flex).
   Requer FK_HIGHLIGHT_V1 (o wrapper .fk-hl-wrapper).
   ══════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var bound = null;
  var gutter = null;
  var lastCount = -1;

  function garantirGutter(wrapper) {
    var g = wrapper.querySelector('.fk-ln-gutter');
    if (g) return g;
    g = document.createElement('div');
    g.className = 'fk-ln-gutter';
    g.setAttribute('aria-hidden', 'true');
    wrapper.insertBefore(g, wrapper.firstChild);
    return g;
  }

  function render(ta, g) {
    var texto = ta.value || '';
    var n = texto.split('\n').length;
    if (n < 1) n = 1;

    if (n !== lastCount) {
      var linhas = '';
      for (var i = 1; i <= n; i++) {
        linhas += '<span class="fk-ln">' + i + '</span>';
      }
      g.innerHTML = linhas;
      lastCount = n;
    }

    // Sync scroll vertical
    g.scrollTop = ta.scrollTop;
  }

  function bind(ta) {
    if (bound === ta) return;
    bound = ta;

    var wrapper = ta.parentNode;
    if (!wrapper || !wrapper.classList.contains('fk-hl-wrapper')) {
      console.warn('[fk-ln] precisa do wrapper do FK_HIGHLIGHT_V1');
      return;
    }

    gutter = garantirGutter(wrapper);
    wrapper.classList.add('has-gutter');
    render(ta, gutter);

    ta.addEventListener('input', function () { render(ta, gutter); });
    ta.addEventListener('change', function () { render(ta, gutter); });
    ta.addEventListener('scroll', function () {
      if (gutter) gutter.scrollTop = ta.scrollTop;
    });

    var prevRefresh = window.__fkHighlightRefresh;
    window.__fkHighlightRefresh = function () {
      if (typeof prevRefresh === 'function') {
        try { prevRefresh(); } catch (e) {}
      }
      lastCount = -1;
      render(ta, gutter);
    };

    console.log('[fk-ln] ativo');
  }

  function procurar() {
    var ta = document.querySelector('.fk-edit-code');
    if (!ta || ta.tagName !== 'TEXTAREA') return false;
    // Só age se o wrapper do highlight já existir
    var wrapper = ta.parentNode;
    if (!wrapper || !wrapper.classList.contains('fk-hl-wrapper')) return false;
    if (wrapper.classList.contains('has-gutter')) {
      bound = ta; gutter = wrapper.querySelector('.fk-ln-gutter');
      return true;
    }
    bind(ta);
    return true;
  }

  function iniciar() {
    if (procurar()) return;
    var tent = 0;
    var iv = setInterval(function () {
      tent++;
      if (procurar() || tent > 120) clearInterval(iv);
    }, 250);
    try {
      var obs = new MutationObserver(function () { procurar(); });
      obs.observe(document.body, { childList: true, subtree: true });
    } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
})();

