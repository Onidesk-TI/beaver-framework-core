      var s = itens[i];
      var sel = i === idx ? ' is-selected' : '';
      html += '<div class="fk-suggest-item' + sel + '" data-idx="' + i + '">'
            +   '<code>' + escapeHtml(s.insert.split('\n')[0].substring(0, 60)) + '</code>'
