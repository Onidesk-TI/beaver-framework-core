    p.innerHTML = ''
      + '<header class="fk-run-head">'
      +   '<button type="button" class="fk-run-btn fk-run-toggle" data-act="toggle" title="Colapsar / expandir">◀</button>'
      +   '<div class="fk-run-brand">'
      +     BEAVER_SVG
      +     '<span class="fk-run-brand-name">Output</span>'
      +     '<span class="fk-run-engine" id="fkRunEngine">—</span>'
      +     '<span class="fk-run-php" id="fkRunPhp" title="Servidor PHP"><span class="fk-run-php-dot"></span><span id="fkRunPhpText">PHP</span></span>'
      +   '</div>'
      +   '<div class="fk-run-actions">'
      +     '<button type="button" class="fk-run-btn" data-act="clear" title="Limpar">✕</button>'
      +   '</div>'
      + '</header>'
      + '<div class="fk-run-body" id="fkRunBody">'
      +   '<div class="fk-run-empty">'
      +     '<div class="fk-run-empty-icon">'
      +       BEAVER_SVG
      +     '</div>'
      +     '<p class="fk-run-empty-title">Sem execuções</p>'
      +     '<p class="fk-run-empty-text">Corre um teste para ver o output aqui.</p>'
      +   '</div>'
      + '</div>'
      + '<footer class="fk-run-summary" id="fkRunSummary" hidden>'
      +   '<span class="fk-run-summary-text" id="fkRunSummaryText">—</span>'
      +   '<span class="fk-run-time" id="fkRunTime">0.000s</span>'
      + '</footer>';

    editBody.appendChild(p);

    p.querySelector('[data-act="clear"]').addEventListener('click', limpar);
    p.querySelector('[data-act="toggle"]').addEventListener('click', function () {
      p.classList.toggle('is-collapsed');
      this.textContent = p.classList.contains('is-collapsed') ? '▶' : '◀';
    });

    body    = p.querySelector('#fkRunBody');
    summary = p.querySelector('#fkRunSummary');
    engineTag = p.querySelector('#fkRunEngine');

    return p;
  }

  function limpar() {
    if (!body) return;
    body.innerHTML = ''
      + '<div class="fk-run-empty">'
      +   '<div class="fk-run-empty-icon">' + BEAVER_SVG + '</div>'
      +   '<p class="fk-run-empty-title">Sem execuções</p>'
      +   '<p class="fk-run-empty-text">Corre um teste para ver o output aqui.</p>'
      + '</div>';
    if (summary) summary.hidden = true;
    lastSig = '';
  }

  function esc(s) {
    return String(s).replace(/[&<>]/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;' }[c];
    });
  }

  function classificarLinha(txt) {
    var t = (txt || '').trim();
    if (!t) return 'fk-run-line';
    if (/^✓|^PASS\b|passed/i.test(t))            return 'fk-run-line fk-run-pass';
    if (/^✗|^FAIL|failed|Error\b|Exception\b/i.test(t)) return 'fk-run-line fk-run-fail';
    if (/^!|warning|skipped/i.test(t))            return 'fk-run-line fk-run-warn';
    if (/^(Tests:|Time:|PHPUnit|Pest|OK\b)/i.test(t)) return 'fk-run-line fk-run-info';
    if (/^\s*\d+(\.\d+)?\s*ms|^\s*\d+\.\d+s$/i.test(t)) return 'fk-run-line fk-run-meta';
    return 'fk-run-line';
  }

  function espelhar(term) {
    if (!body) return;

    // Evita re-render desnecessário
    var sig = (term.textContent || '').length + ':' + (term.children.length);
    if (sig === lastSig) return;
    lastSig = sig;

    var texto = (term.textContent || '').trim();
    if (!texto) return;

    var linhas = Array.from(term.childNodes).filter(function (n) {
      return n.nodeType === 1 || (n.nodeType === 3 && n.nodeValue.trim());
    });
    if (!linhas.length) linhas = texto.split('\n');

    var html = '';
    linhas.forEach(function (n) {
      var t = n.textContent !== undefined ? n.textContent : n;
      html += '<div class="' + classificarLinha(t) + '">' + esc(t) + '</div>';
    });

    body.innerHTML = html;
    body.scrollTop = body.scrollHeight;

    // ── Resumo: tenta vários formatos ──
    var pass = null, fail = null, tempoSeg = null;

    // 1. Formato PHPUnit: "Tests: 3 passed, 1 failed"
    var m1 = texto.match(/Tests?:\s*(\d+)\s*passed(?:,\s*(\d+)\s*failed)?/i);
    if (m1) { pass = m1[1]; fail = m1[2] || '0'; }

    // 2. Formato Frankei: "✓ N passaram" ou "Falhas: N"
    if (pass === null) {
      var mPass = texto.match(/(?:passaram|aprovados|passed)\s*[:\s]\s*(\d+)/i);
      var mFail = texto.match(/(?:falhas|failed)\s*[:\s]\s*(\d+)/i);
      if (mPass) pass = mPass[1];
      if (mFail) fail = mFail[1];
      if (pass !== null && fail === null) fail = '0';
    }

    // 3. Tempo — múltiplos formatos
    //    a) "Time: 0.057s"
    var tA = texto.match(/Time:\s*([\d.]+)\s*s/i);
    if (tA) tempoSeg = parseFloat(tA[1]);

    //    b) "· 807ms"  /  "Sucesso · 807ms"  /  "Duração: 807ms"
    if (tempoSeg === null) {
      var tB = texto.match(/(\d+(?:\.\d+)?)\s*ms\b/i);
      if (tB) tempoSeg = parseFloat(tB[1]) / 1000;
    }

    //    c) "0.057s" (sem prefixo)
    if (tempoSeg === null) {
      var tC = texto.match(/\b(\d+\.\d+)\s*s\b/i);
      if (tC) tempoSeg = parseFloat(tC[1]);
    }

    //    d) "Duracao: 1s" / "1 s"
    if (tempoSeg === null) {
      var tD = texto.match(/(?:Dura[çc][aã]o|Duration)\s*[:\s]\s*(\d+(?:\.\d+)?)\s*s?\b/i);
      if (tD) tempoSeg = parseFloat(tD[1]);
    }

    // Aplicar
    if (pass !== null) {
      summary.hidden = false;
      summary.querySelector('#fkRunSummaryText').innerHTML =
        '<span class="fk-run-ok">✓ ' + pass + '</span>'
        + ' · '
        + '<span class="' + (fail === '0' ? 'fk-run-ok' : 'fk-run-nok') + '">✗ ' + fail + '</span>';
    }

    if (tempoSeg !== null) {
      summary.hidden = false;
      var t = tempoSeg < 1
        ? Math.round(tempoSeg * 1000) + 'ms'
        : tempoSeg.toFixed(3) + 's';
      summary.querySelector('#fkRunTime').textContent = t;
    }
  }

  // ── Chip do servidor PHP ──
  function actualizarServidor() {
    var chip = document.getElementById('fkRunPhp');
    var txt  = document.getElementById('fkRunPhpText');
    if (!chip || !txt) return;

    // Estado inicial — "a verificar"
    chip.classList.remove('is-ok', 'is-bad');
    txt.textContent = 'a verificar…';

    fetch('/api/frankei-trial/health', { credentials: 'include' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var ver = (d && (d.php_version || d.php)) || null;
        if (d && d.ok) {
          chip.classList.add('is-ok');
          txt.textContent = ver ? ('PHP ' + ver) : 'PHP OK';
        } else {
          chip.classList.add('is-bad');
          txt.textContent = 'PHP erro';
        }
      })
      .catch(function () {
        chip.classList.add('is-bad');
        txt.textContent = 'PHP offline';
      });
  }

  function actualizarMotor() {
    if (!engineTag) return;
    var ta = document.querySelector('.fk-edit-code');
    if (!ta) return;
    var v = ta.value || '';
    var eng = /\bit\s*\(|\buses\s*\(/.test(v) ? 'PEST' : 'PHPUNIT';
    engineTag.textContent = eng;
  }

  function procurarTerminal() {
    var t = document.querySelector('.fk-edit-output') || document.querySelector('.fk-trial-term-output');
    if (!t) return false;
    espelhar(t);
    var obs = new MutationObserver(function () { espelhar(t); });
    obs.observe(t, { childList: true, subtree: true, characterData: true });
    console.log('[fk-run] a observar terminal');
    return true;
  }

  function bind() {
    var eb = document.querySelector('.fk-edit-body');
    if (!eb) return false;
    if (eb.querySelector('.fk-run-panel')) {
      panel = eb.querySelector('.fk-run-panel');
      body  = panel.querySelector('#fkRunBody');
      summary = panel.querySelector('#fkRunSummary');
      engineTag = panel.querySelector('#fkRunEngine');
      return true;
    }

    panel = criar(eb);
    console.log('[fk-run] painel criado');

    // Consultar servidor PHP
    setTimeout(actualizarServidor, 100);
    // Actualizar a cada 15s
    setInterval(actualizarServidor, 15000);

    var code = document.querySelector('.fk-edit-code');
    if (code) {
      code.addEventListener('input', actualizarMotor);
      code.addEventListener('change', actualizarMotor);
      actualizarMotor();
    }

    if (!procurarTerminal()) {
      var tent = 0;
      var iv = setInterval(function () {
        tent++;
        if (procurarTerminal() || tent > 60) clearInterval(iv);
      }, 300);
    }
    return true;
  }

  function iniciar() {
    if (bind()) return;
    var tent = 0;
    var iv = setInterval(function () {
      tent++;
      if (bind() || tent > 80) clearInterval(iv);
    }, 250);
    try {
      var obs = new MutationObserver(function () { bind(); });
      obs.observe(document.body, { childList: true, subtree: true });
    } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
})();

/* ══════════════════════════════════════════════════════════════
   FK_ANALYSIS_TAB_V1
   Adiciona abas "Output" / "Análise" à área roxa do editor.
   A aba Output mantém o comportamento original.
   A aba Análise corre client-side (regex no textarea).
   ══════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var initialized = false;
  var current = 'output';

  function esc(s) {
    return String(s).replace(/[&<>]/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;' }[c];
    });
  }

  // ── Análise (100% client-side) ──
  function analisar(codigo) {
    var linhas = codigo.split('\n');
    var out = {
      total_linhas: linhas.length,
      long_lines: [],
      debug_left: [],
      todos: [],
      missing_assertions: [],
      complexity: { methods: [], max: 0, avg: 0, max_name: '' }
    };

    // Detectar métodos
    var re = /^\s*(?:public|protected|private)?\s*(?:static\s+)?function\s+([A-Za-z_]\w*)\s*\([^)]*\)[^{]*\{/gm;
    var matches = [];
    var m;
    while ((m = re.exec(codigo)) !== null) {
      matches.push({
        name: m[1],
        start: m.index,
        line: codigo.substring(0, m.index).split('\n').length
      });
    }

    // Por linha
    for (var i = 0; i < linhas.length; i++) {
      var l = linhas[i];
      var n = i + 1;

      if (l.length > 120) out.long_lines.push({ line: n, len: l.length });

      var dbg = l.match(/\b(var_dump|print_r|dd|dump|ray)\s*\(/);
      if (dbg) out.debug_left.push({ line: n, fn: dbg[1] });

      var td = l.match(/\b(TODO|FIXME|XXX|HACK)\b/);
      if (td) out.todos.push({ line: n, tag: td[1] });
    }

    // Por método (complexidade + asserções)
    for (var k = 0; k < matches.length; k++) {
      var start = matches[k].start;
      var end = (k + 1 < matches.length) ? matches[k + 1].start : codigo.length;
      var body = codigo.substring(start, end);

      if (!/\b(assert|expect|assertSame|assertTrue|assertFalse|toBe|toEqual)\b/.test(body)) {
        out.missing_assertions.push({ name: matches[k].name, line: matches[k].line });
      }

      var cx = (body.match(/\b(if|elseif|else\s+if|for|foreach|while|case|catch)\b|&&|\|\|/g) || []).length + 1;
      out.complexity.methods.push({ name: matches[k].name, cx: cx, line: matches[k].line });
    }

    if (out.complexity.methods.length) {
      var sum = 0, max = 0, maxName = '';
      for (var z = 0; z < out.complexity.methods.length; z++) {
        var c = out.complexity.methods[z];
        sum += c.cx;
        if (c.cx > max) { max = c.cx; maxName = c.name; }
      }
      out.complexity.avg = (sum / out.complexity.methods.length).toFixed(1);
      out.complexity.max = max;
      out.complexity.max_name = maxName;
    }

    return out;
  }

  function renderizar(r) {
    var html = '<div class="fk-an-title">🔍 Análise do código</div>';

    var problemas = r.long_lines.length + r.debug_left.length + r.todos.length + r.missing_assertions.length;

    if (problemas === 0) {
      html += '<div class="fk-an-ok">✓ Sem problemas detectados</div>';
    }

    if (r.debug_left.length) {
      html += '<div class="fk-an-section fk-an-warn">⚠️ ' + r.debug_left.length + ' chamada(s) de debug esquecida(s)</div>';
      r.debug_left.forEach(function (d) {
        html += '<div class="fk-an-item">• Linha ' + d.line + ': <code>' + esc(d.fn) + '()</code></div>';
      });
    }

    if (r.missing_assertions.length) {
      html += '<div class="fk-an-section fk-an-warn">⚠️ ' + r.missing_assertions.length + ' método(s) sem asserções</div>';
      r.missing_assertions.forEach(function (d) {
        html += '<div class="fk-an-item">• <code>' + esc(d.name) + '</code> (linha ' + d.line + ')</div>';
      });
    }

    if (r.long_lines.length) {
      html += '<div class="fk-an-section fk-an-info">📏 ' + r.long_lines.length + ' linha(s) longa(s) >120 chars</div>';
      r.long_lines.slice(0, 10).forEach(function (d) {
        html += '<div class="fk-an-item">• Linha ' + d.line + ': ' + d.len + ' caracteres</div>';
      });
      if (r.long_lines.length > 10) {
        html += '<div class="fk-an-item">• … e mais ' + (r.long_lines.length - 10) + '</div>';
      }
    }

    if (r.todos.length) {
      html += '<div class="fk-an-section fk-an-info">📝 ' + r.todos.length + ' TODO / FIXME</div>';
      r.todos.forEach(function (d) {
        html += '<div class="fk-an-item">• Linha ' + d.line + ': ' + esc(d.tag) + '</div>';
      });
    }

    if (r.complexity.methods.length) {
      html += '<div class="fk-an-section fk-an-info">📊 Complexidade ciclomática</div>';
      html += '<div class="fk-an-item">• ' + r.complexity.methods.length + ' métodos · média ' + r.complexity.avg + ' · máx ' + r.complexity.max + ' (<code>' + esc(r.complexity.max_name) + '</code>)</div>';
    }

    html += '<div class="fk-an-section fk-an-info">Contagens para testes</div>';
    html += '<div class="fk-an-item">• Métodos usados: <b>' + r.methods_total + '</b></div>';
    html += '<div class="fk-an-item">• Métodos testados: <b>' + r.methods_tested + '</b></div>';
    html += '<div class="fk-an-item">• Métodos não testados: <b>' + r.methods_untested + '</b></div>';
    html += '<div class="fk-an-item">• Testes criados: <b>' + r.tests_count + '</b></div>';
    html += '<div class="fk-an-item">• Asserções: <b>' + r.asserts_count + '</b></div>';
    html += '<div class="fk-an-item">• Mocks/Stubs: <b>' + r.mocks_count + '</b></div>';
    html += '<div class="fk-an-item">• Data providers: <b>' + r.providers_count + '</b></div>';
    html += '<div class="fk-an-item">• Dependências injetadas: <b>' + r.injections_count + '</b></div>';
    html += '<div class="fk-an-item">• Cobertura estimada: <b>' + r.coverage + '%</b></div>';

    html += '<div class="fk-an-meta">' + r.total_linhas + ' linhas · ' + r.complexity.methods.length + ' método(s)</div>';
    return html;
  }

  function correrAnalise(panel) {
    var ta = document.querySelector('.fk-edit-code');
    if (!ta) {
      panel.innerHTML = '<div class="fk-an-empty">Sem editor aberto</div>';
      return;
    }
    try {
      var r = analisar(ta.value || '');
      panel.innerHTML = renderizar(r);
    } catch (e) {
      panel.innerHTML = '<div class="fk-an-empty">Erro a analisar: ' + esc(e.message) + '</div>';
    }
  }

  function setup() {
    if (initialized) return true;

    var out = document.getElementById('fkEditOutput') || document.querySelector('.fk-edit-output');
    if (!out) return false;

    var parent = out.parentNode;
    if (!parent) return false;
    if (parent.querySelector('.fk-an-tabs')) { initialized = true; return true; }

    // Barra de abas
    var tabs = document.createElement('div');
    tabs.className = 'fk-an-tabs';
    tabs.innerHTML = ''
      + '<button type="button" class="fk-an-tab is-active" data-tab="output">▶ Output</button>'
      + '<button type="button" class="fk-an-tab" data-tab="analysis">🔍 Análise</button>';

    // Painel de análise
    var panel = document.createElement('div');
    panel.className = 'fk-an-panel';
    panel.setAttribute('hidden', '');

    parent.insertBefore(tabs, out);
    parent.insertBefore(panel, out.nextSibling);

    // Wrapper do output (para esconder sem tocar no <pre>)
    out.classList.add('fk-an-output');

    tabs.querySelectorAll('.fk-an-tab').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tab = this.getAttribute('data-tab');
        if (tab === current) return;
        current = tab;

        tabs.querySelectorAll('.fk-an-tab').forEach(function (b) { b.classList.remove('is-active'); });
        this.classList.add('is-active');

        if (tab === 'output') {
          out.setAttribute('hidden', '');
          panel.removeAttribute('hidden');
          panel.innerHTML = '<div class="fk-an-empty">O output é executado no painel da direita.</div>';
        } else {
          out.setAttribute('hidden', '');
          panel.removeAttribute('hidden');
          correrAnalise(panel);
        }
      });
    });

    // Re-analisar automaticamente quando muda o conteúdo e estamos na tab análise
    var ta = document.querySelector('.fk-edit-code');
    if (ta) {
      var timer;
      ta.addEventListener('input', function () {
        if (current !== 'analysis') return;
        clearTimeout(timer);
        timer = setTimeout(function () { correrAnalise(panel); }, 800);
      });
    }

    initialized = true;
    console.log('[fk-an] abas Output / Análise activas');
    return true;
  }

  function iniciar() {
    if (setup()) return;
    var tent = 0;
    var iv = setInterval(function () {
      tent++;
      if (setup() || tent > 100) clearInterval(iv);
    }, 250);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
})();

/* ══════════════════════════════════════════════════════════════
   FK_SUGGEST_DEMO_GEN
   Gera código de exemplo sem chamar a API — usa o editor como pista.
   ══════════════════════════════════════════════════════════════ */
function __fkSuggestDemoGenerate() {
  var ta = document.querySelector('.fk-edit-code');
  var code = ta ? (ta.value || '') : '';
  var isPest = /\bit\s*\(|\buses\s*\(|\bexpect\s*\(/.test(code);
  var engine = isPest ? 'pest' : 'phpunit';

  // Tentar extrair a classe alvo (ex: AuthController)
  var alvo = 'Alvo';
  var m = code.match(/class\s+([A-Z]\w+)Test\b/) || code.match(/['"]([A-Z]\w+)['"]/) || code.match(/use\s+App\\[\\\w]+\\([A-Z]\w+)/);
  if (m && m[1]) alvo = m[1];
  alvo = alvo.replace(/Test$/, '');

  var header = '// ⚠️ DEMO (sem chamar a API) — substitui por geração real quando tiveres créditos\n'
             + '// Classe alvo detectada: ' + alvo + '\n'
             + '// Motor detectado: ' + engine.toUpperCase() + '\n\n';

  if (engine === 'pest') {
    return '<?php\n\n' + header
      + 'declare(strict_types=1);\n\n'
      + 'use Tests\\TestCase;\n'
      + 'use App\\Controllers\\' + alvo + ';\n\n'
      + 'uses(TestCase::class);\n\n'
      + 'it(\'responde com sucesso no caso base\', function () {\n'
      + '    // Arrange\n'
      + '    $controller = new ' + alvo + '();\n\n'
      + '    // Act\n'
      + '    $resultado = $controller->handle();\n\n'
      + '    // Assert\n'
      + '    expect($resultado)->not->toBeNull();\n'
      + '});\n\n'
      + 'it(\'lida com erro esperado\', function () {\n'
      + '    $controller = new ' + alvo + '();\n\n'
      + '    expect(fn() => $controller->handle(null))\n'
      + '        ->toThrow(InvalidArgumentException::class);\n'
      + '});\n';
  }

  // PHPUnit
  return '<?php\n\n' + header
    + 'declare(strict_types=1);\n\n'
    + 'namespace Tests\\Unit;\n\n'
    + 'use Tests\\TestCase;\n'
    + 'use App\\Controllers\\' + alvo + ';\n\n'
    + 'class ' + alvo + 'Test extends TestCase\n'
    + '{\n'
    + '    private ' + alvo + ' $obj;\n\n'
    + '    protected function setUp(): void\n'
    + '    {\n'
    + '        parent::setUp();\n'
    + '        $this->obj = new ' + alvo + '();\n'
    + '    }\n\n'
    + '    public function test_responde_caso_base(): void\n'
    + '    {\n'
    + '        // Act\n'
    + '        $resultado = $this->obj->handle();\n\n'
    + '        // Assert\n'
    + '        $this->assertNotNull($resultado);\n'
    + '    }\n\n'
    + '    public function test_lida_com_erro_esperado(): void\n'
    + '    {\n'
    + '        $this->expectException(InvalidArgumentException::class);\n\n'
    + '        $this->obj->handle(null);\n'
    + '    }\n'
    + '}\n';
}

