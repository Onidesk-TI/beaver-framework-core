  /* ── 6. APLICAR SNIPPET ── */
  function aplicar() {
    if (!itens.length) return;
    var s = itens[idx];
    var ta = taBound;
    var code = ta.value;
    var pos = ta.selectionStart;
    var start = pos - word.length;

    // 1. Substituir triggerWord pelo insert
    var antes = code.substring(0, start);
    var depois = code.substring(pos);
    var insert = s.insert;

    // 2. Extrair placeholders e escolher o primeiro
    var primeiroInicio = -1, primeiroFim = -1, primeiroTexto = '';
    var out = '';
    var i = 0;
    var phCount = 0;
    while (i < insert.length) {
      var rest = insert.substring(i);
      // ${N:texto}  ou  $N
      var m = rest.match(/^\$\{(\d+):([^}]*)\}|^\$(\d+)/);
      if (m) {
        var texto = m[2] !== undefined ? m[2] : '';
