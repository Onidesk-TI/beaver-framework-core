  function marcarDirty() {
      isDirty = true;
      if (window.__fkSetDirty) window.__fkSetDirty(true);
      if ($btnSave) { $btnSave.disabled = false; $btnSave.removeAttribute('disabled'); }
      setEditStatus('Alterado · não gravado', 'warn');
    }

    function limparDirty() {
      isDirty = false;
      if (window.__fkSetDirty) window.__fkSetDirty(false);
      if ($btnSave) { $btnSave.disabled = true; $btnSave.setAttribute('disabled','disabled'); }
    }

    // ─── Carregar ───
    function carregar() {
      var url = '/api/frankei/test-file?class=' + encodeURIComponent(classname);
      fetch(url, { credentials: 'include' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok && d.error && /não encontrado|not found/i.test(d.error)) {
            d = { ok: true, content: '', file: classname + '.php', size: 0, mtime: '' };
          }
          if (!d.ok) throw new Error(d.error || 'Erro');

          currentContent = d.content || '';
          if ($path) $path.textContent = d.file || classname;

          codeArea = document.createElement('textarea');
          codeArea.className = 'fk-edit-code';
          codeArea.spellcheck = false;
          codeArea.value = currentContent;

          $body.innerHTML = '';
          $body.appendChild(codeArea);

          codeArea.addEventListener('keydown', function (e) {
            if (e.key === 'Tab') {
              e.preventDefault();
              var s = this.selectionStart, ep = this.selectionEnd;
              this.value = this.value.substring(0, s) + '    ' + this.value.substring(ep);
              this.selectionStart = this.selectionEnd = s + 4;
              marcarDirty();
            }
          });
          codeArea.addEventListener('input', marcarDirty);

          var kb = Math.round((d.size || 0) / 102.4) / 10;
          if ($meta) $meta.textContent = kb + ' KB · ' + (d.mtime || '');
          // Detectar engine
          var detected = detectTestEngine(currentContent);
          state.editorDetectedEngine = detected || 'pest';
          state.editorEngine = state.editorDetectedEngine;

          // Guardar estado original para undo
          state.editorOriginalContent = currentContent;
          state.editorOriginalEngine = state.editorDetectedEngine;
          state.editorConverted = false;
          // Reset bloqueio
          state.editorBlockedByLimit = false;
          state.editorBlockReason = '';
          // FK_COPY_HDR — botao Copiar sempre visivel no header
          // (removida a logica que o escondia)

          // Guardar estado original para undo
          state.editorOriginalContent = currentContent;
          state.editorOriginalEngine = state.editorDetectedEngine;
          state.editorConverted = false;
          if ($engineSel) $engineSel.value = state.editorDetectedEngine;

          limparDirty();
        })
        .catch(function (e) {
          $body.innerHTML = '<div class="fk-edit-loading" style="color:#ef4444">✗ Erro: ' + esc(e.message) + '</div>';
          setEditStatus('Erro', 'err');
        });
    }

    // ─── Gravar ───
    function gravar() {
      if (!codeArea) return;
      $btnSave.disabled = true;
      setEditStatus('A gravar...', 'run');

      // Conversão → sempre /tests/save (backend cria sibling, preserva original)
      var endpoint = state.editorConverted
        ? '/api/frankei-trial/tests/save'
        : (state.editorNewFile
            ? '/api/frankei-trial/tests/create'
            : '/api/frankei-trial/tests/save');

      fetch(endpoint, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          class: classname,
          content: codeArea.value,
          engine: state.editorEngine || 'pest',
          from_engine: state.editorDetectedEngine || '',
          to_engine: state.editorEngine || '',
        })
      })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) throw new Error(d.error || 'Erro');
        currentContent = codeArea.value;
        limparDirty();
        var msg = 'Gravado';
        if (d.from_engine && d.to_engine && d.from_engine !== d.to_engine) {
          msg = 'Convertido ' + d.from_engine.toUpperCase() + ' → ' + d.to_engine.toUpperCase() + ' · backup: ' + d.backup;
        } else if (d.backup) {
          msg = 'Gravado · backup: ' + d.backup;
        }
        setEditStatus(msg, 'ok');
        // Actualizar engine detectado após gravar
        if (d.to_engine) {
          state.editorDetectedEngine = d.to_engine;
          state.editorEngine = d.to_engine;
          state.editorOriginalEngine = d.to_engine;
        }
        // O conteúdo actual passa a ser o "original"
        state.editorOriginalContent = codeArea.value;
        state.editorConverted = false;
        state.editorNewFile = false;
        if (typeof atualizarUndoBtn === 'function') atualizarUndoBtn();
        window.__fkSetDirty(false);
        var kb = Math.round((d.bytes || 0) / 102.4) / 10;
        if ($meta) $meta.textContent = kb + ' KB · ' + (d.mtime || '');
      })
      .catch(function (e) {
        setEditStatus('✗ ' + e.message, 'err');
        $btnSave.disabled = false;
      });
    }

    // ─── Correr ───
    function correr() {
      $btnRun.disabled = true;
      setEditStatus('A correr...', 'run');
      $output.hidden = false;
      var _ta = document.querySelector('.fk-edit-code');
      var _code = _ta ? (_ta.value || '') : '';
      if (!_code.trim()) {
        $output.textContent = '✗ Editor vazio';
        setEditStatus('Editor vazio', 'err');
        $btnRun.disabled = false;
        return;
      }
      $output.textContent = '→ a correr ficheiro temporario (editor)...\n\n';

      fetch('/api/frankei-trial/tests/run-editor', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          class: classname,
          engine: $engineSel ? $engineSel.value : 'pest',
          code: _code
        })
      })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var head = (d.ok ? '✓ Sucesso' : '✗ Falha') + ' · ' + d.elapsed_ms + 'ms\n' +
                   '─────────────────────────────\n\n';
        $output.textContent = head + (d.lines || []).join('\n');
        setEditStatus(d.ok ? 'Passou' : 'Falhou', d.ok ? 'ok' : 'err');
      })
      .catch(function (e) {
        $output.textContent = '✗ Erro: ' + e.message;
        setEditStatus('Erro', 'err');
      })
      .finally(function () { $btnRun.disabled = false; });
    }

    // ─── Fechar ───
    function fechar() {
      if (isDirty && !confirm('Tens alterações por gravar. Fechar mesmo assim?')) return;
      modal.classList.remove('open', 'fk-editor-mode');
      body.innerHTML = '';
    }

    if ($btnRun)    $btnRun.addEventListener('click', correr);
    if ($btnSave)   $btnSave.addEventListener('click', gravar);
    if ($btnReload) $btnReload.addEventListener('click', function () {
      if (isDirty && !confirm('Recarregar vai perder as alterações. Continuar?')) return;
      carregar();
    });
    if ($btnClose)  $btnClose.addEventListener('click', fechar);

    // ── 📋 Copiar (só aparece quando bloqueado) ──
    if ($btnCopy) {
      $btnCopy.addEventListener('click', function () {
        var txt = codeArea ? codeArea.value : '';
        if (!txt) {
          setEditStatus('✗ Nada para copiar', 'err');
          return;
        }
        function ok() {
          setEditStatus('📋 Código copiado para o clipboard (' + txt.length + ' chars)', 'ok');
        }
        function fail() {
          // Fallback: selecionar temporariamente + execCommand
          try {
            codeArea.focus();
            codeArea.select();
            var okExec = document.execCommand('copy');
            if (okExec) ok();
            else setEditStatus('✗ Falha ao copiar — copia manualmente', 'err');
          } catch (e) {
            setEditStatus('✗ ' + e.message, 'err');
          }
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(txt).then(ok).catch(fail);
        } else {
          fail();
        }
      });
    }

    // ── Guardas: bloquear Ctrl+A / C / X / S e menu de contexto ──
    if (codeArea) {
      codeArea.addEventListener('keydown', function (e) {
        var meta = e.ctrlKey || e.metaKey;
        if (!meta) return;
        var k = (e.key || '').toLowerCase();

        // Bloquear sempre o Ctrl+S nativo (o save do plugin usa o botão 💾)
        if (k === 's') {
          e.preventDefault();
          e.stopPropagation();
          // Se não estiver bloqueado por limite, dispara o save
          if (!state.editorBlockedByLimit && $btnSave && !$btnSave.disabled) {
            $btnSave.click();
          } else if (state.editorBlockedByLimit) {
            window.__fkPiscarLimite(1500);
            setEditStatus('⛔ ' + (state.editorBlockReason || 'Não é possível gravar'), 'err');
          }
          return;
        }

        // Bloquear sempre cópia / seleção-total / corte
        if (k === 'a' || k === 'c' || k === 'x') {
          e.preventDefault();
          e.stopPropagation();
          setEditStatus('⛔ Cópia bloqueada — usa o botão 📋 (aparece quando o limite é atingido)', 'warn');
          return;
        }
      }, true);

      // Bloquear menu de contexto (botão direito)
      codeArea.addEventListener('contextmenu', function (e) {
        e.preventDefault();
        e.stopPropagation();
        setEditStatus('⛔ Clique direito bloqueado', 'warn');
        return false;
      });

      // Bloquear drag-select de "cópia rápida" via right-drag? Não; deixa o esquerdo.
      codeArea.addEventListener('mousedown', function (e) {
        if (e.button === 2) {
          e.preventDefault();
          return false;
        }
      });
    }


    // ── 🆕 Novo teste limpo ──
    if ($btnNew) {
      $btnNew.addEventListener('click', function () {
        var maxFiles = window.__fkTrialMaxFiles || 2;
        var nome = prompt(
          'Nome da classe de teste (ex: MyServiceTest):\n\n' +
          '⚠️  Limite: ' + maxFiles + ' ficheiro(s) de teste por objecto.\n' +
          /*'Ajustável em .env → FK_TRIAL_MAX_TEST_FILES_PER_TARGET',*/
          ''
        );
        if (!nome) return;
        nome = nome.trim().replace(/[^A-Za-z0-9_]/g, '');
        if (!nome) { setEditStatus('✗ Nome inválido', 'err'); return; }

        var eng = prompt('Motor? Escreve "pest" ou "phpunit":', state.editorEngine || 'pest');
        if (!eng) return;
        eng = eng.toLowerCase().trim();
        if (eng !== 'pest' && eng !== 'phpunit') {
          setEditStatus('✗ Motor tem de ser pest ou phpunit', 'err');
          return;
        }

        var tmpl = __fkTemplate(nome, eng);
        if (typeof window.__fkTrialSetEditorCode === 'function') {
          window.__fkTrialSetEditorCode(tmpl);
        }
        state.editorClassname = nome;
        state.editorEngine = eng;
        state.editorDetectedEngine = eng;
        state.editorConverted = false;
        state.editorNewFile = true;         // marca: ainda não existe no disco
        state.editorOriginalContent = '';
        state.editorOriginalEngine = eng;
        if ($engineSel) $engineSel.value = eng;
        if (typeof atualizarUndoBtn === 'function') atualizarUndoBtn();
        window.__fkSetDirty(true);
        setEditStatus('Novo teste ' + nome + ' (' + eng.toUpperCase() + ') — clica 💾 para criar', 'warn');
      });
    }

    // ── Templates ──
    function __fkTemplate(nomeClasse, engine) {
      if (engine === 'pest') {
        return "<?php\n\n" +
          "declare(strict_types=1);\n\n" +
          "// Teste: " + nomeClasse + "\n\n" +
          "it('exemplo funciona', function () {\n" +
          "    expect(true)->toBeTrue();\n" +
          "});\n";
      }
      return "<?php\n\n" +
        "declare(strict_types=1);\n\n" +
        "namespace Tests\\Unit;\n\n" +
        "use Tests\\TestCase;\n\n" +
        "class " + nomeClasse + " extends TestCase\n" +
        "{\n" +
        "    public function test_exemplo_funciona(): void\n" +
        "    {\n" +
        "        $this->assertTrue(true);\n" +
        "    }\n" +
        "}\n";
    }


    // Undo da conversão
    if ($btnUndo) {
      $btnUndo.addEventListener('click', function () {
        if (!state.editorConverted) return;

        // 1. Se temos conteúdo original em memória → usar
        if (state.editorOriginalContent) {
          if (typeof window.__fkTrialSetEditorCode === 'function') {
            window.__fkTrialSetEditorCode(state.editorOriginalContent);
          }
          state.editorEngine = state.editorOriginalEngine || 'pest';
          state.editorDetectedEngine = state.editorEngine;
          if ($engineSel) $engineSel.value = state.editorEngine;
          state.editorConverted = false;
          atualizarUndoBtn();
          setEditStatus('Conversão desfeita · ' + state.editorEngine.toUpperCase(), 'ok');
          return;
        }

        // 2. Fallback: buscar ao backend
        setEditStatus('A restaurar backup...', 'run');
        fetch('/api/frankei-trial/tests/undo-conversion', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ class: state.editorClassname, prefer_engine: state.editorOriginalEngine || '' })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) {
            setEditStatus('✗ ' + (d.error || 'Sem backup'), 'err');
            return;
          }
          if (typeof window.__fkTrialSetEditorCode === 'function') {
            window.__fkTrialSetEditorCode(d.code);
          }
          state.editorEngine = d.engine || 'pest';
          state.editorDetectedEngine = state.editorEngine;
          if ($engineSel) $engineSel.value = state.editorEngine;
          state.editorConverted = false;
          atualizarUndoBtn();
          setEditStatus('Backup restaurado · ' + state.editorEngine.toUpperCase(), 'ok');
        })
        .catch(function (e) {
          setEditStatus('✗ ' + e.message, 'err');
        });
      });
    }

    // Undo da conversão
    if ($btnUndo) {
      $btnUndo.addEventListener('click', function () {
        if (!state.editorConverted) return;

        // 1. Se temos conteúdo original em memória → usar
        if (state.editorOriginalContent) {
          if (typeof window.__fkTrialSetEditorCode === 'function') {
            window.__fkTrialSetEditorCode(state.editorOriginalContent);
          }
          state.editorEngine = state.editorOriginalEngine || 'pest';
          state.editorDetectedEngine = state.editorEngine;
          if ($engineSel) $engineSel.value = state.editorEngine;
          state.editorConverted = false;
          atualizarUndoBtn();
          setEditStatus('Conversão desfeita · ' + state.editorEngine.toUpperCase(), 'ok');
          return;
        }

        // 2. Fallback: buscar ao backend
        setEditStatus('A restaurar backup...', 'run');
        fetch('/api/frankei-trial/tests/undo-conversion', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ class: state.editorClassname, prefer_engine: state.editorOriginalEngine || '' })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) {
            setEditStatus('✗ ' + (d.error || 'Sem backup'), 'err');
            return;
          }
          if (typeof window.__fkTrialSetEditorCode === 'function') {
            window.__fkTrialSetEditorCode(d.code);
          }
          state.editorEngine = d.engine || 'pest';
          state.editorDetectedEngine = state.editorEngine;
          if ($engineSel) $engineSel.value = state.editorEngine;
          state.editorConverted = false;
          atualizarUndoBtn();
          setEditStatus('Backup restaurado · ' + state.editorEngine.toUpperCase(), 'ok');
        })
        .catch(function (e) {
          setEditStatus('✗ ' + e.message, 'err');
        });
      });
    }

    // Engine selector
    if ($engineSel) {
      $engineSel.addEventListener('change', function () {
        verificarEngineEscolhido(this.value);
      });
    }

    document.addEventListener('keydown', function escH(e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        fechar();
        document.removeEventListener('keydown', escH);
      }
    });

    modal.addEventListener('click', function backH(e) {
      if (e.target === modal) {
        fechar();
        modal.removeEventListener('click', backH);
      }
    });

    carregar();

    window.__fkTrialReloadEditor = carregar;
    // FK_SCOPE_FIX — expor helpers do closure para uso externo
    setTimeout(function () {
      if (typeof setEditStatus === 'function') window.__fkSetEditStatus = setEditStatus;
      if (typeof atualizarUndoBtn === 'function') window.__fkAtualizarUndoBtn = atualizarUndoBtn;
      console.log('[fk-scope] setEditStatus:', typeof window.__fkSetEditStatus, '| atualizarUndoBtn:', typeof window.__fkAtualizarUndoBtn);
    }, 0);

    window.__fkTrialSetEditorCode = function (novoCode) {
      if (!codeArea) {
        // Fallback: tentar query directa (editor pode estar noutro scope)
        codeArea = document.querySelector('.fk-edit-code');
      }
      if (!codeArea) {
        console.warn('[fk-editor] textarea não encontrada');
        return;
      }
      codeArea.value = novoCode;

      // FK_AI_SYNC_HIGHLIGHT — sincronizar highlight overlay + reset scroll
      try {
        codeArea.dispatchEvent(new Event('input', { bubbles: true }));
        codeArea.dispatchEvent(new Event('change', { bubbles: true }));
      } catch (e) { /* silencioso */ }

      // Reset de scroll para o topo (utilizador vê o comentário gerado)
      try {
        codeArea.scrollTop = 0;
        var _hl = document.querySelector('.fk-hl-pre');
        if (_hl) _hl.scrollTop = 0;
        var _gutter = document.querySelector('.fk-ln-gutter');
        if (_gutter) _gutter.scrollTop = 0;
      } catch (e) { /* silencioso */ }

      currentContent = novoCode;
      isDirty = false;
      marcarDirty();
      window.__fkSetDirty(true);
      console.log('[fk-editor] código atualizado · Gravar ativo');
    };
  }

  function renderList(data) {
    state.plan     = data.plan;
    state.total    = data.total;
    state.shown    = data.shown;
    state.limit    = data.limit;
    state.tests    = data.tests || [];
    state.suites   = data.suites || ['Unit'];
    state.porSuite = data.por_suite || {};

    // Popular suite selector
    if ($suiteSel && $suiteSel.options.length <= 1) {
      $suiteSel.innerHTML = '<option value="all">' + esc(t('Todas')) + '</option>';
      state.suites.forEach(function (s) {
        var opt = document.createElement('option');
        opt.value = s;
        var count = state.porSuite[s] || 0;
        opt.textContent = s + ' (' + count + ')';
        $suiteSel.appendChild(opt);
      });
    }

    // Ball
    if ($ballNum)  $ballNum.textContent = state.total;
    if ($ballHint) {
      $ballHint.textContent = state.limit === null
        ? t('Testes disponíveis')
        : t('Testes disponíveis') + ' / máx ' + state.limit;
    }

    if ($counter) {
      $counter.textContent = state.limit === null
        ? state.total + ' ' + t('testes')
        : state.total + ' ' + t('testes') + ' · máx ' + state.limit;
    }

    if ($cardCounter) {
      $cardCounter.textContent = state.shown + ' / ' + state.total;
    }

    renderSuitesBar();

    if (!$list) return;

    if (state.tests.length === 0) {
      $list.innerHTML = '<div class="fk-trial-empty">' +
        '<div class="fk-trial-empty-icon">🧪</div>' +
        '<p>' + esc(t('Sem testes Unit.')) + '</p>' +
      '</div>';
      return;
    }

    $list.innerHTML = '<div class="fk-trial-test-list">' +
      state.tests.map(function (t) {
        var kb = Math.round((t.size || 0) / 1024 * 10) / 10;
        var suiteTag = '<span style="font-size:9.5px;font-weight:800;letter-spacing:.06em;padding:2px 6px;border-radius:4px;background:#e0f2fe;color:#0369a1;margin-right:6px">' +
          esc(t.suite || 'Unit') + '</span>';
        return '<div class="fk-trial-test">' +
          '<div>' +
            '<div class="fk-trial-test-name">' + suiteTag + esc(t.name) + '</div>' +
            '<div class="fk-trial-test-meta">' + kb + ' KB</div>' +
          '</div>' +
          '<div class="fk-trial-test-check">✓</div>' +
        '</div>';
      }).join('') +
    '</div>';
  }

  function loadList() {
    if (!$list) return;
    setStatus(t('A carregar testes...'), '');
    $list.innerHTML = '<div class="fk-trial-empty">' +
      '<span class="fk-trial-spinner"></span> ' + esc(t('A carregar testes...')) +
    '</div>';

    fetch('/api/frankei-trial/tests/list', { credentials: 'include' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.ok) {
          $list.innerHTML = '<div class="fk-trial-empty" style="color:#b91c1c">' +
            esc(d.error || 'Erro') + '</div>';
          return;
        }
        renderList(d);
        setStatus('✓ ' + d.total + ' ' + t('testes') + ' prontos', 'ok');
      })
      .catch(function (e) {
        $list.innerHTML = '<div class="fk-trial-empty" style="color:#b91c1c">' +
          'Erro: ' + esc(e.message) + '</div>';
        setStatus('✗ Erro', 'err');
      });
  }

  function runTests() {
    if (state.running) return;
    setRunning(true);

    state.engine = $engineSel ? $engineSel.value : 'pest';
    state.suite  = $suiteSel  ? $suiteSel.value  : 'all';

    if ($terminal) {
      $terminal.textContent = '→ beaver test --engine=' + state.engine +
        (state.suite !== 'all' ? ' --testsuite=' + state.suite : '') + '\n\n';
    }

    fetch('/api/frankei-trial/tests/run', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ suite: state.suite, engine: state.engine })
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        // Atualizar status no header
        setStatus(
          (d.ok ? '✓ Sucesso' : '✗ Falha') + ' · ' + d.elapsed_ms + 'ms',
          d.ok ? 'ok' : 'err'
        );

        if (!$terminal) return;
        var head = '═══ ' + (d.ok ? '✓ Sucesso' : '✗ Falha') + ' ═══\n' +
                   'Suite:  ' + (d.suite || 'all') + '  |  Engine: ' + (d.engine || '?') + '\n' +
                   'Tempo:  ' + d.elapsed_ms + 'ms  |  Exit: ' + d.exit_code + '\n' +
                   (d.truncated ? 'Output truncado\n' : '') +
                   '─────────────────────────────\n\n';
        $terminal.textContent = head + (d.lines || []).join('\n');
        renderRunSummary(d);
      })
      .catch(function (e) {
        setStatus('✗ Erro', 'err');
        if ($terminal) $terminal.textContent = '✗ Erro: ' + (e.message || e) + '\n';
      })
      .finally(function () { setRunning(false); });
  }





  function abrirReportModal() {
    // O modal é gerido pelo frankei (dashboard.js → reportInit())
    // Basta chamar o botão oculto que ele escuta
    var hidden = document.getElementById('fkTermReportBtn');
    if (!hidden) {
      setStatus('✗ Modal indisponível', 'err');
      return;
    }
    hidden.click();
    setStatus('📊 Report aberto', '');
  }

  if ($btnReport) $btnReport.addEventListener('click', abrirReportModal);

  /* FK_ANALYZE_HANDLER — botão "🔍 Analisar em detalhe" abre o Modal A */
  if ($btnAnalyze) {
    $btnAnalyze.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();

      // O dashboard.js do frankei ligou um handler em #fkTermReportBtn (invisível)
      // Clicar nele dispara o reportInit() que abre o #fkReportModal
      var hidden = document.getElementById('fkTermReportBtn');
      if (!hidden) {
        setStatus('✗ Modal indisponível', 'err');
        return;
      }

      hidden.click();

      // Pequeno delay para o modal abrir, depois ir para tab "Resumo"
      setTimeout(function () {
        var tabResumo = document.querySelector('#fkReportTabs [data-view="summary"]');
        if (tabResumo) tabResumo.click();
      }, 150);
    });
  }

  if ($btnRun) $btnRun.addEventListener('click', runTests);

  // Re-render ao mudar idioma
  window.addEventListener('frankei:lang', function () {
    renderList({
      plan: state.plan, total: state.total, shown: state.shown,
      limit: state.limit, tests: state.tests, suites: state.suites,
      por_suite: state.porSuite,
    });
  });

  // FK_SINGLE_BOOT: chamar loadList + loadClasses UMA só vez
  function bootOnce() {
    loadList();
    loadClasses(1);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootOnce);
  } else {
    bootOnce();
  }
})();

/* ══════════════════════════════════════════════════════════════
   FK_ENGINE_FILTER_V1
   Filtro por motor (Pest / PHPUnit) na tabela "Resultado por classe".
   Bloco AUTO-CONTIDO. Não altera código existente.
   Se falhar, basta remover daqui para baixo.
   ══════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var engineMap = null;
  var filtroAtual = 'all';

  function carregarEngines() {
    return fetch('/api/frankei-trial/tests/engines', { credentials: 'include' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        engineMap = (d && d.ok && d.engines) ? d.engines : {};
        console.log('[fk-engine] mapa carregado:', Object.keys(engineMap).length, 'classes');
        return engineMap;
      })
      .catch(function (e) {
        console.warn('[fk-engine] falha a carregar:', e);
        engineMap = {};
      });
  }

  function engineFor(classname) {
    if (!engineMap || !classname) return null;
    if (engineMap[classname]) return engineMap[classname];
    var short = classname.split('\\').pop();
    if (engineMap[short]) return engineMap[short];
    return null;
  }

  function badgeHtml(engine) {
    if (!engine) return '<span class="fk-engine-badge fk-engine-unknown">?</span>';
    var cls   = engine === 'pest' ? 'fk-engine-pest' : 'fk-engine-phpunit';
    var label = engine === 'pest' ? '🐀 Pest' : '🐘 PHPUnit';
    return '<span class="fk-engine-badge ' + cls + '">' + label + '</span>';
  }

  function aplicarFiltro() {
    var card = document.getElementById('fkTrialClassesCard');
    if (!card) return;
    var rows = card.querySelectorAll('#fkTrialClassesList tbody tr');
    for (var i = 0; i < rows.length; i++) {
      var r  = rows[i];
      var cn = r.getAttribute('data-classname') || '';
      var eng = engineFor(cn);
      var mostrar = (filtroAtual === 'all' || filtroAtual === eng);
      if (mostrar) {
        r.classList.remove('fk-engine-hidden');
      } else {
        r.classList.add('fk-engine-hidden');
      }
    }
  }

  function adicionarColuna() {
    var card = document.getElementById('fkTrialClassesCard');
    if (!card) return;
    var table = card.querySelector('#fkTrialClassesList table');
    if (!table) return;
    var thead = table.querySelector('thead tr');
    var tbody = table.querySelector('tbody');
    if (!thead || !tbody) return;

    if (!thead.querySelector('.fk-engine-th')) {
      var th = document.createElement('th');
      th.className = 'fk-engine-th';
      th.textContent = 'Motor';
      th.style.cssText = 'padding:12px 14px;text-align:center;width:110px';
      if (thead.children.length >= 2) {
        thead.insertBefore(th, thead.children[2]);
      } else {
        thead.appendChild(th);
      }
    }

    var rows = tbody.querySelectorAll('tr');
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (r.querySelector('.fk-engine-cell')) continue;
      var cn  = r.getAttribute('data-classname') || '';
      var eng = engineFor(cn);
      var td  = document.createElement('td');
      td.className = 'fk-engine-cell';
      td.style.cssText = 'padding:12px 14px;text-align:center';
      td.innerHTML = badgeHtml(eng);
      if (r.children.length >= 2) {
        r.insertBefore(td, r.children[2]);
      } else {
        r.appendChild(td);
      }
    }
  }

  function adicionarFiltro() {
    var card = document.getElementById('fkTrialClassesCard');
    if (!card) return;
    if (card.querySelector('.fk-engine-filter')) return;
    var h2 = card.querySelector('h2');
    if (!h2) return;

    var wrap = document.createElement('div');
    wrap.className = 'fk-engine-filter';
    wrap.innerHTML = ''
      + '<label>Motor:</label>'
      + '<select class="fk-engine-select">'
      +   '<option value="all">Todos</option>'
      +   '<option value="pest">🐀 Pest</option>'
      +   '<option value="phpunit">🐘 PHPUnit</option>'
      + '</select>'
      + '<button type="button" class="fk-engine-refresh" title="Recarregar mapa de motores">↻</button>';

    var counter = h2.querySelector('.fk-trial-card-counter');
    if (counter) {
      h2.insertBefore(wrap, counter);
    } else {
      h2.appendChild(wrap);
    }

    wrap.querySelector('.fk-engine-select').addEventListener('change', function (e) {
      filtroAtual = e.target.value;
      aplicarFiltro();
    });

    wrap.querySelector('.fk-engine-refresh').addEventListener('click', function () {
      carregarEngines().then(function () {
        var card2 = document.getElementById('fkTrialClassesCard');
        if (card2) {
          var els = card2.querySelectorAll('.fk-engine-cell, .fk-engine-th');
          for (var k = 0; k < els.length; k++) els[k].remove();
        }
        adicionarColuna();
        aplicarFiltro();
      });
    });
  }

  function enhance() {
    var card = document.getElementById('fkTrialClassesCard');
    if (!card) return;
    if (!card.querySelector('#fkTrialClassesList tbody tr')) return;
    adicionarColuna();
    adicionarFiltro();
    aplicarFiltro();
  }

  function iniciar() {
    var card = document.getElementById('fkTrialClassesCard');
    if (!card) {
      var tent = 0;
      var iv = setInterval(function () {
        tent++;
        if (document.getElementById('fkTrialClassesCard')) {
          clearInterval(iv);
          iniciar();
        } else if (tent > 60) {
          clearInterval(iv);
        }
      }, 250);
      return;
    }

    carregarEngines().then(function () {
      enhance();
      try {
        var obs = new MutationObserver(function () { enhance(); });
        obs.observe(card, { childList: true, subtree: true });
      } catch (e) {
        console.warn('[fk-engine] MutationObserver falhou:', e);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
})();

