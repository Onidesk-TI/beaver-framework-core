  /* ── 3. HELPERS ── */
  function engineAtual() {
    // Detecção pelo conteúdo do editor — fiável, sempre disponível
    if (taBound && taBound.value) {
      var code = taBound.value;
      if (/\bit\s*\(/.test(code) ||
          /\btest\s*\(/.test(code) ||
          /use\s+function\s+Pest/i.test(code) ||
          /\buses\s*\(/.test(code)) {
        return 'pest';
      }
      if (/extends\s+[\w\\]*TestCase/i.test(code) ||
          /public\s+function\s+test[A-Z_]/i.test(code) ||
          /\$this->assert[A-Z]/.test(code)) {
        return 'phpunit';
      }
    }
    return 'pest';
  }

  function ctxAt(code, pos) {
    // Conta { } antes do cursor
    var depth = 0, inStr = false, strCh = '';
    for (var i = 0; i < pos; i++) {
      var ch = code[i];
      if (inStr) {
        if (ch === strCh && code[i-1] !== '\\') inStr = false;
        continue;
      }
      if (ch === '"' || ch === "'") { inStr = true; strCh = ch; continue; }
      if (ch === '{') depth++;
      else if (ch === '}') depth = Math.max(0, depth - 1);
    }
    var eng = (typeof engineAtual === 'function') ? engineAtual() : 'pest';
    if (eng === 'pest') {
      // Em Pest: depth 0 = topo do ficheiro, depth 1 = dentro de it()/test()
      return depth === 0 ? 'top' : 'method';
    }
    // PHPUnit: depth 0 = topo, depth 1 = classe, depth 2+ = método
    if (depth === 0) return 'top';
    if (depth === 1) return 'class';
    return 'method';
  }

  function palavraAntes(code, pos) {
    var i = pos;
    while (i > 0 && /[A-Za-z0-9_$>:\-]/.test(code[i-1])) i--;
    return code.substring(i, pos);
  }

  // FK_STRIP_PREFIX — remove $this-> / static:: / self:: / $var-> antes de filtrar
  function normalizarWord(w) {
    if (!w) return '';
    var stripped = w.replace(/^(\$this|static|self|parent|\$[A-Za-z_][A-Za-z0-9_]*)(->|::)/i, '');
    return stripped;
  }

  function filtrarSnippets() {
    var codigo = (taBound && taBound.value) || '';
    var eng = engineAtual();
    var ctx = ctxAt(taBound.value, taBound.selectionStart);
    var wRaw = word;
    var wNorm = normalizarWord(wRaw);
    var w = /(->|::)$/.test(wRaw) && wNorm === '' ? '' : wNorm.toLowerCase();
    var out = [];

    for (var i = 0; i < SNIPPETS.length; i++) {
      var s = SNIPPETS[i];
      if (!s) continue;
      if (s.engines.indexOf(eng) === -1) continue;

      // FK_CTX_LENIENT — compatibilidade de contexto
      var ctxOk = false;
      if (s.ctx === ctx) ctxOk = true;
      else if (s.ctx === 'class'  && ctx === 'method') ctxOk = true;
      else if (s.ctx === 'method' && ctx === 'class')  ctxOk = true;
      // FK_PEST_LENIENT — em Pest, method e top são quase equivalentes
      else if (eng === 'pest' && (s.ctx === 'method' || s.ctx === 'top')) ctxOk = true;
      if (!ctxOk) continue;

      // Filtro por texto
      if (w) {
        var trig = s.trigger.toLowerCase();
        var starts   = trig.indexOf(w) === 0;
        var contains = trig.indexOf(w) > 0;
        var descOK   = (s.desc || '').toLowerCase().indexOf(w) > -1;
        var alsoOK   = false;
        if (s.alsoMatch) {
          for (var k = 0; k < s.alsoMatch.length; k++) {
            if (s.alsoMatch[k].toLowerCase() === w) { alsoOK = true; break; }
