            'protected','public','readonly','require','require_once','return','static','switch','throw',
            'trait','try','unset','use','var','while','xor','yield','true','false','null','void',
            'int','string','bool','float','object','mixed','self','parent','this'];
  t = t.replace(new RegExp('\\b(' + KW.join('|') + ')\\b', 'g'), function (m) {
    return putT('<span class="fk-hl-kw">' + m + '</span>');
  });

  t = t.replace(/\b\d+(?:\.\d+)?\b/g, function (m) {
    return putT('<span class="fk-hl-num">' + m + '</span>');
