          primeiroInicio = out.length;
          primeiroTexto = texto;
          primeiroFim = out.length + texto.length;
        }
        out += texto;
        phCount++;
        i += m[0].length;
      } else {
        out += insert[i];
        i++;
      }
    }

    ta.value = antes + out + depois;
    var novoPos = antes.length + (primeiroInicio >= 0 ? primeiroInicio : out.length);
    var fimSel = antes.length + (primeiroFim >= 0 ? primeiroFim : out.length);
    ta.selectionStart = novoPos;
    ta.selectionEnd = fimSel;
    ta.focus();

