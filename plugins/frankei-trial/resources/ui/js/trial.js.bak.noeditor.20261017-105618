  t = t.replace(new RegExp(P + 'T(\\d+)' + P, 'g'), function (m, i) {
    return T[parseInt(i, 10) - 1] || '';
  });
  t = t.replace(new RegExp(P + 'S(\\d+)' + P, 'g'), function (m, i) {
    return S[parseInt(i, 10) - 1] || '';
  });

