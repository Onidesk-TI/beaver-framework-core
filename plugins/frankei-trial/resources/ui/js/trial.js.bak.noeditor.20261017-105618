  // Tentar extrair a classe alvo (ex: AuthController)
  var alvo = 'Alvo';
  var m = code.match(/class\s+([A-Z]\w+)Test\b/) || code.match(/['"]([A-Z]\w+)['"]/) || code.match(/use\s+App\\[\\\w]+\\([A-Z]\w+)/);
  if (m && m[1]) alvo = m[1];
  alvo = alvo.replace(/Test$/, '');

  var header = '// ⚠️ DEMO (sem chamar a API) — substitui por geração real quando tiveres créditos\n'
             + '// Classe alvo detectada: ' + alvo + '\n'
             + '// Motor detectado: ' + engine.toUpperCase() + '\n\n';

  if (engine === 'pest') {
    return '<?php\n\n' + header
      + 'declare(strict_types=1);\n\n'
      + 'use Tests\\TestCase;\n'
      + 'use App\\Controllers\\' + alvo + ';\n\n'
      + 'uses(TestCase::class);\n\n'
      + 'it(\'responde com sucesso no caso base\', function () {\n'
      + '    // Arrange\n'
      + '    $controller = new ' + alvo + '();\n\n'
      + '    // Act\n'
      + '    $resultado = $controller->handle();\n\n'
      + '    // Assert\n'
      + '    expect($resultado)->not->toBeNull();\n'
      + '});\n\n'
      + 'it(\'lida com erro esperado\', function () {\n'
      + '    $controller = new ' + alvo + '();\n\n'
      + '    expect(fn() => $controller->handle(null))\n'
      + '        ->toThrow(InvalidArgumentException::class);\n'
      + '});\n';
  }

  // PHPUnit
  return '<?php\n\n' + header
    + 'declare(strict_types=1);\n\n'
    + 'namespace Tests\\Unit;\n\n'
    + 'use Tests\\TestCase;\n'
    + 'use App\\Controllers\\' + alvo + ';\n\n'
    + 'class ' + alvo + 'Test extends TestCase\n'
    + '{\n'
    + '    private ' + alvo + ' $obj;\n\n'
    + '    protected function setUp(): void\n'
    + '    {\n'
    + '        parent::setUp();\n'
    + '        $this->obj = new ' + alvo + '();\n'
    + '    }\n\n'
    + '    public function test_responde_caso_base(): void\n'
    + '    {\n'
    + '        // Act\n'
    + '        $resultado = $this->obj->handle();\n\n'
    + '        // Assert\n'
    + '        $this->assertNotNull($resultado);\n'
    + '    }\n\n'
    + '    public function test_lida_com_erro_esperado(): void\n'
    + '    {\n'
    + '        $this->expectException(InvalidArgumentException::class);\n\n'
    + '        $this->obj->handle(null);\n'
    + '    }\n'
    + '}\n';
}

/* ══════════════════════════════════════════════════════════════
   FK_SUGGEST_BTN_V1
   Botão "✨ Sugerir teste" na barra de abas.
   Lê o editor → envia ao DeepSeek → aplica o resultado no editor.
   ══════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  var bound = false;
  var loading = false;

  function esc(s) {
    return String(s).replace(/[&<>]/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;' }[c];
    });
  }

  function getEditor() {
    return document.querySelector('.fk-edit-code');
  }

  function detectarEngine(codigo) {
    // Prioridade 1: marcadores fortes de Pest
    if (/\bit\s*\(\s*['"]/.test(codigo)) return 'pest';           // it('nome', ...)
    if (/\btest\s*\(\s*['"]/.test(codigo)) return 'pest';         // test('nome', ...)
    if (/\buses\s*\(/.test(codigo)) return 'pest';                  // uses(TestCase::class)
    if (/use\s+function\s+Pest/i.test(codigo)) return 'pest';       // use function Pest\...
    if (/\bexpect\s*\(/.test(codigo)) return 'pest';               // expect(...)

    // Prioridade 2: marcadores fortes de PHPUnit
    if (/extends\s+[\w\\]*TestCase/i.test(codigo)) return 'phpunit';
    if (/class\s+\w+Test\s+extends/i.test(codigo)) return 'phpunit';
    if (/\$this->assert[A-Z]/.test(codigo)) return 'phpunit';
    if (/public\s+function\s+test[A-Z_]/.test(codigo)) return 'phpunit';
    if (/use\s+PHPUnit\\Framework\\TestCase/.test(codigo)) return 'phpunit';
    if (/namespace\s+Tests\\/.test(codigo)) return 'phpunit';

    return 'phpunit';   // default
  }

  function estadoBotao(btn, txt, tipo) {
    if (!btn) return;
    btn.classList.remove('is-loading', 'is-ok', 'is-err');
    if (tipo) btn.classList.add('is-' + tipo);
    btn.innerHTML = txt;
  }

  function sugerir(btn) {
    if (loading) return;

    // FK_LLM_REGEN_GUARD — avisa se ja gerou para a mesma classe
    var _skipGenerate = false;
    (function(){
      var _inp = document.getElementById('fkTcClassInput');
      var _cur = _inp ? (_inp.value || '').trim() : '';
      if (!_cur) return;
      if (window.__fkLlmOutput && window.__fkLlmOutputClass === _cur) {
        var _short = _cur.split('\\').pop();
        if (!confirm('Ja geraste para ' + _short + '. Gerar de novo?')) {
          _skipGenerate = true;
        }
      }
    })();
    if (_skipGenerate) return;

    // Verificar motor do editor actual
    var taCheck = document.querySelector('.fk-edit-code');
    var motorDetectado = taCheck ? detectarEngine(taCheck.value || '') : 'phpunit';
    console.log('[fk-suggest] motor detectado:', motorDetectado, '| editor tem', taCheck ? taCheck.value.length : 0, 'chars');

    // ── MODO DEMO: gera exemplo do editor, sem chamar a API ──
    if (window.__fkSuggestDemo === true) {
      console.log('[fk-suggest] MODO DEMO — gera exemplo local (sem custo)');
      estadoBotao(btn, '<span class="fk-sg-spin"></span> A gerar demo…', 'loading');

      var codigoDemo = __fkSuggestDemoGenerate();

      // Silenciar autocomplete durante a aplicação
      window.__fkSuppressAutocomplete = true;

      setTimeout(function () {
        var aplicado = false;
        if (typeof window.__fkTrialSetEditorCode === 'function') {
          try {
            window.__fkTrialSetEditorCode(codigoDemo);
            aplicado = true;
          } catch (e) {
            console.warn('[fk-suggest] falha:', e);
          }
        }
        if (!aplicado) {
          var ta2 = document.querySelector('.fk-edit-code');
          if (ta2) {
            ta2.value = codigoDemo;
            ta2.setSelectionRange(codigoDemo.length, codigoDemo.length);
            aplicado = true;
          }
        }

        // Re-activar autocomplete 200ms depois
        setTimeout(function () { window.__fkSuppressAutocomplete = false; }, 200);

        estadoBotao(btn, aplicado ? '✓ Demo aplicada' : '✗ Sem editor', aplicado ? 'ok' : 'err');
        setTimeout(function () { estadoBotao(btn, '✨ Gerar sugestão de teste'); }, 3000);
      }, 300);
      return;
    }

    // ── MODO REAL: chamada ao DeepSeek ──
    var ta = getEditor();
    if (!ta) {
      estadoBotao(btn, '✗ Sem editor', 'err');
      setTimeout(function () { estadoBotao(btn, '✨ Gerar sugestão de teste'); }, 2000);
      return;
    }

    var code = (ta.value || '').trim();
    if (!code) {
      estadoBotao(btn, '✗ Editor vazio', 'err');
      setTimeout(function () { estadoBotao(btn, '✨ Gerar sugestão de teste'); }, 2000);
      return;
    }

    var engine = detectarEngine(code);
    loading = true;
    estadoBotao(btn, '<span class="fk-sg-spin"></span> A gerar…', 'loading');

    // FK_PROGRESS_TOAST_INTEGRATION — toast de progresso
    var pt = (window.FKProgress && typeof window.FKProgress.show === 'function')
      ? window.FKProgress.show('qwen (Ollama)')
      : null;
    function ptStep(i, s) { if (pt && pt.step) pt.step(i, s); }
    if (pt) { ptStep(0, 'done'); ptStep(1, 'active'); }

    // Guardar estado anterior para undo manual se necessário
    var codeAntes = code;
    window.__fkSuggestPrevious = codeAntes;

    fetch('/api/frankei-trial/ai/generate-test', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        code: code,
        engine: engine,
        target: (function(){
          // tentar extrair nome da classe alvo
          var m = code.match(/class\s+([A-Z]\w+)Test\b/) || code.match(/use\s+App\\[\\\w]+\\([A-Z]\w+)/);
          return m ? m[1] : '';
        })(),
        hints: 'Gera um ficheiro de teste completo em ' + engine.toUpperCase() + ' (namespace Tests\\Unit, use Tests\\TestCase). NUNCA uses markTestIncomplete.',
      }),
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      loading = false;
      if (pt) { ptStep(1, 'done'); ptStep(2, 'done'); ptStep(3, 'active'); }

      if (!d || !d.ok) {
        var msg = (d && d.error) ? d.error : 'Erro desconhecido';
        if (msg.indexOf('DEEPSEEK_API_KEY') > -1) {
          msg = 'Chave DeepSeek não configurada';
        }
        if (pt && pt.fail) pt.fail(msg.substring(0, 30));
        estadoBotao(btn, '✗ ' + msg.substring(0, 40), 'err');
        setTimeout(function () { estadoBotao(btn, '✨ Gerar sugestão de teste'); }, 3500);
        return;
      }

      var novoCodigo = d.code || '';
      if (!novoCodigo) {
        if (pt && pt.fail) pt.fail('resposta vazia');
        estadoBotao(btn, '✗ Resposta vazia', 'err');
        setTimeout(function () { estadoBotao(btn, '✨ Gerar sugestão de teste'); }, 2500);
        return;
      }

      // FK_AI_COMMENT — cabeçalho com motor + timestamp
      (function(){
        var _agora = new Date();
        var _pad = function(n){ return n < 10 ? '0' + n : '' + n; };
        var _ts = _agora.getFullYear() + '-' + _pad(_agora.getMonth() + 1) + '-' + _pad(_agora.getDate())
                + ' ' + _pad(_agora.getHours()) + ':' + _pad(_agora.getMinutes()) + ':' + _pad(_agora.getSeconds());
        var _modelo = (d.model || 'ia');
        var _linha = '// ✨ Gerado por ' + _modelo + ' (' + engine + ') · ' + _ts;
        if (/^<\?php\s*\n?/.test(novoCodigo)) {
          novoCodigo = novoCodigo.replace(/^<\?php\s*\n?/, '<?php\n' + _linha + '\n');
        } else {
          novoCodigo = _linha + '\n' + novoCodigo;
        }
      })();

      // Aplicar no editor
      if (typeof window.__fkTrialSetEditorCode === 'function') {
        window.__fkTrialSetEditorCode(novoCodigo);
      } else if (ta) {
        ta.value = novoCodigo;
        ta.dispatchEvent(new Event('input', { bubbles: true }));
      }

      // FK_PROGRESS_TOAST_INTEGRATION — fecha toast com sucesso
      if (pt) {
        ptStep(3, 'done');
        ptStep(4, 'done');
        if (pt.done) pt.done();
      }

      // Feedback com tokens / cache
      var info = '✓ Sugerido';
      if (d.from_cache) {
        var _age = (typeof d.cached_age === 'number' && d.cached_age > 0)
          ? Math.round(d.cached_age / 60)
          : 0;
        info = _age > 0 ? ('✓ Cache (' + _age + 'min)') : '✓ Cache';
      } else if (d.usage && d.usage.total_tokens) {
        info = '✓ ' + d.usage.total_tokens + ' tokens';
      }
      estadoBotao(btn, info, 'ok');
      setTimeout(function () { estadoBotao(btn, '✨ Gerar sugestão de teste'); }, 4000);

      // FK_LLM_PENDING — guardar output do LLM + mostrar botao Gravar LLM
      window.__fkLlmLastSaved = null;
      window.__fkLlmOutput = novoCodigo;
      (function(){
        var _inp = document.getElementById('fkTcClassInput');
        window.__fkLlmOutputClass = _inp ? (_inp.value || '').trim() : '';
      })();
      var _btnLlm  = document.getElementById('fkEditSaveLlm');
      var _hintLlm = document.getElementById('fkLlmHint');
      if (_btnLlm)  { _btnLlm.style.display = ''; _btnLlm.style.animation = ''; _btnLlm.disabled = false; }
      if (_hintLlm) { _hintLlm.style.display = ''; }
      var _btnCmp = document.getElementById('fkEditCompare');
      if (_btnCmp) { _btnCmp.hidden = false; _btnCmp.style.display = 'inline-flex'; _btnCmp.disabled = false; }

      console.log('[fk-suggest]', {
        engine: engine,
        model: d.model,
        tokens: d.usage,
        code_chars: novoCodigo.length,
      });
    })
    .catch(function (e) {
      loading = false;
      if (pt && pt.fail) pt.fail((e.message || 'falha').substring(0, 30));
      estadoBotao(btn, '✗ ' + (e.message || 'Falha').substring(0, 40), 'err');
      setTimeout(function () { estadoBotao(btn, '✨ Gerar sugestão de teste'); }, 3500);
    });
  }

  // ── Setup ──
  function setup() {
    if (bound) return true;

    var wrap = document.querySelector('.fk-edit-wrap');
    if (!wrap) return false;

    if (wrap.querySelector('.fk-sg-btn')) { bound = true; return true; }

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'fk-sg-btn';
    btn.title = 'Pedir à IA uma sugestão de teste completa';
    btn.innerHTML = '✨ Gerar sugestão de teste';
    btn.addEventListener('click', function () { sugerir(btn); });

    wrap.appendChild(btn);

    bound = true;
    window.__fkSuggestDemo = false;  // ← MODO DEMO activo (não chama API)
    console.log('[fk-sg] botão "Sugerir teste" pronto');
    return true;
  }

  function iniciar() {
    if (setup()) return;
    var tent = 0;
    var iv = setInterval(function () {
      tent++;
      if (setup() || tent > 100) clearInterval(iv);
    }, 250);
    try {
      var obs = new MutationObserver(function () { setup(); });
      obs.observe(document.body, { childList: true, subtree: true });
    } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
})();

/* ══════════════════════════════════════════════════════════════
   FK_PROGRESS_TOAST — gestor do toast de progresso (canto inf. dir.)
   Expõe: window.FKProgress = { show, step, done, fail, hide }
   ══════════════════════════════════════════════════════════════ */
(function () {
  if (window.FKProgress) return;

  var el = null, t0 = 0, timerBar = null, timerClock = null, pct = 0;
  var STEPS = [
    'A preparar o prompt',
    'A enviar para o modelo',
    'A aguardar resposta (Ollama)',
    'A processar resposta',
    'A aplicar no editor',
  ];

  function fmt(ms) {
    var s = Math.floor(ms / 1000);
    return s + '.' + Math.floor((ms % 1000) / 100) + 's';
  }

  function build() {
    el = document.createElement('div');
    el.className = 'fk-pt';
    el.innerHTML =
      '<div class="fk-pt-head">' +
        '<div class="fk-pt-title"><span class="fk-pt-spark">✨</span> A gerar sugestão de teste</div>' +
        '<button type="button" class="fk-pt-close" title="Fechar">✕</button>' +
      '</div>' +
      '<div class="fk-pt-bar-wrap"><div class="fk-pt-bar"></div></div>' +
      '<div class="fk-pt-steps"></div>' +
      '<div class="fk-pt-foot">' +
        '<span class="fk-pt-model">—</span>' +
        '<span class="fk-pt-time">0.0s</span>' +
      '</div>';

    el.querySelector('.fk-pt-steps').innerHTML = STEPS.map(function (s, i) {
      return '<div class="fk-pt-step" data-i="' + i + '">' +
               '<span class="fk-pt-ico">○</span>' +
               '<span>' + s + '</span>' +
             '</div>';
    }).join('');

    el.querySelector('.fk-pt-close').addEventListener('click', hide);
    document.body.appendChild(el);
  }

  function setStep(i, state) {
    if (!el) return;
    var s = el.querySelector('.fk-pt-step[data-i="' + i + '"]');
    if (!s) return;
    s.classList.remove('is-active', 'is-done', 'is-fail');
    var ico = s.querySelector('.fk-pt-ico');
    if (state === 'active') { s.classList.add('is-active'); ico.textContent = '◐'; }
    if (state === 'done')   { s.classList.add('is-done');   ico.textContent = '✓'; }
    if (state === 'fail')   { s.classList.add('is-fail');   ico.textContent = '✗'; }
  }

  function animateBar() {
    // Avança até 90% num tempo estimado (~20s), depois abranda
    var alvo = 90, vel = 100 / 200; // 100ms = 0.5%
    timerBar = setInterval(function () {
      if (pct >= alvo) return;
      pct += vel;
      if (pct > alvo) pct = alvo;
      var bar = el.querySelector('.fk-pt-bar');
      if (bar) bar.style.width = pct.toFixed(1) + '%';
    }, 100);
  }

  function animateClock() {
    timerClock = setInterval(function () {
      if (!el) return;
      var t = el.querySelector('.fk-pt-time');
      if (t) t.textContent = fmt(Date.now() - t0);
    }, 120);
  }

  function show(modelo) {
    if (!el) build();
    // Reset
    pct = 0;
    el.classList.remove('is-done', 'is-fail');
    el.classList.add('open');
    el.querySelector('.fk-pt-bar').style.width = '0%';
    el.querySelectorAll('.fk-pt-step').forEach(function (s, i) {
      s.classList.remove('is-active', 'is-done', 'is-fail');
      s.querySelector('.fk-pt-ico').textContent = '○';
    });
    el.querySelector('.fk-pt-model').textContent = modelo || '—';

    t0 = Date.now();
    clearInterval(timerBar); clearInterval(timerClock);
    animateBar();
    animateClock();
    setStep(0, 'active');
    return { step: setStep, done: done, fail: fail, hide: hide };
  }

  function done() {
    clearInterval(timerBar); clearInterval(timerClock);
    if (!el) return;
    el.classList.add('is-done');
    el.querySelector('.fk-pt-bar').style.width = '100%';
    el.querySelector('.fk-pt-time').textContent = fmt(Date.now() - t0);
    setTimeout(hide, 2500);
  }

  function fail(msg) {
    clearInterval(timerBar); clearInterval(timerClock);
    if (!el) return;
    el.classList.add('is-fail');
    el.querySelector('.fk-pt-bar').style.width = '100%';
    el.querySelector('.fk-pt-model').textContent = msg || 'erro';
    el.querySelector('.fk-pt-time').textContent = fmt(Date.now() - t0);
    setTimeout(hide, 4000);
  }

  function hide() {
    clearInterval(timerBar); clearInterval(timerClock);
    if (el) el.classList.remove('open');
  }

  window.FKProgress = {
    show: show,
    step: function (i, s) { setStep(i, s); },
    done: done,
    fail: fail,
    hide: hide,
  };
})();

/* FK_EDIT_TABS — barra de tabs + painel no fundo do editor */
(function () {
  if (window.FKEditTabs) return;
  var TABS = [
    { id: 'output',   label: '▶ Output'       },
    { id: 'analysis', label: '🔍 Análise'     },
    { id: 'perf',     label: '⚡ Performance' },
    { id: 'coverage', label: '📊 Cobertura'   },
    { id: 'suggest',  label: '💡 Sugestões'   }
  ];
  var active = null;
  var els    = { bar: null, panel: null };
  var built  = false;

  function build() {
    var wrap = document.querySelector('.fk-edit-wrap');
    if (!wrap) return false;
    if (wrap.querySelector('.fk-edit-tabs')) { built = true; return true; }

    var bar = document.createElement('div');
    bar.className = 'fk-edit-tabs';
    var html = TABS.map(function (t) {
      return '<button type="button" class="fk-et-tab" data-tab="' + t.id + '">' + t.label + '</button>';
    }).join('');
    html += '<span class="fk-et-spacer"></span>';
    html += '<button type="button" class="fk-et-collapse" title="Mostrar/esconder painel">▾</button>';
    bar.innerHTML = html;

    var panel = document.createElement('div');
    panel.className = 'fk-edit-tabs-panel is-hidden';
    panel.innerHTML = '<div class="fk-etp-empty">Escolhe uma tab acima.</div>';

    var foot = wrap.querySelector('.fk-edit-foot');
    if (foot) {
      wrap.insertBefore(bar, foot);
      wrap.insertBefore(panel, foot);
    } else {
      wrap.appendChild(bar);
      wrap.appendChild(panel);
    }
    els.bar = bar;
    els.panel = panel;

    bar.addEventListener('click', function (e) {
      var tabBtn = e.target.closest('button.fk-et-tab');
      if (tabBtn) { setActive(tabBtn.getAttribute('data-tab')); return; }
      if (e.target.closest('.fk-et-collapse')) { toggle(); }
    });
    built = true;
    console.log('[fk-edit-tabs] barra pronta');
    return true;
  }

  function setActive(id) {
    if (!els.bar) return;
    active = id;
    els.bar.querySelectorAll('.fk-et-tab').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-tab') === id);
    });
    if (els.panel) els.panel.classList.remove('is-hidden');
    setContent('<div class="fk-etp-empty">Tab <b>' + id + '</b> ativa.</div>');
  }

  function setContent(html) {
    if (!els.panel) return;
    els.panel.innerHTML = html;
  }

  function toggle() {
    if (!els.panel) return;
    els.panel.classList.toggle('is-hidden');
    if (els.bar) {
      var btn = els.bar.querySelector('.fk-et-collapse');
      if (btn) btn.textContent = els.panel.classList.contains('is-hidden') ? '▴' : '▾';
    }
  }

  function init() {
    if (build()) return;
    var tent = 0;
    var iv = setInterval(function () {
      tent++;
      if (build() || tent > 100) clearInterval(iv);
    }, 250);
    try {
      var obs = new MutationObserver(function () { build(); });
      obs.observe(document.body, { childList: true, subtree: true });
    } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  window.FKEditTabs = {
    setActive: setActive,
    setContent: setContent,
    toggle: toggle,
    getActive: function () { return active; }
  };
})();
