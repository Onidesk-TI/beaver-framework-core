  /* ── 7. UPDATE (debounced) ── */
  function atualizar() {
    if (window.__fkSuppressAutocomplete) { hide(); return; }
    if (!taBound) return;
    var code = taBound.value;
    var pos  = taBound.selectionStart;
    var w    = palavraAntes(code, pos);

    // Trigger mínimos — aceita 2+ chars, OU sufixo "->"/"::" (mostrar tudo)
    var wNorm = normalizarWord(w);
    if (wNorm.length < 2 && !/(->|::)$/.test(w)) { hide(); return; }

    word = w;
    var novos = filtrarSnippets();

    // Sem resultados → esconder
    if (!novos.length) { hide(); return; }

    // FK_PROGRESSIVE — manter popup se já estava aberto; ajustar índice
    var jaAberto = popup && popup.style.display !== 'none';
    itens = novos;
    if (!jaAberto || idx >= itens.length) idx = 0;

    renderItens();
    if (!jaAberto) show();
    else reposicionar();
  }

  /* ── 8. KEYDOWN ── */
  function onKey(e) {
    if (window.__fkSuppressAutocomplete) { hide(); return; }
    if (!popup || popup.style.display === 'none' || !itens.length) return;

    if (e.key === 'Escape') {
      hide();
      e.preventDefault();
      return;
    }
    if (e.key === 'ArrowDown') {
      idx = (idx + 1) % itens.length;
      renderItens();
      e.preventDefault();
      return;
    }
    if (e.key === 'ArrowUp') {
      idx = (idx - 1 + itens.length) % itens.length;
      renderItens();
      e.preventDefault();
      return;
    }
    if (e.key === 'Enter' && !e.shiftKey) {
      aplicar();
      e.preventDefault();
      return;
    }
    if (e.key === 'Tab') {
      aplicar();
      e.preventDefault();
      return;
    }
  }

  /* ── 9. BIND ── */
  function bind(ta) {
    if (taBound === ta) return;
    taBound = ta;
    // FK_PROGRESSIVE — se popup já está aberto → sem debounce (instantâneo)
    ta.addEventListener('input', function () {
      if (popup && popup.style.display !== 'none' && itens.length) {
        atualizar();
      } else {
        clearTimeout(timer);
        timer = setTimeout(atualizar, 120);
      }
    });
    // Fallback: Backspace/Delete em alguns browsers não disparam 'input'
    ta.addEventListener('keyup', function (e) {
      if (e.key === 'Backspace' || e.key === 'Delete') {
        if (popup && popup.style.display !== 'none') atualizar();
        else {
          clearTimeout(timer);
          timer = setTimeout(atualizar, 120);
        }
      }
    });
    ta.addEventListener('keydown', onKey, true);
    ta.addEventListener('blur', function () {
      // Atraso para permitir click no popup
      setTimeout(hide, 150);
    });
    ta.addEventListener('scroll', hide);
    console.log('[fk-autocomplete] bound');
  }

  /* ── 10. PROCURAR O EDITOR ── */
  function procurarEditor() {
    var ta = document.querySelector('.fk-edit-code');
    if (!ta) return false;
    if (ta.tagName !== 'TEXTAREA') return false;
    bind(ta);
    return true;
  }

  function iniciar() {
    if (procurarEditor()) return;
    var tent = 0;
    var iv = setInterval(function () {
      tent++;
      if (procurarEditor() || tent > 80) clearInterval(iv);
    }, 250);
    // Observar mudanças no DOM do modal
    try {
      var obs = new MutationObserver(function () { procurarEditor(); });
      obs.observe(document.body, { childList: true, subtree: true });
    } catch (e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciar);
  } else {
    iniciar();
  }
})();

