  /* ── Parser do output Pest/PHPUnit ── */
  function parseTestOutput(lines) {
    var stats = {
      tests: 0, passed: 0, failed: 0, skipped: 0,
      assertions: 0, time: '—', ok: false
    };

    var texto = (lines || []).join('\n');

    // Pest/PHPUnit: "Tests:    14 passed (34 assertions)"
    var m1 = texto.match(/Tests:\s+(\d+)\s+passed/i);
    if (m1) { stats.passed = parseInt(m1[1], 10) || 0; }
    var m1b = texto.match(/(\d+)\s+failed/i);
    if (m1b) { stats.failed = parseInt(m1b[1], 10) || 0; }
    var m1c = texto.match(/(\d+)\s+skipped/i);
    if (m1c) { stats.skipped = parseInt(m1c[1], 10) || 0; }
    var m1d = texto.match(/([\d.,]+)\s+assertions/i);
    if (m1d) { stats.assertions = parseInt(m1d[1].replace(/[.,]/g, ''), 10) || 0; }
    var m1e = texto.match(/Duration:\s+([\d.,]+\s*\w+)/i);
    if (m1e) { stats.time = m1e[1]; }

    // Formato "OK (14 tests, 41 assertions)" do PHPUnit
    var m2 = texto.match(/OK \((\d+) tests?,\s*(\d+)\s+assertions?\)/i);
    if (m2) {
      stats.passed = parseInt(m2[1], 10) || 0;
      stats.assertions = parseInt(m2[2], 10) || 0;
    }

    // Formato Pest PT: "Passaram  14"
    var m3 = texto.match(/Pass(aram)?\s*[:·]?\s*(\d+)/i);
    if (m3) stats.passed = parseInt(m3[2], 10) || stats.passed;

    stats.tests = stats.passed + stats.failed + stats.skipped;
    stats.ok = (stats.failed === 0 && stats.tests > 0);

    return stats;
  }

  /* ── Render do resumo ── */
  function renderRunSummary(data) {
    if (!$runSummary || !$runStats) return;

    var stats = parseTestOutput(data.lines || []);

    // Se não conseguiu parsear nada, usar dados do backend
    if (stats.tests === 0 && data.total_lines) {
      stats.time = (data.elapsed_ms || 0) + 'ms';
    }

    $runSummary.hidden = false;

    var html = '';
    html += '<span class="fk-trial-stat ' + (stats.ok ? 'ok' : (stats.failed > 0 ? 'err' : 'muted')) + '">' +
              '<span class="fk-trial-stat-icon">' + (stats.ok ? '✅' : '❌') + '</span>' +
              '<span class="fk-trial-stat-value">' + stats.tests + ' ' + esc(t('testes')) + '</span>' +
            '</span>';

    if (stats.passed > 0) {
      html += '<span class="fk-trial-stat-sep">·</span>' +
              '<span class="fk-trial-stat ok">' +
                '<span class="fk-trial-stat-icon">✅</span>' +
                '<span class="fk-trial-stat-value">' + stats.passed + '</span>' +
              '</span>';
    }
    if (stats.failed > 0) {
      html += '<span class="fk-trial-stat-sep">·</span>' +
              '<span class="fk-trial-stat err">' +
                '<span class="fk-trial-stat-icon">❌</span>' +
                '<span class="fk-trial-stat-value">' + stats.failed + '</span>' +
              '</span>';
    }
    if (stats.skipped > 0) {
      html += '<span class="fk-trial-stat-sep">·</span>' +
              '<span class="fk-trial-stat warn">' +
                '<span class="fk-trial-stat-icon">⏭️</span>' +
                '<span class="fk-trial-stat-value">' + stats.skipped + '</span>' +
              '</span>';
    }
    if (stats.assertions > 0) {
      html += '<span class="fk-trial-stat-sep">·</span>' +
              '<span class="fk-trial-stat info">' +
                '<span class="fk-trial-stat-icon">📊</span>' +
                '<span class="fk-trial-stat-value">' + stats.assertions + '</span>' +
              '</span>';
    }
    if (stats.time !== '—') {
      html += '<span class="fk-trial-stat-sep">·</span>' +
              '<span class="fk-trial-stat muted">' +
                '<span class="fk-trial-stat-icon">⏱️</span>' +
                '<span class="fk-trial-stat-value">' + esc(stats.time) + '</span>' +
              '</span>';
    }

    $runStats.innerHTML = html;

    // Ativar botão Analisar
    if ($btnAnalyze) $btnAnalyze.disabled = false;
  }


  /* ═══════════════════════════════════════════════════════
     CLASSES — tabela + paginação
