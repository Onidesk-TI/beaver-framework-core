// JUNIT VIEWER — assets (CSS/JS)
// ═════════════════════════════════════════════════════════════

$router->get('/api/frankei/terminal/junit-view/{file}', function ($req, $file) {
    $file = (string) $file;
    if (!preg_match('/^[A-Za-z0-9_.-]+\.(js|css)$/', $file)) {
        return \Beaver\Http\Response::text('Forbidden', 403);
    }

    $sub  = str_ends_with($file, '.js') ? 'js/' : 'css/';
    $path = dirname(__DIR__) . '/resources/ui/' . $sub . $file;

    if (!is_file($path)) {
        return \Beaver\Http\Response::text('Not found: ' . $file, 404);
    }

    $mime = str_ends_with($file, '.js')
        ? 'application/javascript; charset=utf-8'
        : 'text/css; charset=utf-8';

    return (new \Beaver\Http\Response(file_get_contents($path)))
        ->withHeader('Content-Type', $mime)
        ->withHeader('Cache-Control', 'public, max-age=300');
});
