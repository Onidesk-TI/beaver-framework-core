// ═════════════════════════════════════════════════════════════
// CLASSES — autocomplete (PSR-4 do composer.json)
// ═════════════════════════════════════════════════════════════
$router->get('/api/frankei/classes', function ($req) {
    $q     = strtolower(trim((string)($req->query['q'] ?? '')));
    $limit = min(100, max(10, (int)($req->query['limit'] ?? 50)));

    $root = dirname(__DIR__, 3);
    $composer = json_decode((string) @file_get_contents($root . '/composer.json'), true);
    $map = $composer['autoload']['psr-4'] ?? [];

    $results = [];
    foreach ($map as $ns => $dir) {
        if (strpos($ns, 'Tests\\') === 0) continue;
        $abs = $root . '/' . rtrim($dir, '/');
        if (!is_dir($abs)) continue;

        try {
            $it = new \RecursiveIteratorIterator(
                new \RecursiveDirectoryIterator($abs, \FilesystemIterator::SKIP_DOTS)
            );
            foreach ($it as $file) {
                if ($file->getExtension() !== 'php') continue;
                $rel = substr($file->getPathname(), strlen($abs) + 1);
                $rel = str_replace(['/', '.php'], ['\\', ''], $rel);
                $fqcn = $ns . $rel;

                if ($q !== '' && strpos(strtolower($fqcn), $q) === false) continue;

                $results[] = [
                    'class' => $fqcn,
                    'file'  => ltrim(substr($file->getPathname(), strlen($root)), '/'),
                ];
            }
        } catch (\Throwable $e) {
        }
    }

    usort($results, function ($a, $b) {
        return strcmp($a['class'], $b['class']);
    });
    $results = array_slice($results, 0, $limit);

    return \Beaver\Http\Response::json(['ok' => true, 'classes' => $results]);
});


// ═════════════════════════════════════════════════════════════
// TEST FILE — ver conteúdo de um teste (só leitura)
// ═════════════════════════════════════════════════════════════
$router->get('/api/frankei/test-file', function ($req) {
    $class = trim((string)($req->query['class'] ?? ''));
    if ($class === '') {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'class obrigatória'], 422);
    }

    $root = dirname(__DIR__, 3);

    // Normaliza: Tests.Unit.FkDemoServiceTest  →  Tests\Unit\FkDemoServiceTest
    $fqcn = str_replace('.', '\\', $class);

    // Candidatos por ordem:
    //   tests/Unit/FkDemoServiceTest.php
    //   tests/Feature/FkDemoServiceTest.php
    //   tests/FkDemoServiceTest.php
    $short = substr($fqcn, strrpos($fqcn, '\\') !== false ? strrpos($fqcn, '\\') + 1 : 0);
    $candidates = [
        $root . '/tests/' . str_replace('\\', '/', substr($fqcn, strpos($fqcn, 'Tests\\') === 0 ? 6 : 0)) . '.php',
        $root . '/tests/' . $short . '.php',
    ];

    // Se não encontrou, procura em tests/ por basename
    $found = null;
    foreach ($candidates as $c) {
        if (is_file($c)) {
            $found = $c;
            break;
        }
    }
    if (!$found) {
        try {
            $it = new \RecursiveIteratorIterator(
                new \RecursiveDirectoryIterator($root . '/tests', \FilesystemIterator::SKIP_DOTS)
            );
            foreach ($it as $f) {
                if ($f->getExtension() !== 'php') continue;
                if ($f->getBasename('.php') === $short) {
                    $found = $f->getPathname();
                    break;
                }
            }
        } catch (\Throwable $e) {
        }
    }

    if (!$found || !is_file($found)) {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'Ficheiro não encontrado: ' . $short . '.php'], 404);
    }

    // Segurança: garantir que está dentro do root
    $real = realpath($found);
    if ($real === false || strpos($real, $root . '/tests/') !== 0) {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'Path inválido'], 403);
    }

    $content = @file_get_contents($real);
    if ($content === false) {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'Falha a ler'], 500);
    }

    return \Beaver\Http\Response::json([
        'ok'      => true,
        'class'   => $fqcn,
        'file'    => ltrim(substr($real, strlen($root)), '/'),
        'content' => $content,
        'size'    => strlen($content),
        'mtime'   => date('c', filemtime($real)),
    ]);
});



// ═════════════════════════════════════════════════════════════
// TEST FILE — gravar conteúdo (com backup .bak.<timestamp>)
// ═════════════════════════════════════════════════════════════
$router->post('/api/frankei/test-file', function ($req) {
    $body    = $req->body ?? [];
    $class   = trim((string)($body['class']   ?? ''));
    $content = (string)($body['content'] ?? '');

    if ($class === '') {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'class obrigatória'], 422);
    }
    if ($content === '') {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'conteúdo vazio'], 422);
    }
    // Sanidade: tem de começar por <?php
    if (strpos(ltrim($content), '<?php') !== 0) {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'ficheiro tem de começar por <?php'], 422);
    }

    $root = dirname(__DIR__, 3);
    $fqcn = str_replace('.', '\\', $class);
    $short = substr($fqcn, strrpos($fqcn, '\\') !== false ? strrpos($fqcn, '\\') + 1 : 0);

    // Mesma lógica de resolução do GET
    $found = null;
    try {
        $it = new \RecursiveIteratorIterator(
            new \RecursiveDirectoryIterator($root . '/tests', \FilesystemIterator::SKIP_DOTS)
        );
        foreach ($it as $f) {
            if ($f->getExtension() !== 'php') continue;
            if ($f->getBasename('.php') === $short) {
                $found = $f->getPathname();
                break;
            }
        }
    } catch (\Throwable $e) {
    }

    if (!$found || !is_file($found)) {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'Ficheiro não encontrado: ' . $short . '.php'], 404);
    }

    $real = realpath($found);
    if ($real === false || strpos($real, $root . '/tests/') !== 0) {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'Path inválido'], 403);
    }

    // Backup antes de gravar
    $bak = $real . '.bak.' . date('Ymd_His');
    @copy($real, $bak);

    $bytes = @file_put_contents($real, $content);
    if ($bytes === false) {
        return \Beaver\Http\Response::json(['ok' => false, 'error' => 'Falha a gravar'], 500);
    }

    return \Beaver\Http\Response::json([
        'ok'    => true,
        'file'  => ltrim(substr($real, strlen($root)), '/'),
        'bytes' => $bytes,
        'backup' => basename($bak),
        'mtime' => date('c'),
    ]);
});
