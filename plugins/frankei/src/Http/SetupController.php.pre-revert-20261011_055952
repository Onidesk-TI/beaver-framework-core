<?php

declare(strict_types=1);

namespace Beaver\Plugins\Frankei\Http;

use App\Services\UserService;
use Beaver\Http\Response;
use Beaver\Foundation\Application;

/**
 * Frankei — Setup Controller
 *
 * Fluxo:
 *   /frankei             → dashboard()  (auth → path → dashboard)
 *   /frankei/path        → showPath()   (form do path)
 *   /frankei/path POST   → savePath()   (guarda JSON)
 *   /api/frankei/validate-path POST → validatePath() (AJAX)
 *   /frankei/logout      → logout()
 */
class SetupController
{
    /** Plano free: apenas 1 path */
    private const FREE_MAX_PATHS = 1;

    /* ══════════════════════════════════════════════════════════
       DASHBOARD  →  /frankei
       ══════════════════════════════════════════════════════════ */

    public function dashboard(string $view = 'unit-tests'): Response
    {
        if (!UserService::autenticado()) {
            $next = $_SERVER['REQUEST_URI'] ?? '/frankei';
            return Response::redirect($this->loginUrl($next));
        }

        $user   = UserService::atual();
        $userId = (int) ($user['id'] ?? 0);

        $setup = $this->loadSetup($userId);
        if (empty($setup['path'])) {
            return Response::redirect('/frankei/path');
        }

        // ── Trial: verificar ou iniciar automaticamente ──
        $trialInfo = UserService::trialCheck($userId);

        if (empty($trialInfo['ok'])) {
            $motivo = $trialInfo['motivo'] ?? '';

            // Se ainda não iniciou, começa agora (8 dias)
            if ($motivo === 'Trial não iniciado.') {
                $started = UserService::trialStart($user, $_SERVER['HTTP_HOST'] ?? '');
                if (!empty($started['ok'])) {
                    // Recarregar info
                    $trialInfo = UserService::trialCheck($userId);
                } else {
                    // Falhou a iniciar — bloqueia
                    UserService::destruirSessao();
                    return Response::redirect('/auth/login?erro=' . urlencode($started['motivo'] ?? 'Trial indisponível.'));
                }
            } else {
                // Expirado/usado — bloqueia
                UserService::destruirSessao();
                return Response::redirect('/auth/login?erro=' . urlencode($motivo));
            }
        }

        return $this->render('dashboard.php', [
            'user'         => $user,
            'path'         => $setup['path'],
            'files'        => $setup['files']       ?? [],
            'files_count'  => $setup['files_count'] ?? 0,
            'plan'         => $setup['plan']        ?? 'free',
            'plan_limit'   => $setup['plan_limit']  ?? 25,
            'trial'        => $trialInfo,
            'viewName'     => $view,
        ]);
    }

    /* ══════════════════════════════════════════════════════════
       PATH (GET)  →  /frankei/path
       ══════════════════════════════════════════════════════════ */

    public function showPath(): Response
    {
        // Público — qualquer um vê (mensagem adaptada ao estado)
        $user = UserService::autenticado() ? UserService::atual() : null;

        // Se já tem path + trial ativo → redireciona para o painel
        if ($user) {
            $userId = (int) ($user['id'] ?? 0);
            $setup  = $this->loadSetup($userId);

            $rows = \App\Services\SiteDB::select(
                'SELECT trial_used, trial_expires_at FROM users WHERE id = :id',
                [':id' => $userId]
            );
            $r = $rows[0] ?? [];

            $hasPath  = !empty($setup['path']);
            $hasTrial = empty($r['trial_used'])
                     && !empty($r['trial_expires_at'])
                     && (int) $r['trial_expires_at'] > time();

            // Se já tem path mas SEM trial → deixa ver (com banner)
            // Se já tem path E trial → vai para o painel
            if ($hasPath && $hasTrial) {
                return Response::redirect('/frankei');
            }
        }

        return $this->render('path.php', [
            'user'   => $user ?? [],
            'errors' => $_GET['erro'] ?? null,
            'old'    => $_GET['path'] ?? '',
        ]);
    }

    /* ══════════════════════════════════════════════════════════
       PATH (POST)  →  /frankei/path
       ══════════════════════════════════════════════════════════ */

    public function savePath(): Response
    {
        if (!UserService::autenticado()) {
            $next = $_SERVER['REQUEST_URI'] ?? '/frankei/path';
            return Response::redirect($this->loginUrl($next));
        }

        $user   = UserService::atual();
        $userId = (int) ($user['id'] ?? 0);

        $setup = $this->loadSetup($userId);
        if (!empty($setup['path'])) {
            return Response::redirect('/frankei');
        }

        $path = trim((string) ($_POST['path'] ?? ''));
        if ($path === '') {
            return Response::redirect('/frankei/path?erro=' . urlencode('Indica um caminho.'));
        }

        // Normalizar (C:/... → /mnt/c/...)
        $path = $this->normalizarPath($path);

        if ($path === '') { $path = '/'; }

        $valid = $this->validarPath($path);
        if (!$valid['ok']) {
            return Response::redirect('/frankei/path?erro=' . urlencode($valid['motivo']) . '&path=' . urlencode($path));
        }

        // Recolher os ficheiros escolhidos (máx 5 no plano grátis)
        $files = $_POST['files'] ?? [];
        if (!is_array($files)) $files = [];
        $files = array_slice(array_values(array_filter($files, 'is_string')), 0, 5);

        $this->saveSetup($userId, [
            'user_id'      => $userId,
            'path'         => $path,
            'framework'    => $valid['framework'] ?? 'php',
            'validated_at' => date('c'),
            'stats'        => $valid['stats'] ?? [],
            'files'        => $files,
            'files_count'  => count($files),
            'plan'         => 'free',
            'plan_limit' => 25,
        ]);

        return Response::redirect('/frankei');
    }

    /* ══════════════════════════════════════════════════════════
       VALIDATE (AJAX)  →  /api/frankei/validate-path
       ══════════════════════════════════════════════════════════ */

    public function validatePath(): Response
    {
        if (!UserService::autenticado()) {
            return Response::json(['ok' => false, 'motivo' => 'Não autenticado.'], 401);
        }

        $body = $_POST;
        if (empty($body)) {
            $raw  = file_get_contents('php://input');
            $body = json_decode($raw ?: '[]', true) ?: [];
        }

        $path = trim((string) ($body['path'] ?? ''));
        if ($path === '') {
            return Response::json(['ok' => false, 'motivo' => 'Caminho vazio.']);
        }

        $path = rtrim($path, '/');
        if ($path === '') { $path = '/'; }

        return Response::json($this->validarPath($path));
    }

    /* ══════════════════════════════════════════════════════════
       LOGOUT  →  /frankei/logout
       ══════════════════════════════════════════════════════════ */

            public function logout(): Response
    {
        UserService::destruirSessao();

        // Destino configurável via .env (FRANKEI_LANDING_URL)
        // Fallback: deteção automática dev/produção
        $url = $_ENV['FRANKEI_LANDING_URL']
            ?? $_SERVER['FRANKEI_LANDING_URL']
            ?? getenv('FRANKEI_LANDING_URL')
            ?: null;

        if (!$url) {
            $host    = $_SERVER['HTTP_HOST'] ?? 'localhost';
            $isLocal = str_starts_with($host, 'localhost') || str_starts_with($host, '127.0.0.1');

            if ($isLocal) {
                $url = '/entrar';
            } else {
                $scheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
                $url = $scheme . '://' . $host . '/frankei/';
            }
        }

        return Response::redirect($url);
    }

