    /**
     * Envia email via SMTP puro (sem libs).
     */
    private function enviarEmailPassword(string $para, string $nome, string $password, array $cfg): bool
    {
        $host = $cfg['host'];
        $port = $cfg['port'];
        $user = $cfg['user'];
        $pass = $cfg['pass'];
        $from = $cfg['from'];
        $name = $cfg['name'];
        $enc  = $cfg['enc'];

        $prefix = ($enc === 'ssl') ? 'ssl://' : '';
        $socket = @stream_socket_client($prefix . $host . ':' . $port, $errno, $errstr, 15);
        if (!$socket) {
            throw new \RuntimeException("SMTP: falha a conectar a {$host}:{$port} — {$errstr}");
        }

        stream_set_timeout($socket, 15);
        $read = function () use ($socket) {
            $data = '';
            while ($line = fgets($socket, 515)) {
                $data .= $line;
                if (isset($line[3]) && $line[3] === ' ') break;
            }
            return $data;
        };
        $send = function (string $cmd) use ($socket) { fwrite($socket, $cmd . "\r\n"); };

        $read();

        $send('EHLO ' . ($_SERVER['HTTP_HOST'] ?? 'localhost'));
        $read();

        if ($enc === 'tls') {
            $send('STARTTLS');
            $read();
            if (!stream_socket_enable_crypto($socket, true, STREAM_CRYPTO_METHOD_TLS_CLIENT)) {
                throw new \RuntimeException('SMTP: STARTTLS falhou');
            }
            $send('EHLO ' . ($_SERVER['HTTP_HOST'] ?? 'localhost'));
            $read();
        }

        $send('AUTH LOGIN');
        $read();
        $send(base64_encode($user));
        $read();
        $send(base64_encode($pass));
        $authResp = $read();
        if (strpos($authResp, '235') === false) {
            fclose($socket);
            throw new \RuntimeException('SMTP: autenticação falhou — ' . trim($authResp));
        }

        $send('MAIL FROM:<' . $from . '>');
        $read();
        $send('RCPT TO:<' . $para . '>');
        $read();
        $send('DATA');
        $read();

        $subject = '=?UTF-8?B?' . base64_encode('A tua password Frankei') . '?=';
        $html    = $this->buildEmailHtml($nome, $password);

        $headers  = "From: =?UTF-8?B?" . base64_encode($name) . "?= <{$from}>\r\n";
        $headers .= "To: <{$para}>\r\n";
        $headers .= "Subject: {$subject}\r\n";
        $headers .= "MIME-Version: 1.0\r\n";
        $headers .= "Content-Type: text/html; charset=UTF-8\r\n";
        $headers .= "Content-Transfer-Encoding: base64\r\n";
        $headers .= "Date: " . date('r') . "\r\n";

        $body = chunk_split(base64_encode($html));

        $send($headers . "\r\n" . $body . "\r\n.");
        $final = $read();

        fwrite($socket, "QUIT\r\n");
        fclose($socket);

        return strpos($final, '250') !== false;
    }

    private function buildEmailHtml(string $nome, string $password): string
    {
        $loginUrl = 'http://' . ($_SERVER['HTTP_HOST'] ?? 'localhost:9000') . '/entrar';
        $nome     = htmlspecialchars($nome ?: 'Tester', ENT_QUOTES);
        $password = htmlspecialchars($password, ENT_QUOTES);

        return '<!DOCTYPE html><html><body style="font-family:Arial,sans-serif;background:#FBF8F2;padding:32px;">'
            . '<div style="max-width:560px;margin:0 auto;background:#fff;border-radius:20px;padding:36px;">'
            . '<h1 style="color:#2B2F36;">Frankei</h1>'
            . '<p style="color:#5F656D;">Olá <b>' . $nome . '</b>,</p>'
            . '<p>Aqui está a tua chave/password. Tem 30 minutos a contar do primeiro login.</p>'
            . '<div style="background:#FFF7E8;border-radius:14px;padding:20px;margin:22px 0;text-align:center;">'
            . '<div style="font-size:12px;color:#7A3F00;margin-bottom:8px;">A tua password</div>'
            . '<div style="font-family:Courier,monospace;font-size:26px;font-weight:800;color:#5C2F00;">' . $password . '</div>'
            . '</div>'
            . '<p><a href="' . $loginUrl . '" style="display:inline-block;padding:14px 32px;background:#F5A623;color:#5C2F00;text-decoration:none;border-radius:12px;font-weight:700;">Entrar →</a></p>'
            . '<p style="font-size:12px;color:#999;margin-top:32px;">Frankei · Beaver Framework</p>'
            . '</div></body></html>';
    }

