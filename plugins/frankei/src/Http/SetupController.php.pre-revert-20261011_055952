    /**
     * Devolve a URL de login a usar no guard.
     * Configurável via .env (FRANKEI_LOGIN_URL).
     */
    private function loginUrl(string $next = ''): string
    {
        $url = $_ENV['FRANKEI_LOGIN_URL']
            ?? $_SERVER['FRANKEI_LOGIN_URL']
            ?? getenv('FRANKEI_LOGIN_URL')
            ?: '/auth/login';

        if ($next !== '') {
            $sep = str_contains($url, '?') ? '&' : '?';
            $url .= $sep . 'next=' . urlencode($next);
        }

        return $url;
    }

    private function render(string $view, array $vars = []): Response
    {
        $viewPath = Application::getInstance()->basePath
              . '/plugins/frankei/resources/views/' . $view;

        if (!is_file($viewPath)) {
            return Response::text('View não encontrada: ' . $view, 500);
        }

        extract($vars, EXTR_SKIP);
        ob_start();
        require $viewPath;
        return Response::html((string) ob_get_clean());
    }


