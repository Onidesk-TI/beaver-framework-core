    /**
     * API: lista os ficheiros PHP de um path (para o painel de seleção).
     * Limite: 500 ficheiros (plano free: 50%).
     */
    public function listFiles(): Response
    {
        if (!UserService::autenticado()) {
            return Response::json(['ok' => false, 'motivo' => 'Não autenticado.'], 401);
        }

        // Aceita POST form ou JSON
        $body = $_POST;
        if (empty($body)) {
            $raw  = file_get_contents('php://input');
            $body = json_decode($raw ?: '[]', true) ?: [];
        }

        $path = trim((string) ($body['path'] ?? ''));
        $path = $this->normalizarPath($path);

        if ($path === '' || !is_dir($path)) {
            return Response::json(['ok' => false, 'motivo' => 'Path inválido.']);
        }

        $excludeDirs = ['vendor', 'node_modules', '.git', '.venv', 'storage', 'cache', 'tmp'];

        $files     = [];
        $totalPhp  = 0;
        $limit     = 500;

        try {
            $iter = new \RecursiveIteratorIterator(
                new \RecursiveDirectoryIterator($path, \RecursiveDirectoryIterator::SKIP_DOTS),
                \RecursiveIteratorIterator::SELF_FIRST
            );
            $iter->setMaxDepth(8);

            foreach ($iter as $file) {
                if (!$file->isFile()) continue;

                $rel = ltrim(substr($file->getPathname(), strlen($path)), '/');

                // Excluir pastas indesejadas
                $skip = false;
                foreach ($excludeDirs as $ex) {
                    if (str_starts_with($rel, $ex . '/') || str_contains($rel, '/' . $ex . '/')) {
                        $skip = true;
                        break;
                    }
                }
                if ($skip) continue;

                if (strtolower($file->getExtension()) !== 'php') continue;

                $totalPhp++;

                if (count($files) < $limit) {
                    $files[] = [
                        'rel'   => $rel,
                        'size'  => $file->getSize(),
                        'mtime' => $file->getMTime(),
                    ];
                }
            }
        } catch (\Throwable $e) {
            return Response::json(['ok' => false, 'motivo' => 'Erro a listar: ' . $e->getMessage()]);
        }

        // Ordenar por caminho
        usort($files, fn($a, $b) => strcmp($a['rel'], $b['rel']));

        return Response::json([
            'ok'        => true,
            'path'      => $path,
            'files'     => $files,
            'total'     => $totalPhp,
            'shown'     => count($files),
            'limit'     => $limit,
            'free_max'  => 25,   // plano grátis: máximo 5 ficheiros
        ]);
    }


    /**
     * Normaliza paths Windows (C:/... ou C:\...) para o formato WSL (/mnt/c/...).
     * Também aceita paths Linux normais e devolve sempre com / no início.
     */
    private function normalizarPath(string $path): string
    {
        $path = trim($path);
        if ($path === '') return $path;

        // 1. Normalizar barras: backslash → forward slash
        // chr(92) = "\" — evita problemas de escaping
        $path = str_replace(chr(92), '/', $path);

        // 2. Windows: "C:/..." ou "c:/..."
        if (preg_match('#^([A-Za-z]):/(.*)$#', $path, $m)) {
            $drive = strtolower($m[1]);
            $rest  = ltrim($m[2], '/');
            return '/mnt/' . $drive . '/' . $rest;
        }

        // 3. Remover trailing slash (excepto raiz)
        if (strlen($path) > 1) {
            $path = rtrim($path, '/');
        }

        return $path;
    }

    private function validarPath(string $path): array
    {
        // Traduzir C:/... → /mnt/c/... automaticamente
        $path = $this->normalizarPath($path);

        if (!file_exists($path)) {
            return ['ok' => false, 'motivo' => 'O caminho não existe.'];
        }
        if (!is_dir($path)) {
            return ['ok' => false, 'motivo' => 'O caminho não é uma pasta.'];
        }
        if (!is_readable($path)) {
            return ['ok' => false, 'motivo' => 'Sem permissão para ler essa pasta.'];
        }

        $checks = [
            'composer'    => is_file($path . '/composer.json'),
            'beaver_file' => is_file($path . '/beaver'),
            'app_dir'     => is_dir($path . '/app'),
            'src_dir'     => is_dir($path . '/src'),
            'public_dir'  => is_dir($path . '/public'),
            'routes_dir'  => is_dir($path . '/routes'),
            'index_php'   => is_file($path . '/index.php'),
            'public_php'  => is_file($path . '/public/index.php'),
        ];

        $sinais = array_filter($checks);
        if (empty($sinais)) {
            return [
                'ok'     => false,
                'motivo' => 'A pasta não parece um projeto PHP (sem composer.json, app/, src/, public/, index.php...).',
                'checks' => $checks,
            ];
        }

        $framework = 'php';
        if ($checks['beaver_file'] || is_file($path . '/composer.json')) {
            $composerRaw = @file_get_contents($path . '/composer.json') ?: '';
            if (stripos($composerRaw, 'beaver') !== false) {
                $framework = 'beaver';
            } elseif ($checks['routes_dir'] && $checks['app_dir']) {
                $framework = 'beaver';
            }
        }

        $stats = [
            'php_files'   => $this->contar($path, '*.php', 5000),
            'controllers' => $this->contar($path . '/app/Controllers', '*.php', 200),
            'models'      => $this->contar($path . '/app/Models', '*.php', 200),
            'views'       => $this->contar($path . '/app/Views', '*.php', 500)
                            + $this->contar($path . '/resources/views', '*.php', 500),
            'writable'    => is_writable($path),
        ];

        return [
            'ok'        => true,
            'motivo'    => 'Caminho válido.',
            'path'      => $path,
            'framework' => $framework,
            'checks'    => $checks,
            'stats'     => $stats,
        ];
    }

    private function contar(string $dir, string $glob, int $max = 1000): int
    {
        if (!is_dir($dir)) return 0;
        $files = @glob($dir . '/' . $glob, GLOB_NOSORT);
        return is_array($files) ? min(count($files), $max) : 0;
    }

    /* ══════════════════════════════════════════════════════════
       STORAGE
       ══════════════════════════════════════════════════════════ */

    private function setupDir(int $userId): string
    {
        $base = Application::getInstance()->basePath
              . '/plugins/frankei/storage/users/' . $userId;

        if (!is_dir($base)) { @mkdir($base, 0775, true); }
        return $base;
    }

    private function setupFile(int $userId): string
    {
        return $this->setupDir($userId) . '/setup.json';
    }

    private function loadSetup(int $userId): array
    {
        $f = $this->setupFile($userId);
        if (!is_file($f)) return [];
        $raw = @file_get_contents($f);
        return is_string($raw) ? (json_decode($raw, true) ?: []) : [];
    }

    private function saveSetup(int $userId, array $data): void
    {
        $f = $this->setupFile($userId);
        @file_put_contents($f, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
    }

