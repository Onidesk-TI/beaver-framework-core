    public function requestTrial(): Response
    {
        $body = $_POST;
        if (empty($body)) {
            $raw  = file_get_contents('php://input');
            $body = json_decode($raw ?: '[]', true) ?: [];
        }

        $email = strtolower(trim((string) ($body['email'] ?? '')));
        $phone = preg_replace('/[^0-9+]/', '', (string) ($body['phone'] ?? ''));
        $nome  = trim((string) ($body['nome'] ?? 'Tester'));
        $path  = trim((string) ($body['path'] ?? ''));

        // ── Se autenticado, usa dados da sessão (ignora POST vazio) ──
        if (UserService::autenticado()) {
            $u = UserService::atual();
            if ($u) {
                if ($email === '')  $email = strtolower((string) ($u['email'] ?? ''));
                if ($nome === '' || $nome === 'Tester') $nome = (string) ($u['nome'] ?? 'Tester');
                if ($phone === '')  $phone = (string) ($u['phone'] ?? '');
            }
        }

        if ($path !== '') {
            $path = $this->normalizarPath($path);
        }

        // ─── DEBUG TEMPORÁRIO ───
        @file_put_contents('/tmp/fw-debug.log',
            date('c') . "\n" .
            "  autenticado: " . (UserService::autenticado() ? 'true' : 'false') . "\n" .
            "  u: " . json_encode(UserService::atual()) . "\n" .
            "  email final: '" . $email . "'\n" .
            "  nome: '" . $nome . "'\n" .
            "  phone: '" . $phone . "'\n" .
            "────────────\n",
            FILE_APPEND
        );

        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            return Response::json(['ok' => false, 'erro' => 'Email inválido.'], 422);
        }

        $existente = \App\Services\UserService::porEmail($email);
        if ($existente !== null) {
            return Response::json(['ok' => false, 'erro' => 'Este email já pediu trial.'], 409);
        }

        $password = $this->gerarPassword(10);
        $hash     = password_hash($password, PASSWORD_BCRYPT);
        $now      = time();

        try {
            \App\Services\SiteDB::insert(
                'INSERT INTO users (nome, email, phone, password_hash, ativo, role, plan, plan_limit, trial_minutes, criado_em, atualizado_em)
                 VALUES (:n, :e, :ph, :p, 1, :r, :pl, :lm, :tm, :c, :u)',
                [
                    ':n'  => $nome ?: 'Tester',
                    ':e'  => $email,
                    ':ph' => $phone,
                    ':p'  => $hash,
                    ':r'  => 'user',
                    ':pl' => 'free',
                    ':lm' => 25,
                    ':tm' => 11520,
                    ':c'  => $now,
                    ':u'  => $now,
                ]
            );
        } catch (\Throwable $e) {
            return Response::json(['ok' => false, 'erro' => 'Erro: ' . $e->getMessage()], 500);
        }

        $mailOk  = false;
        $mailErr = '';
        $cfg = [
            'host' => $_ENV['MAIL_HOST'] ?? getenv('MAIL_HOST') ?: '',
            'port' => (int) ($_ENV['MAIL_PORT'] ?? getenv('MAIL_PORT') ?: 587),
            'user' => $_ENV['MAIL_USER'] ?? getenv('MAIL_USER') ?: '',
            'pass' => $_ENV['MAIL_PASS'] ?? getenv('MAIL_PASS') ?: '',
            'from' => $_ENV['MAIL_FROM'] ?? getenv('MAIL_FROM') ?: '',
            'name' => $_ENV['MAIL_FROM_NAME'] ?? getenv('MAIL_FROM_NAME') ?: 'Frankei',
            'enc'  => $_ENV['MAIL_ENCRYPTION'] ?? getenv('MAIL_ENCRYPTION') ?: 'tls',
        ];

        try {
            $mailOk = $this->enviarEmailPassword($email, $nome, $password, $cfg);
        } catch (\Throwable $e) {
            $mailErr = $e->getMessage();
        }

        $resp = ['ok' => true, 'email' => $email, 'email_enviado' => $mailOk];
        if (!$mailOk) {
            $resp['password']  = $password;
            $resp['mail_erro'] = $mailErr;
        }
        return Response::json($resp);
    }

    public function requestDemo(): Response
    {
        $body = $_POST ?: json_decode(file_get_contents('php://input') ?: '[]', true);
        $email = strtolower(trim((string) ($body['email'] ?? '')));
        $phone = preg_replace('/[^0-9+]/', '', (string) ($body['phone'] ?? ''));

        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            return Response::json(['ok' => false, 'erro' => 'Email inválido.'], 422);
        }
        if (strlen($phone) < 9) {
            return Response::json(['ok' => false, 'erro' => 'Telefone inválido.'], 422);
        }

        try {
            \App\Services\SiteDB::exec(
                'CREATE TABLE IF NOT EXISTS demos (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    email TEXT NOT NULL,
                    phone TEXT NOT NULL,
                    ip TEXT, user_agent TEXT,
                    criado_em INTEGER NOT NULL
                )'
            );
            \App\Services\SiteDB::insert(
                'INSERT INTO demos (email, phone, ip, user_agent, criado_em) VALUES (:e, :p, :ip, :ua, :c)',
                [
                    ':e'  => $email,
                    ':p'  => $phone,
                    ':ip' => $_SERVER['REMOTE_ADDR'] ?? null,
                    ':ua' => mb_substr((string) ($_SERVER['HTTP_USER_AGENT'] ?? ''), 0, 500),
                    ':c'  => time(),
                ]
            );
        } catch (\Throwable $e) {
            return Response::json(['ok' => false, 'erro' => 'Erro: ' . $e->getMessage()], 500);
        }

        return Response::json(['ok' => true, 'mensagem' => 'Pedido recebido. Entramos em contacto em 24h.']);
    }

    private function gerarPassword(int $len = 10): string
    {
        $chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
        $out = '';
        for ($i = 0; $i < $len; $i++) {
            $out .= $chars[random_int(0, strlen($chars) - 1)];
        }
        return $out;
    }


    /**
     * Guarda o setup para um user autenticado (sem criar user novo).
     * Rota: POST /api/frankei/save-setup
     */
    public function saveSetupFromSession(): Response
    {
        if (!UserService::autenticado()) {
            return Response::json(['ok' => false, 'erro' => 'Não autenticado.'], 401);
        }

        $u = UserService::atual();
        if (!$u) {
            return Response::json(['ok' => false, 'erro' => 'Sessão inválida.'], 401);
        }

        $userId = (int) $u['id'];
        $body   = $_POST ?: json_decode(file_get_contents('php://input') ?: '[]', true);

        $path = trim((string) ($body['path'] ?? ''));
        if ($path === '') {
            return Response::json(['ok' => false, 'erro' => 'Path em falta.'], 422);
        }

        $path = $this->normalizarPath($path);

        if (!is_dir($path)) {
            return Response::json(['ok' => false, 'erro' => 'O caminho não existe: ' . $path], 422);
        }

        $files = $body['files'] ?? [];
        if (!is_array($files)) $files = [];
        $files = array_slice(array_values(array_filter($files, 'is_string')), 0, 25);

        if (empty($files)) {
            return Response::json(['ok' => false, 'erro' => 'Seleciona pelo menos 1 ficheiro.'], 422);
        }

        $this->saveSetup($userId, [
            'user_id'      => $userId,
            'path'         => $path,
            'framework'    => 'php',
            'validated_at' => date('c'),
            'files'        => $files,
            'files_count'  => count($files),
            'plan'         => 'free',
            'plan_limit'   => 25,
        ]);

        return Response::json([
            'ok'       => true,
            'path'     => $path,
            'files'    => count($files),
            'redirect' => '/frankei',
            'mensagem' => 'Setup guardado. A entrar no Frankei.',
        ]);
    }

