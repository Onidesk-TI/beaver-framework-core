        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
            msg: e.message,
            file: e.filename,
            line: e.lineno,
            col: e.colno,
            stack: e.error ? e.error.stack : ''
        })
    });
});
</script>

