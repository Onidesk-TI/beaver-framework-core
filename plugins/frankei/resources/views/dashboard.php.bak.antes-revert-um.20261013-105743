.fk-user-menu-body .fk-settings-panel {
    display: block !important;
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
}
</style>

<script>
(function () {
    'use strict';
    if (window.__fkUserModalInit) return;
    window.__fkUserModalInit = true;

    function visivel(el) {
        if (!el) return false;
        if (el.hidden) return false;
        if (el.offsetParent === null && getComputedStyle(el).position !== 'fixed') return false;
        return true;
    }

    function init() {
        var trigger  = document.getElementById('fkUserTrigger');
        var menu     = document.getElementById('fkUserMenu');
        var closeBtn = document.getElementById('fkUserMenuClose');
        var body     = document.getElementById('fkUserMenuBody');

        if (!trigger || !menu || !body) {
            console.warn('[fk-user-menu] elementos em falta');
            return;
        }

        // Mover painel Conta (uma unica vez)
        var painel = document.querySelector('[data-settings-panel="conta"]');
        if (painel && painel.parentElement !== body) {
            body.appendChild(painel);
            painel.classList.remove('active');
        }

        var aberto = false;

        function fecharMenuSettings() {
            // Nao mexer em style nem classList — so clicar no botao X proprio
            var btnClose = document.getElementById('fkSettingsClose');
            var menuSet  = document.getElementById('fkSettingsMenu');
            if (menuSet && visivel(menuSet) && btnClose) {
                btnClose.click();
            }
        }

        function abrir() {
            if (aberto) return;
            aberto = true;
            menu.hidden = false;
            trigger.setAttribute('aria-expanded', 'true');
            trigger.classList.add('is-open');
            fecharMenuSettings();
        }

        function fechar() {
            if (!aberto) return;
            aberto = false;
            menu.hidden = true;
            trigger.setAttribute('aria-expanded', 'false');
            trigger.classList.remove('is-open');
        }

        function toggle(ev) {
            if (ev) { ev.preventDefault(); ev.stopPropagation(); }
            if (aberto) fechar(); else abrir();
        }

        // Toggle no proprio trigger
        trigger.addEventListener('click', function (e) {
            if (e.target.closest('#fkUserMenu')) return;
            toggle(e);
        });

        // Teclado
        trigger.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') toggle(e);
            if (e.key === 'Escape' && aberto) fechar();
        });

        // Botao X
        if (closeBtn) {
            closeBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                fechar();
            });
        }

        // Fechar ao clicar fora — fase de captura para correr antes dos outros
        document.addEventListener('mousedown', function (e) {
            if (!aberto) return;
            if (trigger.contains(e.target)) return;
            if (menu.contains(e.target)) return;
            fechar();
        }, true);

        // ESC global
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && aberto) fechar();
        });

        // Se o menu de settings for aberto pelo proprio botao, fecha o do user.
        // Fazemos isto via observer que APENAS fecha o nosso, nunca mexe no settings.
        var menuSet = document.getElementById('fkSettingsMenu');
        if (menuSet) {
            var obs = new MutationObserver(function () {
                if (aberto && visivel(menuSet)) fechar();
            });
            obs.observe(menuSet, { attributes: true, attributeFilter: ['hidden', 'style', 'class'] });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
