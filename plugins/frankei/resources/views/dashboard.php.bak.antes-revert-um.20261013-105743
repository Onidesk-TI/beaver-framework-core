<script>
/* FK_LANG_TAB_HOOK — liga os toggles de idioma ao painel de settings */
(function () {
  'use strict';

  function bindToggles() {
    var toggles = document.querySelectorAll('.fk-lang-toggle');
    if (!toggles.length) return 0;
    var n = 0;
    toggles.forEach(function (b) {
      if (b.dataset.fkBound === '1') return;
      b.dataset.fkBound = '1';
      b.addEventListener('click', function () {
        var lang = b.dataset.lang;
        if (window.FrankeiI18n && typeof window.FrankeiI18n.setLang === 'function') {
          window.FrankeiI18n.setLang(lang);
        } else if (typeof window.frankeiSetLang === 'function') {
          window.frankeiSetLang(lang);
        }
      });
      n++;
    });
    if (window.FrankeiI18n && typeof window.FrankeiI18n.toggle === 'function') {
      window.FrankeiI18n.toggle();
    }
    return n;
  }

  // Sempre que se clica numa tab de settings, rebind
  document.addEventListener('click', function (e) {
    var btn = e.target.closest ? e.target.closest('.fk-settings-tab') : null;
    if (btn && btn.dataset.settingsTab === 'language') {
      setTimeout(bindToggles, 30);
    }
  }, true);

  // E quando o painel de settings abre pela primeira vez
  var obs = new MutationObserver(function () {
    if (document.querySelector('.fk-lang-toggle:not([data-fk-bound])')) {
      bindToggles();
    }
  });
  obs.observe(document.body, { childList: true, subtree: true });

  // Tentar já
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { setTimeout(bindToggles, 400); });
  } else {
    setTimeout(bindToggles, 400);
  }
})();
</script>


<script>
/* FK_LANG_CHIP_JS — chip de idioma no topbar */
(function () {
  'use strict';

  function setChipLabel(lang) {
    var flags = { pt: '\uD83C\uDDF5\uD83C\uDDF9', en: '\uD83C\uDDEC\uD83C\uDDE7', fr: '\uD83C\uDDEB\uD83C\uDDF7', es: '\uD83C\uDDEA\uD83C\uDDF8' };
    var codes = { pt: 'PT', en: 'EN', fr: 'FR', es: 'ES' };
    var f = document.getElementById('fkLangChipFlag');
    var c = document.getElementById('fkLangChipCode');
    if (f) f.textContent = flags[lang] || flags.pt;
    if (c) c.textContent = codes[lang] || 'PT';

    // Marcar o option ativo no dropdown
    document.querySelectorAll('.fk-lang-option').forEach(function (o) {
      var check = o.querySelector('.fk-lang-opt-check');
      if (check) check.textContent = (o.dataset.lang === lang) ? '\u2713' : '';
      o.classList.toggle('active', o.dataset.lang === lang);
    });
  }

  function fechar() {
    var dd = document.getElementById('fkLangDropdown');
    if (dd) dd.hidden = true;
  }

  function ligar() {
    var btn = document.getElementById('fkLangChip');
    var dd  = document.getElementById('fkLangDropdown');
    if (!btn || !dd || btn.dataset.fkBound === '1') return;
    btn.dataset.fkBound = '1';

    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      dd.hidden = !dd.hidden;
    });

    dd.querySelectorAll('.fk-lang-option').forEach(function (opt) {
      opt.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var lang = opt.dataset.lang;
        if (window.FrankeiI18n && typeof window.FrankeiI18n.setLang === 'function') {
          window.FrankeiI18n.setLang(lang);
        } else if (typeof window.frankeiSetLang === 'function') {
          window.frankeiSetLang(lang);
        }
        setChipLabel(lang);
        fechar();
      });
    });

    document.addEventListener('click', function (e) {
      if (!dd.hidden && !e.target.closest('#fkLangChipWrap')) fechar();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') fechar();
    });

    // Aplicar label inicial
    var cur = 'pt';
    if (window.FrankeiI18n && typeof window.FrankeiI18n.getLang === 'function') {
      cur = window.FrankeiI18n.getLang();
    } else {
      try { cur = localStorage.getItem('frankei:lang') || 'pt'; } catch (_) {}
    }
    setChipLabel(cur);

    // Se o idioma mudar por outro lado, actualizar o chip
    window.addEventListener('frankei:lang', function (ev) {
      if (ev.detail && ev.detail.lang) setChipLabel(ev.detail.lang);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { setTimeout(ligar, 300); });
  } else {
    setTimeout(ligar, 300);
  }
})();
</script>

