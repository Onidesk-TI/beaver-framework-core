    <script>
        (function() {
            var btn = document.getElementById('fkDemoBtn');
            var overlay = document.getElementById('fkDemoOverlay');
            var close = document.getElementById('fkDemoClose');
            var form = document.getElementById('fkDemoForm');
            var submit = document.getElementById('fkDemoSubmit');
            var errEl = document.getElementById('fkDemoErro');
            var okEl = document.getElementById('fkDemoOk');

            if (!btn || !overlay || !form) return;

            function open() {
                overlay.classList.add('open');
                setTimeout(function() {
                    document.getElementById('fkDemoEmail').focus();
                }, 200);
            }

            function closeM() {
                overlay.classList.remove('open');
            }

            btn.addEventListener('click', open);
            close.addEventListener('click', closeM);
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) closeM();
            });
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeM();
            });

            form.addEventListener('submit', function(e) {
                e.preventDefault();
                errEl.hidden = true;
                okEl.hidden = true;
                submit.disabled = true;
                submit.innerHTML = 'A enviar... <span class="fk-btn-arrow">⏳</span>';

                var fd = new FormData(form);

                fetch('/api/frankei/request-demo', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    })
                    .then(function(r) {
                        return r.json();
                    })
                    .then(function(data) {
                        if (data.ok) {
                            okEl.hidden = false;
                            okEl.textContent = data.mensagem || 'Pedido recebido. Entramos em contacto em breve.';
                            form.reset();
                            submit.innerHTML = 'Enviar novamente <span class="fk-btn-arrow">→</span>';
                            submit.disabled = false;
                            setTimeout(closeM, 3500);
                        } else {
                            errEl.hidden = false;
                            errEl.textContent = data.erro || 'Erro desconhecido.';
                            submit.innerHTML = 'Tentar de novo <span class="fk-btn-arrow">→</span>';
                            submit.disabled = false;
                        }
                    })
                    .catch(function(err) {
                        errEl.hidden = false;
                        errEl.textContent = 'Erro de rede: ' + err.message;
                        submit.innerHTML = 'Tentar de novo <span class="fk-btn-arrow">→</span>';
                        submit.disabled = false;
                    });
            });
        })();
    </script>


<script>
/* ════════ Form principal — pedir chave por email ════════ */
(function () {
    var form  = document.getElementById('fkFormTrial');
    var btn   = document.getElementById('fkSubmitBtn');
    var errEl = document.getElementById('fkErro');
    var okEl  = document.getElementById('fkOk');

    if (!form) return;

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        errEl.hidden = true;
        okEl.hidden  = true;

        // ── Verificar se está autenticado ──
        var isAuthed = <?= json_encode(\App\Services\UserService::autenticado()) ?>;

        // Se NÃO está autenticado → abre modal de pedir chave
        if (!isAuthed) {
            document.getElementById('fkDemoBtn').click();
            return;
        }

        // ── Aqui está autenticado — validar ficheiros ──
        var marked = document.querySelectorAll('#fkFilesList input[type=checkbox]:checked').length;
        if (marked > 5) {
            errEl.hidden = false;
            errEl.textContent = 'Plano grátis: máximo 5 ficheiros.';
            return;
        }
        if (marked === 0) {
            errEl.hidden = false;
            errEl.textContent = 'Seleciona pelo menos 1 ficheiro.';
            return;
        }

        btn.disabled = true;
        var originalText = btn.innerHTML;
        btn.innerHTML = 'A enviar... <span class="fk-btn-arrow">⏳</span>';

        var fd = new FormData(form);

        fetch('/api/frankei/request-trial', {
            method: 'POST',
            body: fd,
            credentials: 'same-origin'
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.ok) {
                okEl.hidden = false;
                if (data.email_enviado) {
                    okEl.innerHTML = '✅ Email enviado para <b>' + data.email + '</b>.<br><small>Verifica a caixa de entrada.</small>';
                } else {
                    okEl.innerHTML = '⚠️ Email falhou. <b>Chave: ' + (data.password || '?') + '</b>';
                }
                btn.innerHTML = 'Pedir novamente <span class="fk-btn-arrow">→</span>';
                btn.disabled = false;
            } else {
                errEl.hidden = false;
                errEl.textContent = data.erro || 'Erro desconhecido.';
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        })
        .catch(function (err) {
            errEl.hidden = false;
            errEl.textContent = 'Erro de rede: ' + err.message;
            btn.innerHTML = originalText;
            btn.disabled = false;
        });
    });
})();
</script>

