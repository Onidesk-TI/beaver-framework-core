// Painel de configurações do Beaver Report
// ═══════════════════════════════════════════════════════════
(function initBeaverConfig(){
    // ─── Chaves separadas por tab ───
    var K_VISUAL = 'frankei:beaverReport:visual';
    var K_TABLE  = 'frankei:beaverReport:table';
    var K_THEME  = 'frankei:beaverReport:theme';

    var D_VISUAL = {
        icons: true, gradient: true, anim: true,
        count: true, group: false, module: true, tooltip: true
    };
    var D_TABLE = {
        density: 'normal',
        orderBy: 'coverage',
        hide100: false, hide0: false,
        columns: { crap: true, loc: true }
    };
    var D_THEME = 'auto';

    function load(key, defaults) {
        try {
            var raw = localStorage.getItem(key);
            if (!raw) return JSON.parse(JSON.stringify(defaults));
            var parsed = JSON.parse(raw);
            if (typeof defaults === 'object' && defaults !== null) {
                return Object.assign({}, defaults, parsed);
            }
            return parsed;
        } catch(e) { return JSON.parse(JSON.stringify(defaults)); }
    }
    function save(key, value) {
        try { localStorage.setItem(key, JSON.stringify(value)); } catch(e){}
    }

    function applyToCoverageView() {
        var cv = document.querySelector('.cv');
        if (!cv) return;

        var visual = load(K_VISUAL, D_VISUAL);
        var table  = load(K_TABLE,  D_TABLE);
        var theme  = load(K_THEME,  D_THEME);

        // Limpar classes antigas
        cv.className = cv.className.replace(/\bcv-opt-\S+/g, '').trim();
        cv.className = cv.className.replace(/\bcv-density-\S+/g, '').trim();
        cv.className = cv.className.replace(/\bcv-theme-\S+/g, '').trim();

        // Visual
        Object.keys(visual).forEach(function(k){
            if (visual[k]) cv.classList.add('cv-opt-' + k);
        });

        // Densidade
        cv.classList.add('cv-density-' + table.density);

        // Tema
        cv.classList.add('cv-theme-' + theme);

        // Colunas
        if (!table.columns.crap) cv.classList.add('cv-hide-crap');
        else cv.classList.remove('cv-hide-crap');
        if (!table.columns.loc) cv.classList.add('cv-hide-loc');
        else cv.classList.remove('cv-hide-loc');

        // Filtros
        if (table.hide100) cv.classList.add('cv-hide-100');
        else cv.classList.remove('cv-hide-100');
        if (table.hide0) cv.classList.add('cv-hide-0');
        else cv.classList.remove('cv-hide-0');
    }

    // ─── Presets ───
    var PRESETS = {
