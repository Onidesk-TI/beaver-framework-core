  function initTerminal(){
    var input = document.getElementById('fkTermInput');
    var btn   = document.getElementById('fkTermRunBtn');
    if (!input) return;

    // Enter → executa
    input.addEventListener('keydown', function(e){
      if (e.key === 'Enter'){
        e.preventDefault();
        execTermCommand(input.value.trim());
        input.value = '';
      } else if (e.key === 'ArrowUp'){
        e.preventDefault();
        if (termHistory.length && termHistIdx < termHistory.length - 1){
          termHistIdx++;
          input.value = termHistory[termHistory.length - 1 - termHistIdx];
        }
      } else if (e.key === 'ArrowDown'){
        e.preventDefault();
        if (termHistIdx > 0){
          termHistIdx--;
          input.value = termHistory[termHistory.length - 1 - termHistIdx];
        } else {
          termHistIdx = -1;
          input.value = '';
        }
      } else if (e.ctrlKey && (e.key === 'l' || e.key === 'L')){
        e.preventDefault();
        termClear();
      }
    });

    // Botão ▶
    if (btn){
      btn.addEventListener('click', function(){
        execTermCommand(input.value.trim());
        input.value = '';
      });
    }
  }

  // FK_STATCARD_TEST: preencher o card Estado com o resultado de "beaver test"
  function fkParseBeaverTest(output, elapsed_ms) {
    output = String(output || '');
    var stats = { files: 0, passed: 0, failed: 0, duration: '\u2014' };

    // Ficheiros = linhas que comecam com PASS/FAIL (Pest) ou dots (PHPUnit)
    var mFiles = output.match(/^\s*(PASS|FAIL)\b/gm);
    if (mFiles) stats.files = mFiles.length;

    // Testes totais (Pest: "Tests: 14 passed" | PHPUnit: "Tests: 14, Assertions:...")
    var mTests = output.match(/Tests:\s+(\d+)/);
    if (mTests) stats.passed = parseInt(mTests[1], 10) || 0;

    // Falhas (Pest: "2 failed" | PHPUnit: "Failures: 2")
    var mFail = output.match(/(\d+)\s+failed/) || output.match(/Failures:\s*(\d+)/);
    if (mFail) stats.failed = parseInt(mFail[1], 10) || 0;

    // Erros (PHPUnit: "Errors: N") — somar as falhas
    var mErr = output.match(/Errors:\s*(\d+)/);
    if (mErr) stats.failed += parseInt(mErr[1], 10) || 0;

    // OK sem erros (PHPUnit: "OK (14 tests, 41 assertions)")
    var mOk = output.match(/OK\s*\((\d+)\s+tests?/);
    if (mOk) stats.passed = parseInt(mOk[1], 10) || 0;

    // Duracao: usar elapsed_ms do backend
    if (elapsed_ms) stats.duration = elapsed_ms + 'ms';

    return stats;
  }

  function fkAplicarStatCard(stats) {
    if (!stats) return;
    try {
      var d = document.getElementById('fkStatDbs');
      var t = document.getElementById('fkStatTotal');
      var m = document.getElementById('fkStatTime');

      var filesTxt = stats.files > 0
        ? stats.files + ' ficheiro' + (stats.files > 1 ? 's' : '') + ' \u00b7 ' + stats.passed + ' testes'
        : stats.passed + ' testes';
      var failsTxt = stats.failed > 0 ? stats.failed + ' falha' + (stats.failed > 1 ? 's' : '') : '0 falhas';

      if (d) d.textContent = filesTxt;
      if (t) t.textContent = failsTxt;
      if (m) m.textContent = stats.duration;

      // Cor no card de falhas
      if (t) {
        t.style.color = stats.failed > 0 ? '#b91c1c' : '#047857';
        t.style.fontWeight = '700';
      }

      try { localStorage.setItem('fk:statcard:last', JSON.stringify(stats)); } catch (_) {}
    } catch (_) {}
  }

  function fkCarregarStatCardStorage() {
    try {
      var raw = localStorage.getItem('fk:statcard:last');
      if (!raw) return;
      var s = JSON.parse(raw);
      // So aplicar se o card ainda estiver em "—"
      var d = document.getElementById('fkStatDbs');
      if (d && d.textContent === '\u2014') fkAplicarStatCard(s);
    } catch (_) {}
  }

  function execTermCommand(cmd, opts){
    opts = opts || {};
    if (!cmd) return;

    // ─── Comandos locais (nao vao ao backend) ───
    var fkLocalClearHandled = false;
    (function handleLocalCommands() {
      var local = String(cmd).trim().toLowerCase();
      if (local === 'clear' || local === 'cls') {
        // Guarda no historico
        termHistory.push(cmd);
        termHistIdx = -1;
        // Limpa o ecra
        if (typeof termClear === 'function') {
          termClear();
        } else {
          var t = document.getElementById('fkTerminal');
          if (t) t.innerHTML = '';
        }
        fkLocalClearHandled = true;
      }
    })();
    if (fkLocalClearHandled) return;

    // Injetar --engine se for 'beaver test' e houver preferência
    if (/^beaver\s+test\b/.test(cmd) && !/--engine=/.test(cmd)) {
      try {
        // Prioridade: global (escolha atual) → localStorage (fallback)
        var eng = window.FK_TEST_ENGINE || localStorage.getItem('frankei:testEngine');
        if (eng === 'pest' || eng === 'phpunit') {
          cmd = cmd + ' --engine=' + eng;
        }
      } catch(e){}
    }

    // Guardar histórico
    termHistory.push(cmd);
    termHistIdx = -1;

    // Echo do comando
    termLine('fk-term-info', '$ ' + cmd);
    termStatus('a executar...', 'running');

    var input = document.getElementById('fkTermInput');
    var btn   = document.getElementById('fkTermRunBtn');
    if (input) input.disabled = true;
    if (btn)   btn.disabled = true;

    var _ok = false;
    fetchJson('/api/frankei/terminal/exec', { command: cmd })
      .then(function(r){
        var output = (r && r.output) || '';
        var lines  = output.split('\n');

        // Escrever cada linha

        // FK_STATCARD_TEST: se for beaver test, preencher o card Estado
        if (/^beaver\s+test\b/.test(cmd)) {
          try {
            var _stats = fkParseBeaverTest(output, r && r.elapsed_ms);
            fkAplicarStatCard(_stats);
          } catch (e) { console.warn('[FK_STATCARD_TEST] erro:', e); }
        }
        lines.forEach(function(line){
          if (line === '') {
            termLine('', '');
            return;
          }
          var cls = termClassForLine(line);
          termLine(cls, line);
        });

        // Resumo
        termLine('', '');
        if (r && r.ok){
          _ok = true;
          termLine('fk-term-ok', '✓ concluído em ' + r.elapsed_ms + 'ms');
          termStatus('pronto', 'done');
        } else {
          var err = (r && r.error) || 'erro desconhecido';
          termLine('fk-term-err', '✗ ' + err);
          termStatus('erro', 'err');
        }
      })
      .catch(function(e){
        termLine('fk-term-err', '✗ Falha: ' + (e.message || e));
        termStatus('erro', 'err');
      })
      .finally(function(){
        if (input) { input.disabled = false; input.focus(); }
        if (btn)   { btn.disabled = false; }

        // Se foi um teste, mostrar botão 'Report' com setas blink
        if (/^beaver\s+test\b/.test(cmd)) {
          var reportBtn = document.getElementById('fkTermReportBtn');
          if (reportBtn) {
            reportBtn.style.display = 'inline-flex';
            reportBtn.classList.add('fk-arrow-on');
          }
        }

        if (typeof opts.onDone === 'function') opts.onDone(_ok);
      });
  }

  /* Detetar a "cor" de cada linha conforme o conteúdo */
  function termClassForLine(line){
    var t = line.trim();
    if (t === '') return '';
    if (/✗|FAIL|Error|error|erro|failed|Exception/.test(line)) return 'fk-term-err';
    if (/✓|OK|passed|sucesso|passou/.test(line))               return 'fk-term-ok';
    if (/⚠|Warning|warn|skip/.test(line))                      return 'fk-term-warn';
    if (/^\$/.test(t))                                         return 'fk-term-info';
    return '';
  }

