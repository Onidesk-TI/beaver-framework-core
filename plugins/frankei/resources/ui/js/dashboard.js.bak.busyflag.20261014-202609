// FK_STATCARD_APPLY — preencher o card "Estado" em qualquer fluxo
(function () {
  'use strict';
  var KEY = 'fk:statcard:last';

  function aplicar(stats) {
    if (!stats) return;
    try {
      var d = document.getElementById('fkStatDbs');
      var t = document.getElementById('fkStatTotal');
      var m = document.getElementById('fkStatTime');
      if (d) d.textContent = (stats.databases || 0) + ' BD \u00b7 ' + (stats.files_scanned || 0) + ' ficheiros';
      if (t) t.textContent = stats.total != null ? String(stats.total) : '0';
      if (m) m.textContent = (stats.elapsed_ms || 0) + 'ms';
    } catch (e) {}
  }

  function guardar(stats) {
    try { localStorage.setItem(KEY, JSON.stringify(stats)); } catch (_) {}
  }

  // 1) Tentar aplicar do localStorage ao carregar
  function aplicarDoStorage() {
    try {
      var raw = localStorage.getItem(KEY);
      if (!raw) return;
      var s = JSON.parse(raw);
      aplicar(s);
    } catch (_) {}
  }

  // 2) Wrapper: interceptar handleScanSuccess quando a funcao for definida
  //    (ela e interna ao IIFE do dashboard.js, entao usamos polling)
  var tentativas = 0;
  var maxTent = 100; // ate ~30s
  var timer = setInterval(function () {
    tentativas++;

    // Tentar aplicar do storage (caso a pagina ja tenha carregado antes)
    if (!document.getElementById('fkStatDbs')) return;
    if (document.getElementById('fkStatDbs').textContent === '\u2014') {
      aplicarDoStorage();
    }

    // Se por acaso o dashboard expuser handleScanSuccess ou state globalmente,
    // interceptamos
    if (window.state && window.state.result && window.state.result.stats) {
      aplicar(window.state.result.stats);
      guardar(window.state.result.stats);
    }

    if (tentativas >= maxTent) clearInterval(timer);
  }, 300);

  // 3) Watch: se o innerText dos stats ficar com valor real, guardar em localStorage
  //    Assim, na proxima vez que entrar, o card mostra o ultimo resultado
  document.addEventListener('DOMContentLoaded', function () {
    var d = document.getElementById('fkStatDbs');
    if (!d) return;

    var observer = new MutationObserver(function () {
      var dTxt = document.getElementById('fkStatDbs')?.textContent || '';
      var tTxt = document.getElementById('fkStatTotal')?.textContent || '';
      var mTxt = document.getElementById('fkStatTime')?.textContent || '';

      // So guardar quando tiver valores reais (nao "-" nem "TESTE")
      if (dTxt === '\u2014' || /TESTE/.test(dTxt)) return;
      if (!/\d/.test(dTxt)) return;

      var m = dTxt.match(/(\d+)\s*BD\s*[\u00b7\u2022]\s*(\d+)/);
      var stats = {
        databases: m ? parseInt(m[1]) : 0,
        files_scanned: m ? parseInt(m[2]) : 0,
        total: parseInt(tTxt) || 0,
        elapsed_ms: parseInt(mTxt) || 0
      };
      guardar(stats);
    });

    observer.observe(d, { childList: true, characterData: true, subtree: true });
    observer.observe(document.getElementById('fkStatTotal') || document.body, { childList: true, characterData: true, subtree: true });
    observer.observe(document.getElementById('fkStatTime')  || document.body, { childList: true, characterData: true, subtree: true });
  });

  // 4) Aplicar do storage imediatamente (caso o DOM ja exista)
  if (document.readyState !== 'loading') {
    setTimeout(aplicarDoStorage, 200);
  } else {
    document.addEventListener('DOMContentLoaded', function () {
      setTimeout(aplicarDoStorage, 200);
    });
  }
})();

