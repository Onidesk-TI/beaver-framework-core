      'pest':    { icon: '🐀', label: 'Pest',      color: '#a06ef5' },
      'phpunit': { icon: '🐘', label: 'PHPUnit',   color: '#7e9bfa' },
      'none':    { icon: '⚠️', label: 'sem motor', color: '#e88c3a' }
    };

    function applyBadge(engine){
      var conf = MAP[engine] || MAP.none;
      icon.textContent  = conf.icon;
      label.textContent = conf.label;
      badge.style.color       = conf.color;
      badge.style.borderColor = conf.color + '66';
      badge.style.background  = conf.color + '1a';
      badge.title = 'Motor de testes: ' + conf.label + ' (clica para alternar)';
    }

    // 1. Ler preferência local
    var saved = null;
    try { saved = localStorage.getItem('frankei:testEngine'); } catch(e){}

    // 2. Pedir metadados
    fetch('/api/frankei/terminal/metadata', {
      headers: { 'Accept': 'application/json' },
      credentials: 'include'
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
      var meta = (d && d.test_engine) || {};
      var available = meta.available || {};

      // Desativar opções não disponíveis
      document.querySelectorAll('.fk-term-engine-opt').forEach(function(btn){
        var eng = btn.dataset.engine;
        if (!available[eng]) {
          btn.disabled = true;
          btn.title = 'Não instalado';
        }
      });

      // Marcar o atual
      var current = (saved && available[saved]) ? saved : (meta.current || 'none');
      window.FK_TEST_ENGINE = current;
      window.FK_TEST_ENGINES_AVAILABLE = available;   // {pest: bool, phpunit: bool}
      applyBadge(current);
      markActive(current);

      // Se só um motor está disponível, esconde o toggle (menu)
      var soUm = (available.pest && !available.phpunit) || (!available.pest && available.phpunit);
      if (soUm && badge) {
        badge.style.cursor = 'default';
        badge.title = 'Motor de testes: ' + (MAP[current] ? MAP[current].label : current);
      }
    })
    .catch(function(e){
      console.warn('[engine] metadata falhou:', e);
      applyBadge(saved || 'none');
    });

    // 3. Marcar a opção ativa no menu
    function markActive(engine){
      document.querySelectorAll('.fk-term-engine-opt').forEach(function(btn){
        btn.setAttribute('aria-current', btn.dataset.engine === engine ? 'true' : 'false');
      });
    }

    // 4. Abrir/fechar menu
