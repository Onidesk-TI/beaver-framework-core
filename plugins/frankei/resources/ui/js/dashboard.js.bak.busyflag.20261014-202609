      // Se clicou numa opção, não fechar
      if (e.target.closest('.fk-term-engine-opt')) return;
      badge.classList.toggle('open');
    });

    // Fechar ao clicar fora
    document.addEventListener('click', function(e){
      if (!badge.contains(e.target)) badge.classList.remove('open');
    });

    // 5. Escolher motor
    if (menu) {
      menu.querySelectorAll('.fk-term-engine-opt').forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.stopPropagation();
          var eng = btn.dataset.engine;
