                    save(K_VISUAL, D_VISUAL);
                    save(K_TABLE,  D_TABLE);
                    save(K_THEME,  D_THEME);
                    applyToCoverageView();
                    // Recarregar painel
                    closePanel();
                    var old = document.getElementById('fkBeaverConfigPanel');
                    var oldBd = document.getElementById('fkBeaverConfigBackdrop');
                    if (old) old.remove();
                    if (oldBd) oldBd.remove();
                    buildPanel();
                    var newPanel = document.getElementById('fkBeaverConfigPanel');
                    var newBd = document.getElementById('fkBeaverConfigBackdrop');
                    if (newPanel && newBd) {
                        newPanel.classList.add('open');
                        newBd.classList.add('open');
                        if (btn) btn.classList.add('active');
                    }
                } else {
                    applyPreset(p);
                    closePanel();
                    var old2 = document.getElementById('fkBeaverConfigPanel');
                    var oldBd2 = document.getElementById('fkBeaverConfigBackdrop');
                    if (old2) old2.remove();
                    if (oldBd2) oldBd2.remove();
                    buildPanel();
                    var newPanel2 = document.getElementById('fkBeaverConfigPanel');
                    var newBd2 = document.getElementById('fkBeaverConfigBackdrop');
                    if (newPanel2 && newBd2) {
                        newPanel2.classList.add('open');
                        newBd2.classList.add('open');
                        if (btn) btn.classList.add('active');
                    }
                }
            });
        });

