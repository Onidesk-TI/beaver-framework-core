            var backdrop = document.getElementById('fkBeaverConfigBackdrop');
            var panel    = document.getElementById('fkBeaverConfigPanel');
            backdrop.classList.add('open');
            panel.classList.add('open');
            e.target.classList.add('active');
        }
    });

    // Aplicar sempre que o CoverageView renderizar
    var origRender = window.CoverageView && window.CoverageView.render;
    if (origRender) {
        window.CoverageView.render = function(container, data) {
            origRender.call(window.CoverageView, container, data);
            setTimeout(applyToCoverageView, 50);
        };
    }
})();

// FK_STATCARD_BOOT: aplicar valor guardado ao carregar
(function () {
  function boot() {
    try {
      var raw = localStorage.getItem('fk:statcard:last');
      if (!raw) return;
      var s = JSON.parse(raw);
      var d = document.getElementById('fkStatDbs');
      if (d && (d.textContent === '\u2014' || d.textContent === '')) {
        // Copiar a logica do fkAplicarStatCard
        var t = document.getElementById('fkStatTotal');
        var m = document.getElementById('fkStatTime');
        var filesTxt = s.files > 0
          ? s.files + ' ficheiro' + (s.files > 1 ? 's' : '') + ' \u00b7 ' + s.passed + ' testes'
          : s.passed + ' testes';
        var failsTxt = s.failed > 0 ? s.failed + ' falha' + (s.failed > 1 ? 's' : '') : '0 falhas';
        if (d) d.textContent = filesTxt;
        if (t) {
          t.textContent = failsTxt;
          t.style.color = s.failed > 0 ? '#b91c1c' : '#047857';
          t.style.fontWeight = '700';
        }
        if (m) m.textContent = s.duration;
      }
    } catch (_) {}
  }
  // FK_TABS_RESET_BOOT: garantir tabs base quando ainda nao ha ficheiros
  (function () {
    function init() {
      try {
        if (typeof reportRebuildTabs === 'function' && (!reportState || !reportState.files || reportState.files.length === 0)) {
          reportRebuildTabs();
        }
      } catch (_) {}
    }
    // FK_TABS_BIND_BOOT
  (function () {
    function init() {
      try {
        if (typeof reportBindCheckboxes === 'function') reportBindCheckboxes();
        if (typeof reportRebuildTabs === 'function') reportRebuildTabs();
      } catch (_) {}
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { setTimeout(init, 500); });
    } else {
      setTimeout(init, 500);
    }
  })();

  if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { setTimeout(init, 600); });
    } else {
      setTimeout(init, 600);
    }
  })();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { setTimeout(boot, 400); });
  } else {
    setTimeout(boot, 400);
  }
})();

// FK_RENDERTABS_BOOT: reforço em runtime + bloqueio de cliques
(function () {
  'use strict';
  var KEEP = 'tests';

  function reforcar() {
    var tabs = document.querySelectorAll('#fkTabs .fk-tab');
    if (!tabs.length) return;
    tabs.forEach(function (t) {
      if (t.dataset.tab === KEEP) {
        t.classList.add('active');
        t.classList.remove('locked');
        t.removeAttribute('disabled');
      } else {
        t.classList.remove('active');
        t.classList.add('locked');
        t.setAttribute('disabled', 'disabled');
        if (!t.querySelector('.fk-tab-badge.pro')) {
          // Remover badge antigo (não-pro)
          var old = t.querySelector('.fk-tab-badge');
          if (old && !old.classList.contains('pro')) old.remove();
          if (!t.querySelector('.fk-tab-badge.pro')) {
            var b = document.createElement('span');
            b.className = 'fk-tab-badge pro';
            b.textContent = 'PRO';
            t.appendChild(b);
          }
        }
      }
    });
  }

  // Aplicar múltiplas vezes (cobre reconstruções)
  var i = 0;
  var iv = setInterval(function () {
    reforcar();
    if (++i > 40) clearInterval(iv);
  }, 500);

  // MutationObserver focado em #fkTabs
  function observar() {
    var el = document.getElementById('fkTabs');
    if (!el) { setTimeout(observar, 300); return; }
    var obs = new MutationObserver(function () { reforcar(); });
    obs.observe(el, { childList: true, subtree: true });
  }
  observar();

  // Bloquear cliques (capture)
  document.addEventListener('click', function (e) {
    var t = e.target.closest && e.target.closest('#fkTabs .fk-tab');
    if (t && t.dataset.tab !== KEEP) {
      e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
      t.style.transition = 'none';
      t.style.boxShadow = '0 0 0 3px rgba(239,68,68,.5) inset';
      setTimeout(function () { t.style.transition = ''; t.style.boxShadow = ''; }, 300);
    }
  }, true);
})();

// FK_SUBTABS_BOOT: reforço em runtime + bloqueio de cliques
(function () {
  'use strict';
  var KEEP = 'structure';

  function reforcar() {
    var tabs = document.querySelectorAll('#fkSubtabs .fk-subtab, nav.fk-subtabs .fk-subtab');
    if (!tabs.length) return;
    tabs.forEach(function (t) {
      if (t.dataset.subtab === KEEP) {
        t.classList.remove('locked');
        t.removeAttribute('disabled');
      } else {
        t.classList.add('locked');
        t.setAttribute('disabled', 'disabled');
      }
    });
  }

  // Aplicar várias vezes
  var i = 0;
  var iv = setInterval(function () {
    reforcar();
    if (++i > 40) clearInterval(iv);
  }, 500);

  // MutationObserver
  function observar() {
    var el = document.getElementById('fkSubtabs');
    if (!el) { setTimeout(observar, 300); return; }
    var obs = new MutationObserver(function () { reforcar(); });
    obs.observe(el, { childList: true, subtree: true });
  }
  observar();

  // Bloquear cliques com blink
  document.addEventListener('click', function (e) {
    var t = e.target.closest && e.target.closest('#fkSubtabs .fk-subtab, nav.fk-subtabs .fk-subtab');
    if (!t) return;
    if (t.dataset.subtab !== KEEP) {
      e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
      // Blink vermelho
      t.classList.remove('fk-blink-denied');
      void t.offsetWidth;
      t.classList.add('fk-blink-denied');
      setTimeout(function () { t.classList.remove('fk-blink-denied'); }, 400);
      return false;
    }
  }, true);
})();
