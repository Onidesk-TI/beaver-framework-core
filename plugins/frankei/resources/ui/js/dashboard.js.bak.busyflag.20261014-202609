    ]
  };

  /* ══════════════════════════════════════════════════════
     ESTADO
     ══════════════════════════════════════════════════════ */

  /* FK_HASH_INIT */
  var state = {
    activeTab:    (function(){
      var _h = (location.hash || '').replace(/^#/, '').split('/')[0];
      var _ok = ['all','db','security','passwords','quality','tests','performance'];
      return _ok.indexOf(_h) !== -1 ? _h : 'db';
    })(),
    activeSubtab: 'all',
    result:       null,     // findings agregados
    filters:      { dbs: {}, sev: {}, cat: {} },
    busy:         false
  };

  // (debug) expor state para o console
  window.__frankeiState = state;

  var $  = function(s, r){ return (r||document).querySelector(s); };
  var $$ = function(s, r){ return Array.prototype.slice.call((r||document).querySelectorAll(s)); };

  /* ══════════════════════════════════════════════════════
     ROUTING POR HASH
     ══════════════════════════════════════════════════════ */

  function parseHash(){
    var h = (location.hash || '').replace(/^#/, '');
    if (!h) return { tab: 'db', sub: 'all' };

    var parts = h.split('/');
    var tab   = parts[0] || 'db';
    var sub   = parts[1] || 'all';

    // Validar
    var tabOk = TABS.some(function(t){ return t.id === tab && t.enabled; });
    if (!tabOk) tab = 'db';

    var subOk = SUBTABS[tab] && SUBTABS[tab].some(function(s){ return s.id === sub && s.enabled; });
    if (!subOk) sub = 'all';

    return { tab: tab, sub: sub };
  }

  function updateHash(tab, sub){
    var hash = '#' + tab;
    if (sub && sub !== 'all') hash += '/' + sub;
    if (location.hash !== hash) {
      history.replaceState(null, '', hash);
    }
  }

  window.addEventListener('hashchange', function(){
    var r = parseHash();
    state.activeTab    = r.tab;
    state.activeSubtab = r.sub;
    renderAll();
  });


  /* ══════════════════════════════════════════════════════
     RENDER — TABS PRINCIPAIS
     ══════════════════════════════════════════════════════ */

  function renderTabs(){
    var el = $('#fkTabs');
    if (!el) return;
    el.innerHTML = '';

    TABS.forEach(function(tab){
      var btn = document.createElement('button');
      // FK_RENDERTABS_LOCK: só 'tests' fica ativo; outras ficam locked+PRO
      var _soTests = (tab.id === 'tests');
      btn.className = 'fk-tab'
        + ((_soTests && tab.id === state.activeTab) ? ' active' : '')
        + (_soTests ? '' : ' locked');
      if (!_soTests) {
        btn.setAttribute('disabled', 'disabled');
      }
      btn.setAttribute('role', 'tab');
      btn.setAttribute('data-tab', tab.id);
      if (!tab.enabled) btn.disabled = true;

      var badgeHtml = '';
      if (!tab.enabled) {
        badgeHtml = '<span class="fk-tab-badge soon">soon</span>';
      } else {
        var count = countForTab(tab.id);
        if (count > 0 || tab.id === 'db') {
          var cls = 'fk-tab-badge';
          if (count > 0) cls += ' has-crit';
          badgeHtml = '<span class="' + cls + '">' + count + '</span>';
        }
      }

      btn.innerHTML =
        '<span class="fk-tab-icon">' + tab.icon + '</span>' +
        '<span>' + tab.label + '</span>' +
        badgeHtml;

      if (tab.enabled) {
        btn.addEventListener('click', function(){
          state.activeTab    = tab.id;
          state.activeSubtab = 'all';
          updateHash(tab.id, 'all');
          renderAll();
        });
      }

      el.appendChild(btn);
    });
  }

  /* ══════════════════════════════════════════════════════
     RENDER — SUB-TABS
     ══════════════════════════════════════════════════════ */

  function renderSubtabs(){
    var el   = $('#fkSubtabs');
    var subs = SUBTABS[state.activeTab] || [];

    if (!subs.length){
      el.style.display = 'none';
      el.innerHTML = '';
      return;
    }

    el.style.display = '';
    el.innerHTML = '';

    subs.forEach(function(sub){
      var btn = document.createElement('button');
      // FK_SUBTABS_LOCK: só 'structure' fica ativo; outras ficam locked
      var _soStructure = (sub.id === 'structure');
      btn.className = 'fk-subtab'
        + ((_soStructure && sub.id === state.activeSubtab) ? ' active' : '')
        + (_soStructure ? '' : ' locked');
      if (!_soStructure) {
        btn.setAttribute('disabled', 'disabled');
      }
      btn.setAttribute('data-subtab', sub.id);
      if (!sub.enabled) btn.disabled = true;

      var badgeHtml = '';
      if (!sub.enabled) {
        badgeHtml = '<span class="fk-subtab-badge">soon</span>';
      } else {
        var count = countForSubtab(state.activeTab, sub.id);
        if (count > 0) {
          badgeHtml = '<span class="fk-subtab-badge">' + count + '</span>';
        }
      }

      btn.innerHTML = '<span>' + sub.label + '</span>' + badgeHtml;

      if (sub.enabled) {
        btn.addEventListener('click', function(){
          state.activeSubtab = sub.id;
          updateHash(state.activeTab, sub.id);
          renderAll();
        });
      }

      el.appendChild(btn);
    });
  }

  /* ══════════════════════════════════════════════════════
     RENDER — CONTEÚDO (placeholder ou terminal+findings)
     ══════════════════════════════════════════════════════ */

  function renderContent(){
    var tab         = currentTab();
    var placeholder = $('#fkPlaceholder');
    var content     = $('#fkTabContent');

    if (!tab || !tab.enabled){
      // Tab desativada — mostra placeholder
      content.style.display = 'none';
      placeholder.style.display = '';
      renderPlaceholder(tab);
      return;
    }

    // Tab ativa — mostra conteúdo normal
    placeholder.style.display = 'none';
    content.style.display = '';

    // Título do terminal
    var termTitle = $('#fkTermTitle');
    if (termTitle) {
      termTitle.textContent = 'frankei — ' + tab.label.toLowerCase();
    }
  }

  function renderPlaceholder(tab){
    var el = $('#fkPlaceholder');
    if (!el) return;

    if (!tab){
      el.innerHTML =
        '<div class="fk-placeholder-icon">🚧</div>' +
        '<h2>Em breve</h2>' +
        '<p>Esta análise ainda não está disponível. Vai ser adicionada numa próxima atualização.</p>';
      return;
    }

    var items = placeholderItems(tab.id);
    var listHtml = '';
    if (items.length){
      listHtml = '<div class="fk-placeholder-list">' +
        items.map(function(i){ return '<span class="fk-placeholder-item">' + i + '</span>'; }).join('') +
        '</div>';
    }

    el.innerHTML =
      '<div class="fk-placeholder-icon">' + tab.icon + '</div>' +
      '<h2>' + tab.label + '</h2>' +
      '<p>Esta análise está planeada. Aqui vais encontrar:</p>' +
      listHtml;
  }

  function placeholderItems(tabId){
    var MAP = {
      quality:     ['Código morto', 'Complexidade ciclomática', 'Duplicação', 'Code style (PSR-12)', 'Docblocks em falta'],
      tests:       ['Cobertura de testes', 'Ficheiros sem teste', 'Asserts vazios', 'Testes skipados', 'Config PHPUnit'],
      performance: ['N+1 queries', 'Loops com queries', 'SELECT *', 'Cache em falta', 'Includes pesados'],
      config:      ['Variáveis .env', 'Debug em produção', 'HTTPS/Cookies', 'CORS', 'Cabeçalhos de segurança'],
      services:    ['Endpoints API', 'Timeouts', 'Retries', 'Autenticação entre serviços', 'Rate limiting'],
      report:      ['Relatório HTML completo', 'Export PDF/JSON', 'Histórico de análises', 'Comparação entre scans']
    };
    return MAP[tabId] || [];
  }

  /* ══════════════════════════════════════════════════════
     HELPERS — tab/sub atual + contagens
     ══════════════════════════════════════════════════════ */

  function currentTab(){
    for (var i = 0; i < TABS.length; i++){
      if (TABS[i].id === state.activeTab) return TABS[i];
    }
    return null;
  }

  function countForTab(tabId){
    if (!state.result || !state.result.findings) return 0;
    return state.result.findings.filter(function(f){
      return matchesTab(f, tabId);
    }).length;
  }

  function countForSubtab(tabId, subId){
    if (!state.result || !state.result.findings) return 0;
    return state.result.findings.filter(function(f){
      return matchesTab(f, tabId) && matchesSubtab(f, tabId, subId);
    }).length;
  }

  function matchesTab(f, tabId){
    var cat = (f.category || '').toLowerCase();

    if (tabId === 'all')       return true;
    if (tabId === 'db')        return ['structure', 'quality', 'index'].indexOf(cat) !== -1 || !cat;
    if (tabId === 'security')  return ['security', 'vuln', 'xss', 'sqli', 'csrf', 'ssrf', 'xxe', 'lfi', 'cmdi', 'pathtraversal', 'deserialize', 'openredirect'].indexOf(cat) !== -1;
    if (tabId === 'passwords') return ['password', 'auth', 'hash'].indexOf(cat) !== -1;
    if (tabId === 'quality')   return ['style', 'complexity', 'quality'].indexOf(cat) !== -1;
    if (tabId === 'tests')     return ['test', 'tests', 'unit', 'feature'].indexOf(cat) !== -1;
    if (tabId === 'performance') return cat === 'performance';

    return false;
  }

  function matchesSubtab(f, tabId, subId){
    if (subId === 'all') return true;

    var cat = (f.category || '').toLowerCase();
    var s   = (f.scanner  || '').toLowerCase();

    // DB
    if (tabId === 'db'){
      if (subId === 'structure') return cat === 'structure';
      if (subId === 'quality')   return cat === 'quality';
      if (subId === 'indexes')   return cat === 'index' || s.indexOf('index') !== -1 || s.indexOf('fk') !== -1;
    }

    // Security
    if (tabId === 'security'){
      return s.indexOf(subId) !== -1 || cat === subId;
    }

    // Tests
    if (tabId === 'tests'){
      if (subId === 'unit')     return s.indexOf('unit')    !== -1 || cat === 'unit'    || s.indexOf('Unit') !== -1;
      if (subId === 'feature')  return s.indexOf('feature') !== -1 || cat === 'feature' || s.indexOf('Feature') !== -1;
      if (subId === 'coverage') return s.indexOf('coverage') !== -1;
    }

    // Quality
    if (tabId === 'quality'){
      if (subId === 'style')      return cat === 'style'      || s.indexOf('style') !== -1      || s.indexOf('todo') !== -1 || s.indexOf('magic') !== -1 || s.indexOf('suppression') !== -1;
      if (subId === 'complexity') return cat === 'complexity' || s.indexOf('complexity') !== -1 || s.indexOf('long') !== -1 || s.indexOf('nesting') !== -1;
    }

    // Passwords
    if (tabId === 'passwords'){
      if (subId === 'hashes') return s.indexOf('hash') !== -1 || s.indexOf('md5') !== -1;
      if (subId === 'policy') return s.indexOf('policy') !== -1 || s.indexOf('weak') !== -1;
      if (subId === 'incode') return s.indexOf('hardcode') !== -1 || s.indexOf('incode') !== -1;
      if (subId === 'env')    return s.indexOf('env') !== -1;
      if (subId === 'twofa')  return s.indexOf('2fa') !== -1 || s.indexOf('totp') !== -1;
    }

    // Performance
    if (tabId === 'performance'){
      if (subId === 'nplus1')     return s.indexOf('nplus1') !== -1;
      if (subId === 'selectstar') return s.indexOf('select-star') !== -1;
      if (subId === 'heavyloop')  return s.indexOf('heavy-loop') !== -1;
    }

    return false;
  }


  /* ══════════════════════════════════════════════════════
     TERMINAL
     ══════════════════════════════════════════════════════ */

  var termQueue   = [];
  var termRunning = false;

  function termClear(){ $('#fkTerminal').innerHTML = ''; }

  function termLine(cls, text){
    termQueue.push({ cls: cls, text: text });
    if (!termRunning) termFlush();
  }

  function termFlush(){
    var term = $('#fkTerminal');
    if (!termQueue.length){ termRunning = false; return; }
    termRunning = true;

    var item = termQueue.shift();
    var el = document.createElement('div');
    el.className = 'fk-term-line ' + (item.cls || '');
    el.textContent = item.text;
    term.appendChild(el);
    term.scrollTop = term.scrollHeight;

    setTimeout(termFlush, 50);
  }

  function termStatus(text, cls){
    var s = $('#fkTermStatus');
    if (!s) return;
    s.textContent = text;
    s.className = 'fk-terminal-status' + (cls ? ' ' + cls : '');
  }

  // Expor para uso cross-IIFE (o terminal do input está noutro IIFE)
  window.termLine   = termLine;
  window.termClear  = termClear;
  window.termStatus = termStatus;
  window.fetchJson  = fetchJson;
  window.escapeHtml = escapeHtml;

  /* ══════════════════════════════════════════════════════
     SCAN — DB (o único funcional para já)
     ══════════════════════════════════════════════════════ */

  /* ─── Barra de progresso ─── */
  function fkScrollLock(fn){
    // Executa fn() preservando a posicao de scroll
    var x = window.scrollX;
    var y = window.scrollY;
    fn();
    // Restaura no proximo frame (depois do layout assentar)
    requestAnimationFrame(function(){
      window.scrollTo(x, y);
    });
  }

  function progressShow(){
    fkScrollLock(function(){
      var el = document.getElementById('fkProgressWrap');
      if (el) el.style.display = '';
    });
    progressReset();
  }

  function progressHide(){
    setTimeout(function(){
      fkScrollLock(function(){
        var el = document.getElementById('fkProgressWrap');
        if (el) el.style.display = 'none';
      });
    }, 5000);
  }

  function progressReset(){
    document.querySelectorAll('.fk-progress-step').forEach(function(s){
      s.classList.remove('fk-step-running', 'fk-step-done', 'fk-step-error');
    });
    var fill = document.getElementById('fkProgressFill');
    if (fill){
      fill.style.width = '0%';
      fill.classList.remove('fk-fill-done', 'fk-fill-error');
    }
    var label = document.getElementById('fkProgressLabel');
    if (label) label.textContent = 'A iniciar…';
  }

  function progressSetStep(stepId, state){
    var el = document.querySelector('.fk-progress-step[data-step="' + stepId + '"]');
    if (!el) return;
    el.classList.remove('fk-step-running', 'fk-step-done', 'fk-step-error');
    if (state) el.classList.add('fk-step-' + state);
  }

  function progressSet(percent, label){
    var fill = document.getElementById('fkProgressFill');
    if (fill) fill.style.width = percent + '%';
    var lbl = document.getElementById('fkProgressLabel');
    if (lbl && label) lbl.textContent = label;
  }

  function progressFinish(){
    var fill = document.getElementById('fkProgressFill');
    if (fill){
      fill.style.width = '100%';
      fill.classList.add('fk-fill-done');
    }
    document.querySelectorAll('.fk-progress-step').forEach(function(s){
      s.classList.remove('fk-step-running');
      s.classList.add('fk-step-done');
    });
    var lbl = document.getElementById('fkProgressLabel');
    if (lbl) lbl.textContent = '✓ Análise concluída';
    progressHide();
  }

  function progressError(msg){
    var fill = document.getElementById('fkProgressFill');
    if (fill) fill.classList.add('fk-fill-error');
    var lbl = document.getElementById('fkProgressLabel');
    if (lbl) lbl.textContent = '✗ ' + (msg || 'Erro');
  }

  /* ─── Findings corrigidos (persistente) ─── */
  function getFixedIds(){
    try {
      var raw = localStorage.getItem('frankei:fixedFindings');
      return raw ? JSON.parse(raw) : {};
    } catch(e){ return {}; }
  }

  function markAsFixed(finding){
    var fixed = getFixedIds();
    var key = (finding.scanner || '') + '|' + (finding.data && finding.data.file ? finding.data.file : '') + '|' + (finding.data && finding.data.line ? finding.data.line : '');
    fixed[key] = Date.now();
    try {
      localStorage.setItem('frankei:fixedFindings', JSON.stringify(fixed));
    } catch(e){}
    finding._fixed = true;
  }

  function isFixed(finding){
    var fixed = getFixedIds();
    var key = (finding.scanner || '') + '|' + (finding.data && finding.data.file ? finding.data.file : '') + '|' + (finding.data && finding.data.line ? finding.data.line : '');
    return !!fixed[key];
  }

  function runScan(forceMode){
    if (state.busy) return;

    var tab = currentTab();
    if (!tab || !tab.enabled){
      termLine('fk-term-warn', '⚠ Esta análise ainda não está disponível.');
      return;
    }

    // Modo: parâmetro > localStorage > inferido pela tab
    var mode;
    if (forceMode) {
      mode = forceMode;
    } else {
      mode = 'all';
      try { mode = localStorage.getItem('frankei:runMode') || 'all'; } catch(e){}

      if (tab.id === 'security')   mode = 'security';
      if (tab.id === 'passwords')  mode = 'passwords';
      if (tab.id === 'db')         mode = 'db';
      if (tab.id === 'performance') mode = 'performance';
    }

    // Reset do sub-tab
    state.activeSubtab = 'all';
    updateHash(state.activeTab, 'all');

    // Opções
    var sequential = true;
    var liveBadges = true;
    try {
      var s = localStorage.getItem('frankei:sequential');
      var b = localStorage.getItem('frankei:liveBadges');
      if (s !== null) sequential = s === '1';
      if (b !== null) liveBadges = b === '1';
    } catch(e){}

    state.busy = true;
    setBusy(true);
    termClear();
    termStatus('a correr…', 'running');
    progressShow();
    termLine('fk-term-cmd', '$ frankei scan --mode=' + mode + ' --path=' + PATH);
    termLine('fk-term-info', '→ A iniciar análise (' + mode + ')...');
    termLine('', '');

    // Reset estados de tabs
    clearTabStatuses();

    // Definir as tarefas (com tabId para marcar visualmente)
    var tasks = [];

    if (mode === 'all' || mode === 'db'){
      tasks.push({
        tabId: 'db',
        type: 'db',
        run: function(){
          return fetchJson('/api/frankei/scan-path', { path: PATH }).then(function(r){
            var n = (r.databases || []).length;
            termLine('fk-term-info', '→ Base de dados: ' + n + ' alvo(s)');
            return { type: 'db', data: r };
          });
        }
      });
    }

    if (mode === 'all' || mode === 'security' || mode === 'passwords' || mode === 'performance'){
      // Recolher TODAS as opções (perf + segurança + pastas)
      var perfOptions = {
        // Desempenho
        skipScripts:       window.FrankeiOpts.skipScripts(),
        skipDdl:           window.FrankeiOpts.skipDdl(),
        skipTrivialLoops:  window.FrankeiOpts.skipTrivialLoops(),
        ignoreSelectById:  window.FrankeiOpts.ignoreSelectById(),
        skipViews:         window.FrankeiOpts.skipViews(),
        selectStarAsError: window.FrankeiOpts.selectStarAsError(),
        // Segurança — scanners ativos
        runXss:            window.FrankeiOpts.runXss(),
        runSqli:           window.FrankeiOpts.runSqli(),
        runCmdi:           window.FrankeiOpts.runCmdi(),
        runCodeExec:       window.FrankeiOpts.runCodeExec(),
        runCsrf:           window.FrankeiOpts.runCsrf(),
        runDeserialize:    window.FrankeiOpts.runDeserialize(),
        runFileInclusion:  window.FrankeiOpts.runFileInclusion(),
        runPathTraversal:  window.FrankeiOpts.runPathTraversal(),
        runOpenRedirect:   window.FrankeiOpts.runOpenRedirect(),
        runSsrf:           window.FrankeiOpts.runSsrf(),
        runXxe:            window.FrankeiOpts.runXxe(),
        // Segurança — pastas ignoradas
        ignoreVendor:        window.FrankeiOpts.ignoreVendor(),
        ignoreNodeModules:   window.FrankeiOpts.ignoreNodeModules(),
        ignoreTestsFixtures: window.FrankeiOpts.ignoreTestsFixtures(),
        ignoreBackups:       window.FrankeiOpts.ignoreBackups(),
        ignoreBuild:         window.FrankeiOpts.ignoreBuild(),
        // Performance
        runPerfNplus1:       window.FrankeiOpts.runPerfNplus1(),
        runPerfSelectStar:   window.FrankeiOpts.runPerfSelectStar(),
        runPerfHeavyLoop:    window.FrankeiOpts.runPerfHeavyLoop(),
        // Passwords
        runWeakPasswordHash: window.FrankeiOpts.runWeakPasswordHash(),
        // Código & Qualidade
        runCodeTodo:             window.FrankeiOpts.runCodeTodo(),
        runCodeErrorSuppression: window.FrankeiOpts.runCodeErrorSuppression(),
        runCodeMagicNumber:      window.FrankeiOpts.runCodeMagicNumber(),
        runCodeLongFunction:     window.FrankeiOpts.runCodeLongFunction(),
        runCodeDeepNesting:      window.FrankeiOpts.runCodeDeepNesting(),
        maxFunctionLines:        window.FrankeiOpts.maxFunctionLines(),
        maxNestingDepth:         window.FrankeiOpts.maxNestingDepth(),
        magicNumberMinLength:    window.FrankeiOpts.magicNumberMinLength(),
        // Avançado
        contextLines:         window.FrankeiOpts.contextLines(),
        maxFindings:          window.FrankeiOpts.maxFindings(),
        scannerTimeout:       window.FrankeiOpts.scannerTimeout(),
        attentionTables:      window.FrankeiOpts.attentionTables()
      };

      tasks.push({
        tabId: mode === 'passwords' ? 'passwords' : (mode === 'performance' ? 'performance' : 'security'),
        type: 'code',
        run: function(){
          // Mapeamento modo -> scanners (vazio = todos)
          var modeScanners = {
            'all':         [],
            'security':    ['php-xss','php-sqli','php-cmdi','php-code-exec','php-csrf',
                            'php-deserialize','php-fileinclusion','php-pathtraversal',
                            'php-openredirect','php-ssrf','php-xxe'],
            'passwords':   ['weak-password-hash'],
            'performance': ['perf-nplus1','perf-select-star','perf-heavy-loop']
          };
          var scanners = modeScanners[mode] || [];
          return fetchJson('/api/frankei/scan-code', { path: PATH, scanners: scanners, options: perfOptions }).then(function(r){
            var files = (r.stats && r.stats.files_scanned) || 0;
            termLine('fk-term-info', '→ Código: ' + files + ' ficheiros lidos');
            return { type: 'code', data: r };
          });
        }
      });
    }

    // Execução
    if (sequential){
      // Sequencial: uma tab de cada vez
      (async function(){
        var results = [];

        for (var i = 0; i < tasks.length; i++){
          var t = tasks[i];

          // Marcar tab como running
          setTabStatus(t.tabId, 'running');
          progressSetStep(t.tabId, 'running');

          var pct = Math.round(((i + 0.1) / tasks.length) * 100);
          progressSet(pct, 'A analisar ' + t.tabId + '… (' + (i + 1) + '/' + tasks.length + ')');

          try {
            var r = await t.run();
            results.push(r);

            // Contar findings desta tab
            var count = countFindingsInResult(r, t.tabId);
            setTabStatus(t.tabId, 'done', liveBadges ? count : undefined);
            progressSetStep(t.tabId, 'done');

            var pctDone = Math.round(((i + 1) / tasks.length) * 100);
            progressSet(pctDone, '✓ ' + t.tabId + ' concluído');
          } catch(err){
            setTabStatus(t.tabId, 'error');
            progressSetStep(t.tabId, 'error');
            throw err;
          }
        }

        handleScanSuccess(results, mode);
      })()
      .catch(function(err){
        progressError(err.message);
        handleScanError(err);
      })
      .finally(function(){
        state.busy = false;
        setBusy(false);
      });
    } else {
      // Paralelo (modo antigo)
      Promise.all(tasks.map(function(t){ return t.run(); }))
        .then(function(results){ handleScanSuccess(results, mode); })
        .catch(handleScanError)
        .finally(function(){
          state.busy = false;
          setBusy(false);
        });
    }
  }

  /* ─── Estados visuais das tabs ─── */
  function setTabStatus(tabId, status, count){
    var tabEl = document.querySelector('.fk-tab[data-tab="' + tabId + '"]');
    if (!tabEl) return;

    tabEl.classList.remove('fk-tab-running', 'fk-tab-done', 'fk-tab-error');

    if (status === 'running') tabEl.classList.add('fk-tab-running');
    if (status === 'done')    tabEl.classList.add('fk-tab-done');
    if (status === 'error')   tabEl.classList.add('fk-tab-error');

    // Atualizar badge
    if (count !== undefined){
      var badge = tabEl.querySelector('.fk-tab-badge');
      if (badge){
        badge.textContent = count;
        badge.classList.toggle('has-crit', count > 0);
      }
    } else if (status === 'running'){
      var badge2 = tabEl.querySelector('.fk-tab-badge');
      if (badge2 && !badge2.classList.contains('soon')){
        badge2.textContent = '...';
      }
    }
  }

  function clearTabStatuses(){
    document.querySelectorAll('.fk-tab').forEach(function(t){
      t.classList.remove('fk-tab-running', 'fk-tab-done', 'fk-tab-error');
    });
  }

  function countFindingsInResult(r, tabId){
    if (!r || !r.data || !r.data.findings) return 0;

    var n = 0;
    r.data.findings.forEach(function(f){
      if (tabId === 'db'){
        if (matchesTab(f, 'db')) n++;
      } else if (tabId === 'security'){
        if (matchesTab(f, 'security')) n++;
      } else if (tabId === 'passwords'){
        if (matchesTab(f, 'passwords')) n++;
      }
    });
    return n;
  }

  function fetchJson(url, body){
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    })
    .then(function(r){
      return r.json().then(function(d){
        if (!r.ok) throw new Error(d.error || ('HTTP ' + r.status));
        return d;
      });
    });
  }

  function handleScanSuccess(results, mode){
    termLine('', '');
    termLine('fk-term-info', '→ A processar resultados...');
    termLine('', '');

    // Agregar findings de todas as fontes
    var allFindings = [];
    var totals = { db: 0, code: 0 };
    var errors = [];
    var stats = {
      total: 0,
      by_severity: { critical: 0, high: 0, medium: 0, low: 0, info: 0 },
      by_category: {},
      elapsed_ms: 0,
      databases: 0,
      files_scanned: 0
    };

    results.forEach(function(r){
      var d = r.data;

      if (r.type === 'db'){
        totals.db = (d.findings || []).length;
        stats.databases = (d.databases || []).length;
        stats.elapsed_ms += (d.stats && d.stats.elapsed_ms) || 0;

        (d.databases || []).forEach(function(db){
          var bs = (d.by_database && d.by_database[db.key]) ? d.by_database[db.key] : null;
          var n  = bs ? bs.findings : 0;
          var cls = n > 0 ? 'fk-term-warn' : 'fk-term-ok';
          var ico = n > 0 ? '⚠' : '✓';
          termLine(cls, '  ' + ico + ' BD · ' + db.label + ' — ' + n + ' finding(s)');
        });

        (d.findings || []).forEach(function(f){
          f.database_key   = f.database_key   || 'db';
          f.database_label = f.database_label || 'Base de dados';
          allFindings.push(f);
        });

        (d.errors || []).forEach(function(e){ errors.push(e); });
      }

      if (r.type === 'code'){
        totals.code = (d.findings || []).length;
        stats.files_scanned = (d.stats && d.stats.files_scanned) || 0;
        stats.elapsed_ms += (d.stats && d.stats.elapsed_ms) || 0;

        // Aviso de truncagem (se o backend cortou findings)
        var truncInfo = '';
        if (d.stats && d.stats.truncated && d.stats.total_before_truncation){
          var removed = d.stats.total_before_truncation - totals.code;
          truncInfo = ' (mostrando ' + totals.code + ' de ' + d.stats.total_before_truncation + ', ' + removed + ' omitidos)';
        }

        termLine(totals.code > 0 ? 'fk-term-warn' : 'fk-term-ok',
          '  ' + (totals.code > 0 ? '⚠' : '✓') + ' Código — ' + totals.code + ' finding(s)' + truncInfo + ' em ' + stats.files_scanned + ' ficheiros');

        (d.findings || []).forEach(function(f){
          f.database_key   = f.category || 'code';
          allFindings.push(f);
        });

        (d.errors || []).forEach(function(e){ errors.push(e); });
      }
    });

    // Ordenar por severidade (global, antes de estatisticas)
    var SEV_ORDER_GLOBAL = { critical: 0, high: 1, medium: 2, low: 3, info: 4 };
    allFindings.sort(function(a, b){
      var sa = SEV_ORDER_GLOBAL[a.severity] != null ? SEV_ORDER_GLOBAL[a.severity] : 99;
      var sb = SEV_ORDER_GLOBAL[b.severity] != null ? SEV_ORDER_GLOBAL[b.severity] : 99;
      return sa - sb;
    });


    // Estatísticas agregadas
    stats.total = allFindings.length;
    allFindings.forEach(function(f){
      var sev = f.severity || 'info';
      var cat = f.category || 'other';
      if (stats.by_severity[sev] != null) stats.by_severity[sev]++;
      stats.by_category[cat] = (stats.by_category[cat] || 0) + 1;
    });

    // Erros
    (errors || []).forEach(function(e){
      var label = e.database || e.scanner || '?';
      termLine('fk-term-err', '  ✗ [' + label + '] ' + (e.message || 'erro'));
    });

    // Resumo final
    var sev   = stats.by_severity;
    var total = stats.total;
    termLine('', '');
    termLine('fk-term-info', 'Resumo:');
    termLine('fk-term-err',  '  🔴 Crítico:   ' + (sev.critical || 0));
    termLine('fk-term-err',  '  🔴 Alto:      ' + (sev.high || 0));
    termLine('fk-term-warn', '  🟡 Médio:     ' + (sev.medium || 0));
    termLine('fk-term-ok',   '  🟢 Baixo:     ' + (sev.low || 0));
    termLine('fk-term-info', '  🟢 Info:      ' + (sev.info || 0));
    termLine('fk-term-info', '  ─────────────');
    termLine('fk-term-info', '  📊 Total:     ' + total);
    termLine('', '');
    termLine('fk-term-ok', '✓ Análise concluída em ' + stats.elapsed_ms + 'ms');

    termStatus('concluído', 'done');

    // Guardar resultado no estado
    state.result = {
      findings: allFindings,
      stats: stats,
      errors: errors,
      mode: mode,
      scanned_at: new Date().toISOString()
    };

    // UI
    document.getElementById('fkStatDbs').textContent   = stats.databases + ' BD · ' + stats.files_scanned + ' ficheiros';
    document.getElementById('fkStatTotal').textContent = stats.total;
    document.getElementById('fkStatTime').textContent  = stats.elapsed_ms + 'ms';

    buildFilters(state.result);
    document.getElementById('fkFiltersCard').style.display = '';

    renderAll();
    document.getElementById('fkExportBtn').disabled = false;

    // Marcar progresso como concluído (só agora, no fim do terminal)
    progressFinish();
  }

  function handleScanError(err){
    termLine('fk-term-err', '✗ Erro: ' + err.message);
    termStatus('erro', 'error');
  }

  function setBusy(busy){
    var b = $('#fkScanBtn');
    if (b){ b.disabled = busy; b.innerHTML = busy ? '<span>⏳</span> A correr…' : '<span>▶</span> Correr análise'; }
  }

  /* ══════════════════════════════════════════════════════
     FILTROS
     ══════════════════════════════════════════════════════ */

  function buildFilters(data){
    var dbsEl = $('#fkFilterDbs');
    dbsEl.innerHTML = '';
    state.filters.dbs = {};

    (data.databases || []).forEach(function(db){
      state.filters.dbs[db.key] = true;
      var label = document.createElement('label');
      label.className = 'fk-chip';
      label.innerHTML = '<input type="checkbox" value="' + db.key + '" checked><span>' + db.label + '</span>';
      label.querySelector('input').addEventListener('change', onFilterChange);
      dbsEl.appendChild(label);
    });

    var catEl = $('#fkFilterCat');
    catEl.innerHTML = '';
    state.filters.cat = {};

    var cats = (data.stats && data.stats.by_category) ? Object.keys(data.stats.by_category) : [];
    cats.sort().forEach(function(cat){
      state.filters.cat[cat] = true;
      var label = document.createElement('label');
      label.className = 'fk-chip';
      label.innerHTML = '<input type="checkbox" value="' + cat + '" checked><span>' + cat + '</span>';
      label.querySelector('input').addEventListener('change', onFilterChange);
      catEl.appendChild(label);
    });

    $$('#fkFilterSev input').forEach(function(input){
      input.addEventListener('change', onFilterChange);
    });
  }

  function onFilterChange(){
    state.filters.dbs = {};
    state.filters.sev = {};
    state.filters.cat = {};

    $$('#fkFilterDbs input').forEach(function(i){ state.filters.dbs[i.value] = i.checked; });
    $$('#fkFilterSev input').forEach(function(i){ state.filters.sev[i.value] = i.checked; });
    $$('#fkFilterCat input').forEach(function(i){ state.filters.cat[i.value] = i.checked; });

    renderFindings();
  }


  /* ══════════════════════════════════════════════════════
     RENDER FINDINGS (filtrado por tab + subtab)
     ══════════════════════════════════════════════════════ */

  var SEV_LABEL = { critical:'Crítico', high:'Alto', medium:'Médio', low:'Baixo', info:'Info' };
  var SEV_ORDER = { critical: 0, high: 1, medium: 2, low: 3, info: 4 };

  /* ─── Resumo dos filtros ativos (abaixo do título Findings) ─── */
  function renderFiltersSummary(){
    var el = document.getElementById('fkFindingsFilters');
    if (!el) return;

    var sevOrder = ['critical', 'high', 'medium', 'low', 'info'];
    var sevIcons = { critical: '🔴', high: '🔴', medium: '🟡', low: '🟢', info: '🟢' };
    var sevLabels = { critical: 'Crítico', high: 'Alto', medium: 'Médio', low: 'Baixo', info: 'Info' };

    var sevOn  = [];
    var sevOff = [];

    sevOrder.forEach(function(s){
      if (state.filters.sev[s] !== false){
        sevOn.push('<span class="fk-fchip fk-fchip-on">' + sevIcons[s] + ' ' + sevLabels[s] + '</span>');
      } else {
        sevOff.push('<span class="fk-fchip fk-fchip-off">' + sevIcons[s] + ' ' + sevLabels[s] + '</span>');
      }
    });

    // Sub-tab
    var subHtml = '';
    if (state.activeSubtab && state.activeSubtab !== 'all'){
      subHtml = '<span class="fk-fchip fk-fchip-on">📑 ' + state.activeSubtab + '</span>';
    } else {
      subHtml = '<span class="fk-fchip fk-fchip-on">📑 todas</span>';
    }

    // Tab principal
    var tabHtml = '';
    if (state.activeTab && state.activeTab !== 'all'){
      tabHtml = '<span class="fk-fchip fk-fchip-on">📂 ' + state.activeTab + '</span>';
    } else {
      tabHtml = '<span class="fk-fchip fk-fchip-on">📂 todas</span>';
    }

    var html = '';
    html += '<div class="fk-filters-line"><span class="fk-filters-key">Filtros:</span> ' +
            tabHtml + ' ' + subHtml + ' ' + sevOn.join(' ') + '</div>';

    if (sevOff.length){
      html += '<div class="fk-filters-line fk-filters-line-off"><span class="fk-filters-key">Ocultos:</span> ' +
              sevOff.join(' ') + '</div>';
    }

    el.innerHTML = html;
  }

  /* ─── Bola visual por severidade ─── */
  function ballFor(finding){
    var sev = (finding.severity || 'info').toLowerCase();
    if (sev === 'critical' || sev === 'high') return '🔴';
    if (sev === 'medium' || finding.attention === true) return '🟡';
    if (sev === 'low')  return '🟢';
    return '🟢'; // info sem attention
  }

  function renderFindings(){
    var el      = $('#fkFindings');
    var countEl = $('#fkFindingsCount');

    if (!state.result || !state.result.findings){
      el.innerHTML =
        '<div class="fk-empty">' +
        '  <div class="fk-empty-icon">🔍</div>' +
        '  <p>Sem resultados ainda</p>' +
        '  <small>Corre a primeira análise para ver os problemas encontrados.</small>' +
        '</div>';
      countEl.textContent = '0';
      return;
    }

    // Se a opção "Mostrar corrigidos" está desligada, esconder os fixed
    var showFixed = true;
    try {
      var sf = localStorage.getItem('frankei:showFixed');
      if (sf !== null) showFixed = sf === '1';
    } catch(e){}

    var list = state.result.findings.filter(function(f){
      var tabOk = matchesTab(f, state.activeTab);
      var subOk = matchesSubtab(f, state.activeTab, state.activeSubtab);
      var dbOk  = state.filters.dbs[f.database_key] !== false;
      var sevOk = state.filters.sev[f.severity] !== false;
      var catOk = state.filters.cat[f.category] !== false;

      if (!(tabOk && subOk && dbOk && sevOk && catOk)) return false;

      // Esconder os já corrigidos (se a opção estiver off)
      if (!showFixed && isFixed(f)) return false;

      return true;
    });

    list.sort(function(a, b){
      var sa = SEV_ORDER[a.severity] != null ? SEV_ORDER[a.severity] : 99;
      var sb = SEV_ORDER[b.severity] != null ? SEV_ORDER[b.severity] : 99;
      return sa - sb;
    });

    countEl.textContent = list.length;

    // Resumo de filtros ativos (mostra o que está incluído/excluído)
    renderFiltersSummary();

    if (!list.length){
      el.innerHTML =
        '<div class="fk-empty">' +
        '  <div class="fk-empty-icon">✓</div>' +
        '  <p>Sem findings nesta vista</p>' +
        '  <small>Ajusta os filtros ou escolhe outra sub-tab.</small>' +
        '</div>';
      return;
    }

    el.innerHTML = '';

    list.forEach(function(f){
      var row = document.createElement('div');
      row.className = 'fk-finding';

      var sevLabel = SEV_LABEL[f.severity] || f.severity;
      var meta = [];
      if (f.table)  meta.push('<b>' + f.table + '</b>' + (f.column ? '.' + f.column : ''));
      if (f.data && f.data.file){
        meta.push('<b>' + f.data.file + '</b>' + (f.data.line ? ':' + f.data.line : ''));
      }
      if (f.scanner) meta.push(f.scanner);

      // Verificar se já foi corrigido
      var alreadyFixed = isFixed(f);
      if (alreadyFixed) {
        row.classList.add('fk-finding-fixed');
      }

      // Verificar se tem auto-fix disponível
      var fixType = '';
      if (f.scanner === 'php-csrf' && f.data && f.data.file) fixType = 'csrf';
      if (f.scanner === 'php-xss'  && f.data && f.data.file) fixType = 'xss';

      var hasAutoFix = (fixType !== '');

      // Findings críticos/altos sem auto-fix → alerta vermelho
      var needsManualFix = !hasAutoFix
        && (f.data && f.data.file)
        && (f.severity === 'critical' || f.severity === 'high');

      var actionsHtml = '';
      if (hasAutoFix){
        if (alreadyFixed){
          actionsHtml = '<span class="fk-fixed-badge-inline">✓ Corrigido</span>';
        } else {
          actionsHtml =
            '<div class="fk-finding-actions">' +
            '  <button class="fk-action-btn fk-action-fix" title="Corrigir automaticamente">🔧</button>' +
            '  <button class="fk-action-btn fk-action-view" title="Ver detalhes">👁</button>' +
            '</div>';
        }
      } else if (needsManualFix){
        actionsHtml =
          '<div class="fk-finding-actions">' +
          '  <button class="fk-action-btn fk-action-manual" title="Requer correcao manual — clica para ver detalhes">⚠️</button>' +
          '</div>';
      }

      // Icone de atencao (para findings info, distingue os que requerem atencao)
      var bola    = ballFor(f);
      var bolaCls = bola === '🔴' ? 'fk-attention-yes' : (bola === '🟡' ? 'fk-attention-med' : 'fk-attention-no');
      var attIcon = '<span class="fk-attention ' + bolaCls + '">' + bola + '</span> ';

      row.innerHTML =
        '<span class="fk-sev ' + f.severity + '">' + sevLabel + '</span>' +
        '<div class="fk-finding-main">' +
        '  <div class="fk-finding-title">' + attIcon + escapeHtml(f.title || f.description || '—') + '</div>' +
        '  <div class="fk-finding-meta">' + meta.join(' · ') + '</div>' +
        '</div>' +
        actionsHtml;

      // Click na linha (abre modal)
      row.addEventListener('click', function(e){
        // Se clicou num botão de ação → não abre modal
        if (e.target.closest('.fk-action-btn')) return;
        openModal(f);
      });

      // Handlers dos botões
      if (hasAutoFix){
        var fixBtn  = row.querySelector('.fk-action-fix');
        var viewBtn = row.querySelector('.fk-action-view');

        if (fixBtn){
          fixBtn.addEventListener('click', function(e){
            e.stopPropagation();
            // Aplica direto (com confirmação se skipConfirm estiver OFF)
            quickFixFromList(f, fixBtn, row);
          });
        }

        if (viewBtn){
          viewBtn.addEventListener('click', function(e){
            e.stopPropagation();
            openModal(f);
          });
        }
      } else if (needsManualFix){
        var manualBtn = row.querySelector('.fk-action-manual');

        if (manualBtn){
          manualBtn.addEventListener('click', function(e){
            e.stopPropagation();
            openModal(f);
          });
        }
      }

      el.appendChild(row);
    });
  }

  /* ─── Aplicar fix direto na lista ─── */
  function quickFixFromList(f, btn, row){
    if (window.FrankeiOpts && !window.FrankeiOpts.skipConfirm()){
      if (!confirm('Aplicar correcao CSRF em\n' + f.data.file + '\n\nContinuar?')) {
        return;
      }
    }

    btn.disabled = true;
    btn.textContent = '⏳';

    window.FrankeiFix.apply(f, function(r){
      if (!r.ok){
        btn.textContent = '✗';
        btn.classList.add('fk-action-error');
        setTimeout(function(){
          btn.textContent = '🔧';
          btn.classList.remove('fk-action-error');
          btn.disabled = false;
        }, 2000);
        return;
      }

      btn.textContent = '✓';
      btn.classList.add('fk-action-done');
      row.classList.add('fk-finding-fixed');

      // Marcar como fixed (persistente)
      markAsFixed(f);

      // Mostrar badge "Corrigido"
      var badge = document.createElement('span');
      badge.className = 'fk-fixed-badge';
      badge.textContent = '✓ Corrigido';
      var mainEl = row.querySelector('.fk-finding-main');
      if (mainEl) mainEl.appendChild(badge);

      // Re-render após 1s para refletir estado
      setTimeout(function(){
        renderFindings();
      }, 1000);
    });
  }

  function escapeHtml(s){
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  /* ══════════════════════════════════════════════════════
     MODAL
     ══════════════════════════════════════════════════════ */

  function openModal(f){
    var modal     = $('#fkModal');
    var modalBody = $('#fkModalBody');
    if (!modal || !modalBody) return;

    var sevLabel = SEV_LABEL[f.severity] || f.severity;

    var html = '';
    html += '<span class="fk-modal-sev fk-sev ' + f.severity + '">' + sevLabel + '</span>';
    html += '<h2 class="fk-modal-title">' + escapeHtml(f.title || '') + '</h2>';

    var sub = [];
    if (f.table)  sub.push(f.table + (f.column ? '.' + f.column : ''));
    if (f.data && f.data.file) sub.push(f.data.file + (f.data.line ? ':' + f.data.line : ''));
    if (f.scanner) sub.push('scanner: ' + f.scanner);

    if (sub.length) html += '<div class="fk-modal-sub">' + escapeHtml(sub.join(' · ')) + '</div>';

    if (f.description){
      html += '<div class="fk-modal-section">' +
              '  <div class="fk-modal-label">Descrição</div>' +
              '  <div class="fk-modal-text">' + escapeHtml(f.description) + '</div>' +
              '</div>';
    }

    if (f.impact){
      html += '<div class="fk-modal-section">' +
              '  <div class="fk-modal-label">Impacto</div>' +
              '  <div class="fk-modal-text">' + escapeHtml(f.impact) + '</div>' +
              '</div>';
    }

    if (f.suggestion){
      html += '<div class="fk-modal-section">' +
              '  <div class="fk-modal-label">Sugestão de correção</div>' +
              '  <div class="fk-modal-code">' + escapeHtml(f.suggestion) + '</div>' +
              '</div>';
    }

    if (f.reference){
      html += '<div class="fk-modal-section">' +
              '  <div class="fk-modal-label">Referência</div>' +
              '  <div class="fk-modal-text"><a href="' + escapeHtml(f.reference) + '" target="_blank" rel="noopener">' + escapeHtml(f.reference) + '</a></div>' +
              '</div>';
    }

    // Área de ações (auto-fix)
    html += '<div class="fk-modal-actions" id="fkModalActions"></div>';

    modalBody.innerHTML = html;
    modal.classList.add('open');
      try {
        if (typeof reportBindCheckboxes === 'function') reportBindCheckboxes();
        if (typeof reportRebuildTabs === 'function') reportRebuildTabs();
      } catch(e) {}

    // Botões de auto-fix (só para findings suportados)
    var actionsEl = document.getElementById('fkModalActions');
    if (actionsEl){
      if (f.scanner === 'php-csrf' && window.FrankeiFix && f.data && f.data.file){
        var btnPreview = document.createElement('button');
        btnPreview.className = 'fk-btn-fix fk-btn-fix-ghost';
        btnPreview.innerHTML = '👁 Pré-visualizar';
        btnPreview.addEventListener('click', function(){
          runPreviewFix(f, actionsEl);
        });

        var btnApply = document.createElement('button');
        btnApply.className = 'fk-btn-fix fk-btn-fix-primary';
        btnApply.innerHTML = '🔧 Aplicar correção';
        btnApply.addEventListener('click', function(){
          runApplyFix(f, actionsEl);
        });

        actionsEl.appendChild(btnPreview);
        actionsEl.appendChild(btnApply);
      } else {
        actionsEl.innerHTML = '<div style="font-size:12px;color:var(--muted-2)">Auto-fix disponível apenas para CSRF.</div>';
      }
    }
  }

  /* ─── Funções de auto-fix ─── */
  function runPreviewFix(f, actionsEl){
    actionsEl.innerHTML = '<div style="font-size:12px;color:var(--muted)">⏳ A gerar preview…</div>';

    window.FrankeiFix.preview(f, function(r){
      if (!r.ok){
        actionsEl.innerHTML = '<div style="font-size:12px;color:var(--crit)">✗ ' + escapeHtml(r.error || 'Erro') + '</div>';
        return;
      }

      var diffHtml =
        '<div class="fk-modal-label" style="margin-top:12px">Preview da correção</div>' +
        '<div class="fk-diff">' + (r.diff || '') + '</div>' +
        '<div style="display:flex;gap:10px;margin-top:12px">' +
        '  <button class="fk-btn-fix fk-btn-fix-primary" id="fkConfirmApply">✓ Confirmar e aplicar</button>' +
        '  <button class="fk-btn-fix fk-btn-fix-ghost" id="fkCancelApply">Cancelar</button>' +
        '</div>';

      actionsEl.innerHTML = diffHtml;

      var confirmBtn = document.getElementById('fkConfirmApply');
      var cancelBtn  = document.getElementById('fkCancelApply');

      if (confirmBtn){
        confirmBtn.addEventListener('click', function(){
          runApplyFix(f, actionsEl);
        });
      }
      if (cancelBtn){
        cancelBtn.addEventListener('click', function(){
          closeModal();
        });
      }
    });
  }

  function runApplyFix(f, actionsEl){
    if (!window.FrankeiOpts.skipConfirm() && !actionsEl.querySelector('.fk-diff')){
      runPreviewFix(f, actionsEl);
      return;
    }

    actionsEl.innerHTML = '<div style="font-size:12px;color:var(--muted)">⏳ A aplicar…</div>';

    window.FrankeiFix.apply(f, function(r){
      if (!r.ok){
        actionsEl.innerHTML = '<div style="font-size:12px;color:var(--crit)">✗ ' + escapeHtml(r.error || 'Erro') + '</div>';
        return;
      }

      f._fixed = true;

      actionsEl.innerHTML =
        '<div style="font-size:13px;color:var(--green);font-weight:700">✓ Corrigido!</div>' +
        (r.backup ? '<div style="font-size:11.5px;color:var(--muted-2);margin-top:4px">Backup: ' + escapeHtml(r.backup) + '</div>' : '');

      setTimeout(function(){
        renderFindings();
      }, 800);
    });
  }

  function closeModal(){
    var modal = $('#fkModal');
    if (modal) modal.classList.remove('open');
  }

  /* ══════════════════════════════════════════════════════
     EXPORT
     ══════════════════════════════════════════════════════ */

  function exportJson(){
    if (!state.result) return;
    var blob = new Blob([JSON.stringify(state.result, null, 2)], { type: 'application/json' });
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href = url;
    a.download = 'frankei-report-' + new Date().toISOString().slice(0,19).replace(/[:T]/g, '-') + '.json';
    a.click();
    URL.revokeObjectURL(url);
  }

  /* ══════════════════════════════════════════════════════
     RENDER GLOBAL
     ══════════════════════════════════════════════════════ */

  function renderTestsTab(){
    var el = document.getElementById('fkFindings');
    var countEl = document.getElementById('fkFindingsCount');
    if (!el) return;

    el.innerHTML = '<div class="fk-empty"><div class="fk-empty-icon">⏳</div><p>A carregar testes…</p></div>';
    if (countEl) countEl.textContent = '…';

    fetch('/api/frankei/terminal/report/download?file=' + encodeURIComponent('current/junit.xml'),
          { credentials: 'include' })
      .then(function(r){
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.text();
      })
      .then(function(xml){
        if (!window.JUnitView) {
          el.innerHTML = '<div class="fk-empty"><p>⚠️ junit-view.js não carregado</p></div>';
          return;
        }
        window.JUnitView.render(el, xml);
        var data = window.JUnitView.parse(xml);
        if (countEl) countEl.textContent = data.totals.tests;
      })
      .catch(function(e){
        el.innerHTML =
          '<div class="fk-empty">' +
          '  <div class="fk-empty-icon">📭</div>' +
          '  <p>Sem report de testes</p>' +
          '  <small>Corre primeiro <b>▶ Correr</b> ou <b>📥 Report</b>.</small>' +
          '  <small style="opacity:0.5">' + e.message + '</small>' +
          '</div>';
        if (countEl) countEl.textContent = '0';
      });
  }

  function renderAll(){
    // FK_GLOBAL_GUARD
    if (document.body && document.body.classList.contains('fk-trial-body')) return;

    renderTabs();
    renderSubtabs();
    renderContent();
    if (state.activeTab === 'tests') {
      renderTestsTab();
    } else {
      renderFindings();
    }
    updateTestActions();
  }

  /* ─── Barra de ações da tab Testes ─── */
  function updateTestActions(){
    var bar = document.getElementById('fkTestActions');
    if (!bar) return;

    // Só mostrar na tab Testes
    if (state.activeTab !== 'tests'){
      bar.style.display = 'none';
      return;
    }
    bar.style.display = 'flex';

    // Mostrar botões do header do terminal na tab tests
    var _repBtn = document.getElementById('fkTermReportBtn');
    if (_repBtn) _repBtn.style.display = 'inline-flex';
    var _createBtn = document.getElementById('fkTermCreateTestBtn');
    if (_createBtn) _createBtn.style.display = 'inline-flex';

    var sub   = state.activeSubtab || 'all';
    var label = document.getElementById('fkTestRunSubLabel');
    var hint  = document.getElementById('fkTestHint');
    var btn   = document.getElementById('fkTestRunSubBtn');

    // FK_RUN_LABEL_I18N: usar traducao dinamica
    var t = (window.FrankeiI18n && window.FrankeiI18n.t) ? window.FrankeiI18n.t : function(x){ return x; };

    var map = {
      'all':      { label: t('tudo'),          cmd: 'beaver test' },
      'unit':     { label: t('Unit'),          cmd: 'beaver test --testsuite=Unit' },
      'feature':  { label: t('Feature'),       cmd: 'beaver test --testsuite=Feature' },
      'coverage': { label: t('com cobertura'), cmd: 'beaver test --coverage-text' }
    };

    var conf = map[sub] || map.all;
    if (label) label.textContent = conf.label;
    if (hint)  hint.textContent  = '\u2192 ' + conf.cmd;
    if (btn)   btn.dataset.cmd   = conf.cmd;
  }

  /* ══════════════════════════════════════════════════════
     BOOT
     ══════════════════════════════════════════════════════ */

  function boot(){
        // FK_TRIAL_REPORT_ONLY: se estamos no trial, só ligar o modal do Report
    if (document.body && document.body.classList.contains('fk-trial-body')) {
      try {
        if (typeof reportInit === 'function') {
          reportInit();
          console.log('[trial] reportInit() executado');
        }
      } catch (e) {
        console.warn('[trial] reportInit falhou:', e);
      }
      return;
    }

    // Estado inicial do hash
    var r = parseHash();
    state.activeTab    = r.tab;
    state.activeSubtab = r.sub;

    // Eventos
    if ($('#fkScanBtn')) $('#fkScanBtn').addEventListener('click', function(){
      // Sincronizar state com hash (fonte de verdade)
      var hashTab = (window.location.hash || '').replace(/^#/, '').split('/')[0];
      if (hashTab && hashTab !== state.activeTab) {
        state.activeTab = hashTab;
      }

      // Na tab Testes: corre beaver test
      if (state.activeTab === 'tests') {
        if (typeof window.execTermCommand !== 'function') {
          console.error('execTermCommand indisponível');
          return;
        }
        var _sb = $('#fkScanBtn');
        var _origScan = _sb ? _sb.innerHTML : '';
        if (_sb) { _sb.disabled = true; _sb.innerHTML = '⏳ A correr…'; }
        window.execTermCommand('beaver test', {
          onDone: function(){
            if (_sb) { _sb.disabled = false; _sb.innerHTML = _origScan; }
            setTimeout(renderTestsTab, 600);
          }
        });
        return;
      }

      // Análise normal (BD + código)
      runScan();
    });
    if ($('#fkExportBtn')) $('#fkExportBtn').addEventListener('click', exportJson);
    if ($('#fkModalClose')) $('#fkModalClose').addEventListener('click', closeModal);

    // Botão secundário da tab Testes (Unit / Feature / Cobertura)
    var subBtn = document.getElementById('fkTestRunSubBtn');
    if (subBtn){
      subBtn.addEventListener('click', function(){
        var cmd = subBtn.dataset.cmd || 'beaver test';
        if (typeof window.execTermCommand !== 'function') {
          console.error('execTermCommand não disponível');
          return;
        }
        var _origSub = subBtn.innerHTML;
        subBtn.disabled = true;
        subBtn.innerHTML = '⏳ <span>A correr…</span>';
        window.execTermCommand(cmd, {
          onDone: function(){
            subBtn.disabled = false;
            subBtn.innerHTML = _origSub;
            if (state.activeTab === 'tests') setTimeout(renderTestsTab, 600);
          }
        });
      });
    }

    // Botão "Correr tudo"
    var runAllBtn = $('#fkRunAllBtn');
    if (runAllBtn){
      runAllBtn.addEventListener('click', function(){
        // Se estamos na tab Testes, corre beaver test
        if (state.activeTab === 'tests') {
          if (typeof window.execTermCommand !== 'function') {
            termLine('fk-term-err', '✗ Terminal não disponível');
            return;
          }
          var _origAll = runAllBtn.innerHTML;
          runAllBtn.disabled = true;
          runAllBtn.innerHTML = '⏳ A correr…';
          window.execTermCommand('beaver test', {
            onDone: function(){
              runAllBtn.disabled = false;
              runAllBtn.innerHTML = _origAll;
              setTimeout(renderTestsTab, 600);
            }
          });
          return;
        }

        // Caso contrário, comportamento normal: análise completa
        try { localStorage.setItem('frankei:runMode', 'all'); } catch(e){}

        state.activeTab    = 'db';
        state.activeSubtab = 'all';
        updateHash('db', 'all');
        renderAll();

        runScan('all');
      });
    }

    // Modal — fechar ao clicar fora
    var modal = $('#fkModal');
    if (modal){
      modal.addEventListener('click', function(e){
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') closeModal();
    });

    renderAll();
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }

})();

/* ══════════════════════════════════════════════════════════
   SETTINGS MENU (⚙️)
   ══════════════════════════════════════════════════════════ */
(function(){
  // Executa depois do DOM estar pronto
  function initSettings(){
    // FK_GLOBAL_GUARD: o trial tem a sua própria topbar
    if (document.body && document.body.classList.contains('fk-trial-body')) return;

    var wrap = document.querySelector('.fk-settings-wrap');
    var btn  = document.getElementById('fkSettingsBtn');
    var menu = document.getElementById('fkSettingsMenu');

    if (!wrap || !btn || !menu) return;

    // Toggle
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var wasOpen = wrap.classList.contains('open');
      wrap.classList.toggle('open');

      var m = document.getElementById('fkSettingsMenu');
      if (!wasOpen) {
        wrap.classList.add('menu-fixed');
        if (m) {
          var r = btn.getBoundingClientRect();
          m.style.top   = (r.bottom + 6) + 'px';
          m.style.right = (window.innerWidth - r.right) + 'px';
        }
      } else {
        wrap.classList.remove('menu-fixed');
        if (m) { m.style.top = ''; m.style.right = ''; }
      }
    });

    // Fechar ao clicar fora
    document.addEventListener('click', function(e){
      if (!wrap.contains(e.target)){
        wrap.classList.remove('open');
        wrap.classList.remove('menu-fixed');
        var m2 = document.getElementById('fkSettingsMenu');
        if (m2) { m2.style.top = ''; m2.style.right = ''; }
      }
    });

    // Fechar com Esc
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape'){
        wrap.classList.remove('open');
        wrap.classList.remove('menu-fixed');
        var m3 = document.getElementById('fkSettingsMenu');
        if (m3) { m3.style.top = ''; m3.style.right = ''; }
      }
    });

    // Botão fechar (✕)
    var closeBtn = document.getElementById('fkSettingsClose');
    if (closeBtn){
      closeBtn.addEventListener('click', function(){
        wrap.classList.remove('open');
        wrap.classList.remove('menu-fixed');
        var m4 = document.getElementById('fkSettingsMenu');
        if (m4) { m4.style.top = ''; m4.style.right = ''; }
      });
    }

    // Tabs do menu (Análise / Auto-fix / Conta)
    var tabs = document.querySelectorAll('.fk-settings-tab');
    var panels = document.querySelectorAll('.fk-settings-panel');

    tabs.forEach(function(tab){
      tab.addEventListener('click', function(){
        var target = tab.getAttribute('data-settings-tab');

        tabs.forEach(function(t){ t.classList.toggle('active', t === tab); });
        panels.forEach(function(p){
          p.classList.toggle('active', p.getAttribute('data-settings-panel') === target);
        });
      });
    });

    // Guardar escolha do modo no localStorage
    var radios = document.querySelectorAll('input[name="fkRunMode"]');
    var saved = null;
    try { saved = localStorage.getItem('frankei:runMode'); } catch(e){}

    if (saved){
      radios.forEach(function(r){
        r.checked = (r.value === saved);
      });
    }

    radios.forEach(function(r){
      r.addEventListener('change', function(){
        if (r.checked){
          try { localStorage.setItem('frankei:runMode', r.value); } catch(e){}
          wrap.classList.remove('open');
        }
      });
    });
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', initSettings);
  } else {
    initSettings();
  }
})();

/* ══════════════════════════════════════════════════════════
