  function initTermEngine(){
    var icon  = document.getElementById('fkTermEngineIcon');
    var label = document.getElementById('fkTermEngineLabel');
    var badge = document.getElementById('fkTermEngine');
    var menu  = document.getElementById('fkTermEngineMenu');

    if (!icon || !label || !badge) return;

