  function pickCurrentFile(){
    var v = reportState.activeView;
    for (var i = 0; i < reportState.files.length; i++){
      var p = reportState.files[i].path;
      if (v === 'html' && /coverage\/index\.html$/.test(p)) return reportState.files[i];
      if (v === 'xml'  && /junit\.xml$/.test(p))           return reportState.files[i];
    }
    return reportState.files[0] || null;
  }

  function parseJunitSummary(files){
    for (var i = 0; i < files.length; i++){
      if (/junit\.xml$/.test(files[i].path)) {
        var f = files[i];
        if (f._parsed) return f._parsed;
        var url = '/api/frankei/terminal/report/download?file=' +
                  encodeURIComponent('current/' + f.path);
        fetch(url, { credentials: 'include' })
          .then(function(r){ return r.text(); })
          .then(function(xml){
            try {
              if (!window.JUnitView) return;
              var parsed = window.JUnitView.parse(xml);
              f._parsed = parsed.totals;
              var el = document.getElementById('fkReportSummary');
              if (el) el.textContent =
                '✓ ' + parsed.totals.tests + ' testes  ·  ' +
                parsed.totals.assertions + ' assertions  ·  ⏱ ' +
                parsed.totals.time.toFixed(2) + 's';
            } catch(e){ console.warn('[junit parse]', e); }
          });
        return { tests: 0, assertions: 0, failures: 0, errors: 0, time: 0 };
      }
    }
    return null;
  }

  // FK_TABS_FOLLOW_CHECKBOXES: tabs seguem EXATAMENTE as checkboxes marcadas
  function reportRebuildTabs() {
    var tabsEl = document.getElementById('fkReportTabs');
    if (!tabsEl) return;

    // 1) Ler checkboxes marcadas
    var marcados = {};
    document.querySelectorAll('.fk-report-opt input[type=checkbox]').forEach(function (cb) {
      if (cb.checked && cb.dataset.type) marcados[cb.dataset.type] = true;
    });

    // 2) Construir lista de tabs com base no que esta marcado
    var tabs = [];
    tabs.push({ view: 'summary', label: 'Resumo' });
    if (marcados.coverage)   tabs.push({ view: 'html',             label: 'HTML' });
    if (marcados.junit)      tabs.push({ view: 'xml',              label: 'junit.xml' });
    if (marcados.clover)     tabs.push({ view: 'file:clover.xml',  label: 'clover.xml' });
    if (marcados.cobertura)  tabs.push({ view: 'file:cobertura.xml', label: 'cobertura.xml' });
    if (marcados.text)       tabs.push({ view: 'file:coverage.txt',  label: 'coverage.txt' });
    tabs.push({ view: 'files',  label: 'Ficheiros' });
    tabs.push({ view: 'beaver', label: '\ud83e\uddab Beaver Test Report' });

    // 3) Determinar qual fica ativa
    var ativo = reportState.activeView || 'summary';
    if (!tabs.some(function (t) { return t.view === ativo; })) {
      ativo = 'summary';
      reportState.activeView = 'summary';
    }

    // 4) Reconstruir (mantendo o botao de settings)
    var settingsBtn = document.getElementById('fkBeaverConfigBtn');
    tabsEl.innerHTML = '';
    tabs.forEach(function (t) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'fk-report-tab' + (t.view === ativo ? ' active' : '');
      b.dataset.view = t.view;
      b.textContent = t.label;
      b.addEventListener('click', function () {
        tabsEl.querySelectorAll('.fk-report-tab').forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active');
        reportState.activeView = t.view;
        reportRenderView();
      });
      tabsEl.appendChild(b);
    });
    if (settingsBtn) tabsEl.appendChild(settingsBtn);
  }

  // FK_TABS_FOLLOW_CHECKBOXES: escutar mudancas nas checkboxes
  function reportBindCheckboxes() {
    var opts = document.querySelectorAll('.fk-report-opt input[type=checkbox]');
    opts.forEach(function (cb) {
      if (cb.dataset.fkBound === '1') return;
      cb.dataset.fkBound = '1';
      cb.addEventListener('change', function () {
        // Reconstroi tabs imediatamente
        if (typeof reportRebuildTabs === 'function') reportRebuildTabs();
      });
    });
  }


  function reportRenderView(){
    var view = document.getElementById('fkReportView');
    if (!view) return;

    if (reportState.activeView === 'summary'){
      if (!reportState.files.length){
        view.innerHTML = '<div class="fk-report-empty"><div style="font-size:32px;opacity:0.4">📊</div><p>Clica em <b>Gerar report</b>.</p></div>';
        return;
      }
      var s = reportState.summary || {};
      var html = '<div style="font-family:JetBrains Mono,monospace;font-size:12.5px;line-height:1.7">';
      html += '<div>✓ ' + (s.tests || 0) + ' testes passados</div>';
      html += '<div>✗ ' + ((s.failures || 0) + (s.errors || 0)) + ' falhas</div>';
      html += '<div>📊 ' + (s.assertions || 0) + ' assertions</div>';
      html += '<div>⏱ ' + ((s.time || 0)).toFixed(2) + 's</div>';
      html += '<hr style="margin:14px 0;border:0;border-top:1px solid var(--border-2)">';
      html += '<div><b>Diretório:</b> ' + escapeHtml(reportState.dir) + '</div>';
      html += '<div><b>Ficheiros:</b> ' + reportState.files.length + '</div>';
      html += '</div>';
      view.innerHTML = html;
      return;
    }

    if (reportState.activeView === 'html'){
      var htmlFile = null;
      for (var i = 0; i < reportState.files.length; i++){
        if (/coverage\/index\.html$/.test(reportState.files[i].path)){ htmlFile = reportState.files[i]; break; }
      }
      if (!htmlFile){ view.innerHTML = '<div class="fk-report-empty"><p>Sem coverage HTML</p></div>'; return; }

      // Usa rota coverage-inline (HTML self-contained, CSS/JS inline)
      var previewUrl = '/api/frankei/terminal/coverage-inline?file=current/coverage/dashboard.html';

      view.innerHTML = '<iframe class="fk-report-preview-html" id="fkReportIframe" src="' +
        previewUrl + '"></iframe>';
      return;
    }

    // FK_DYNAMIC_TABS: tab XML (junit.xml) ou tabs dinamicas por ficheiro
    if (reportState.activeView === 'xml'){
      var xmlFile = null;
      for (var j = 0; j < reportState.files.length; j++){
        if (/junit\.xml$/.test(reportState.files[j].path)){ xmlFile = reportState.files[j]; break; }
      }
      if (!xmlFile){ view.innerHTML = '<div class="fk-report-empty"><p>Sem JUnit XML</p></div>'; return; }

      var url2 = '/api/frankei/terminal/report/download?file=' +
        encodeURIComponent('current/' + xmlFile.path);

      view.innerHTML = '<div style="padding:40px;text-align:center;color:#8A9099">\u23f3 A carregar resultados...</div>';

      fetch(url2, { credentials: 'include' })
        .then(function(r){ return r.text(); })
        .then(function(xml){
          if (window.JUnitView) {
            // FK_JUNIT_NO_DUP: limpar TODOS os .junit-view antes de renderizar
            try {
              document.querySelectorAll('.junit-view').forEach(function(el){ el.remove(); });
            } catch (_) {}
            view.innerHTML = '';
            window.JUnitView.render(view, xml);
          } else {
            var t = xml.length > 20000 ? xml.substring(0, 20000) + '\n\n[... truncado ...]' : xml;
            view.innerHTML = '<pre class="fk-report-preview-text">' + escapeHtml(t) + '</pre>';
          }
        })
        .catch(function(e){
          view.innerHTML = '<div class="fk-report-empty"><p>Erro: ' + escapeHtml(e.message) + '</p></div>';
        });
      return;
    }

    // FK_DYNAMIC_TABS: tab generica para clover.xml / cobertura.xml / coverage.txt
    if (/^file:/.test(reportState.activeView)){
      var ficheiro = reportState.activeView.replace(/^file:/, '');
      var f = null;
      for (var k = 0; k < reportState.files.length; k++){
        if (reportState.files[k].path === ficheiro){ f = reportState.files[k]; break; }
      }
      if (!f){ view.innerHTML = '<div class="fk-report-empty"><p>Ficheiro nao encontrado</p></div>'; return; }

      var urlF = '/api/frankei/terminal/report/download?file=' +
        encodeURIComponent('current/' + f.path);

      view.innerHTML = '<div style="padding:40px;text-align:center;color:#8A9099">\u23f3 A carregar ' + escapeHtml(f.path) + '...</div>';

      fetch(urlF, { credentials: 'include' })
        .then(function(r){ return r.text(); })
        .then(function(txt){
          var lim = txt.length > 50000 ? txt.substring(0, 50000) + '\n\n[... truncado ...]' : txt;
          var header = '<div style="padding:8px 12px;background:#faf6ee;border-bottom:1px solid #e8dcc8;font-size:11px;color:#8a7a68;font-weight:700">' +
                       escapeHtml(f.path) + ' \u00b7 ' + (f.size / 1024).toFixed(1) + ' KB</div>';
          view.innerHTML = header +
            '<pre class="fk-report-preview-text" style="margin:0;max-height:70vh;overflow:auto">' +
            escapeHtml(lim) + '</pre>';
        })
        .catch(function(e){
          view.innerHTML = '<div class="fk-report-empty"><p>Erro: ' + escapeHtml(e.message) + '</p></div>';
        });
      return;
    }

    if (reportState.activeView === 'beaver'){
      view.innerHTML = '<div class="cv-empty"><div class="cv-empty-icon">⏳</div><p>A carregar coverage...</p></div>';

      fetch('/api/frankei/terminal/coverage/data', { credentials: 'include' })
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (!d.ok) {
            view.innerHTML = '<div class="cv-empty"><div class="cv-empty-icon">⚠️</div><p>Erro: ' + escapeHtml(d.error || 'desconhecido') + '</p></div>';
            return;
          }
          function tryRender(){
            if (window.CoverageView) {
              view.innerHTML = '';
              window.CoverageView.render(view, d);
            } else {
              view.innerHTML = '<div class="cv-empty"><div class="cv-empty-icon">⏳</div><p>A carregar componente...</p></div>';
              setTimeout(tryRender, 400);
            }
          }
          tryRender();
        })
        .catch(function(e){
          view.innerHTML = '<div class="cv-empty"><div class="cv-empty-icon">⚠️</div><p>Erro: ' + escapeHtml(e.message) + '</p></div>';
        });
      return;
    }

    if (reportState.activeView === 'files'){
      if (!reportState.files.length){ view.innerHTML = '<div class="fk-report-empty"><p>Sem ficheiros</p></div>'; return; }
      var html2 = '<div class="fk-report-file-list">';
      reportState.files.forEach(function(f){
        var url3 = '/api/frankei/terminal/report/download?file=' +
          encodeURIComponent('current/' + f.path);
        html2 += '<div class="fk-report-file-item">';
        html2 += '<span class="name">' + escapeHtml(f.path) + '</span>';
        html2 += '<span class="size">' + fmtSize(f.size) + '</span>';
        html2 += '<a href="' + url3 + '" download><button>📥</button></a>';
        html2 += '</div>';
      });
      html2 += '</div>';
      view.innerHTML = html2;
    }
  }

  function fmtSize(b){
    if (b < 1024) return b + ' B';
    if (b < 1024*1024) return (b/1024).toFixed(1) + ' KB';
    return (b/(1024*1024)).toFixed(1) + ' MB';
  }

  function escapeHtml(s){
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', reportInit);
  } else {
    reportInit();
  }

})();

