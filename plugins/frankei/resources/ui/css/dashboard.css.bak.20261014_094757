  color: #991b1b;
}

/* ==== FK CV OVERLAY LOADING (FIX) ==== */
#cvTableWrap {
  position: relative !important;
}

.fk-cv-loading-overlay {
  position: absolute !important;
  inset: 0 !important;
  z-index: 100 !important;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  border-radius: 12px;
}

.fk-cv-loading-spinner {
  width: 44px;
  height: 44px;
  border: 4px solid #e5e7eb;
  border-top-color: #2b5cb8;
  border-radius: 50%;
  animation: fk-cv-spin 0.85s linear infinite;
}

@keyframes fk-cv-spin {
  to {
    transform: rotate(360deg);
  }
}

.fk-cv-loading-overlay p {
  margin: 0;
  font-size: 13.5px;
  font-weight: 600;
  color: #2b5cb8;
}

/* ═══════════════════════════════════════════════════════════
   TEST CREATOR — input de classe com autocomplete
   ═══════════════════════════════════════════════════════════ */
.fk-tc-class-input {
  flex: 1 1 260px;
  min-width: 220px;
  padding: 7px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12.5px;
  background: #fff;
  color: #1f2937;
  height: 32px;
  box-sizing: border-box;
}

.fk-tc-class-input:focus {
  outline: none;
  border-color: #2E9B5C;
  box-shadow: 0 0 0 3px rgba(46, 155, 92, .15);
}

.fk-tc-class-status {
  font-size: 15px;
  width: 20px;
  text-align: center;
  flex-shrink: 0;
  line-height: 32px;
}

.fk-tc-class-status.ok {
  color: #16a34a;
}

.fk-tc-class-status.err {
  color: #dc2626;
}

/* ═══════════════════════════════════════════════════════════
   TEST CREATOR — aumentar a modal (#fkTestCreatorModal)
   ═══════════════════════════════════════════════════════════ */
#fkTestCreatorModal .fk-tc-content {
  max-width: 1100px !important;
  width: 94vw !important;
  max-height: 94vh !important;
}

#fkTestCreatorModal .fk-tc-body {
  padding: 14px 22px !important;
}

#fkTestCreatorModal textarea.fk-tc-editor {
  min-height: 460px !important;
  font-size: 13.5px !important;
}


/* ═══════════════════════════════════════════════
 *   FK_GEAR_RIGHT — gear de configurações no extremo direito
 * ═══════════════════════════════════════════════ */
html body .fk-topbar-right > .fk-settings-wrap {
  order: 99;
}

/* FK_REPORT_LOADING_CSS — spinner do botao Gerar report */
.fk-btn .fk-spinner {
  display: inline-block;
  width: 13px;
  height: 13px;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-radius: 50%;
  animation: fk-spin 0.65s linear infinite;
  vertical-align: -2px;
  margin-right: 8px;
  flex: 0 0 auto;
}
@keyframes fk-spin {
  to { transform: rotate(360deg); }
}
.fk-btn.is-loading {
  pointer-events: none;
  opacity: 0.85;
}

/* FK_RV_LOADING_CSS — loading dentro de #fkReportView */
.fk-report-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  gap: 14px;
  color: var(--muted, #666);
}
.fk-report-loading-spinner {
  width: 38px;
  height: 38px;
  border: 3px solid rgba(43, 92, 184, 0.2);
  border-top-color: var(--blue, #2b5cb8);
  border-radius: 50%;
  animation: fk-rv-spin 0.8s linear infinite;
}
.fk-report-loading-text {
  font-size: 14px;
  font-weight: 600;
  color: var(--text, #333);
}
.fk-report-loading-sub {
  font-size: 12px;
  opacity: 0.7;
}
@keyframes fk-rv-spin {
  to { transform: rotate(360deg); }
}

/* FK_BEAVER_BUTTON_CSS — botao "Ver Report Beaver" */
.fk-btn-beaver {
  background: linear-gradient(135deg, #FFD79A 0%, #FF9A3C 48%, #FF6B35 100%);
  color: #1A1208;
  font-weight: 700;
  border: 1px solid #e08540;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 2px 8px rgba(255, 107, 53, .25);
}
.fk-btn-beaver:hover:not(:disabled) {
  filter: brightness(1.05);
  box-shadow: 0 4px 12px rgba(255, 107, 53, .35);
}
.fk-btn-beaver:disabled {
  opacity: .6;
  cursor: not-allowed;
  filter: grayscale(.3);
}
.fk-btn-beaver-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
}
.fk-btn-beaver-icon svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* FK_REMOVE_LOGO_BG — remover fundo do emoji do logo */
.fk-brand-logo,
.fk-topbar .fk-brand-logo,
.fk-topbar .fk-brand .fk-brand-logo {
  background: transparent !important;
  background-color: transparent !important;
  background-image: none !important;
  padding: 0 !important;
  margin: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  display: inline-block !important;
  width: auto !important;
  height: auto !important;
}

/* FK_SUBTABS_BLINK — sub-tabs bloqueadas + animação de negação */
.fk-subtab.locked {
  opacity: .55;
  cursor: not-allowed !important;
}
.fk-subtab.locked:hover {
  background: inherit !important;
}
.fk-subtab.fk-blink-denied {
  animation: fk-blink-deny .4s ease;
}
@keyframes fk-blink-deny {
  0%   { background: rgba(239, 68, 68, .05); box-shadow: 0 0 0 0 rgba(239,68,68,.6); }
  50%  { background: rgba(239, 68, 68, .3);  box-shadow: 0 0 0 4px rgba(239,68,68,.4); }
  100% { background: rgba(239, 68, 68, .05); box-shadow: 0 0 0 0 rgba(239,68,68,0); }
}
