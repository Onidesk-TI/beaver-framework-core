/* ==== FK REPORT ARROW HINT ==== */
/* Hierarquia de camadas:
     terminal card    → 10
     botão Report     → 20
     setas ::before/after → 30
*/

/* --- 1) TERMINAL CARD: camada própria, acima do resto --- */
.fk-terminal-card,
.fk-card.fk-terminal-card {
  position: relative;
  z-index: 10;
  overflow: visible !important;
}

/* --- 2) HEAD do terminal: contexto para o botão e as setas --- */
.fk-terminal-head {
  position: relative;
  z-index: 20;
  padding-top: 26px !important;
  padding-bottom: 26px !important;
  overflow: visible !important;
  isolation: auto !important;
}

/* todos os irmãos do botão ficam abaixo dele */
.fk-terminal-head>* {
  position: relative;
  z-index: 1;
}

/* --- 3) BOTÃO Report: acima do head, abaixo das setas --- */
.fk-term-report-btn {
  position: relative;
  z-index: 20 !important;
}

.fk-term-report-btn.fk-arrow-on {
  box-shadow: 0 0 0 3px rgba(249, 115, 22, .20);
  animation: fk-report-pulse 1.6s ease-in-out infinite;
}

/* --- 4) SETAS: topo absoluto --- */
.fk-term-report-btn.fk-arrow-on::before,
.fk-term-report-btn.fk-arrow-on::after {
  content: "";
  position: absolute;
  left: 50%;
  width: 0;
  height: 0;
  transform: translateX(-50%);
  border-left: 13px solid transparent;
  border-right: 13px solid transparent;
  filter: drop-shadow(0 2px 5px rgba(249, 115, 22, .6));
  pointer-events: none;
  z-index: 30 !important;
  /* topo absoluto */
}

/* seta por cima — aponta para baixo */
.fk-term-report-btn.fk-arrow-on::before {
  top: -26px;
  border-top: 18px solid #f97316;
  animation: fk-arrow-bounce 0.9s ease-in-out infinite;
}

/* seta por baixo — aponta para cima */
.fk-term-report-btn.fk-arrow-on::after {
  bottom: -26px;
  border-bottom: 18px solid #f97316;
  animation: fk-arrow-bounce 0.9s ease-in-out infinite 0.45s;
}

@keyframes fk-arrow-bounce {

  0%,
  100% {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  50% {
    opacity: .45;
    transform: translateX(-50%) translateY(-7px);
  }
}

@keyframes fk-report-pulse {

  0%,
  100% {
    box-shadow: 0 0 0 3px rgba(249, 115, 22, .20);
  }

  50% {
    box-shadow: 0 0 0 8px rgba(249, 115, 22, .06);
  }
}

