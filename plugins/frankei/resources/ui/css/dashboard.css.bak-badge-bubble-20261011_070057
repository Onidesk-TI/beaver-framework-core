/* ─── Fix: topbar + menu de configurações por cima de tudo ───
   O CSS define z-index:100 mas algum JS injeta z-index:10 inline.
   Forçamos com !important e especificidade máxima. */
html body header.fk-topbar,
html body .fk-topbar {
    z-index: 5000 !important;
    position: sticky !important;
    top: 0 !important;
}

html body .fk-settings-wrap {
    z-index: 5500 !important;
}

html body .fk-settings-menu {
    z-index: 6000 !important;
}

/* ─── Ordem de z-index coerente ───
   topbar (sticky)      : 5000
   settings menu        : 6000
   modais (A e B)       : 10000   ← sempre por cima de tudo */
html body .fk-modal,
html body #fkModal,
html body #fkReportModal {
    z-index: 10000 !important;
}

/* ─── Modal B SEMPRE por cima da Modal A ───
   Ambas têm z=10000, mas a fkModal vem antes no DOM,
   logo perdia o empate. Subimos a fkModal. */
html body #fkModal {
    z-index: 11000 !important;
}
html body #fkReportModal {
    z-index: 10000 !important;
}

/* ─── Modal B em fullscreen (ocupa toda a janela) ─── */
html body #fkModal.open {
    padding: 0 !important;
    align-items: stretch !important;
    justify-content: stretch !important;
}
html body #fkModal.open .fk-modal-content {
    width: 100vw !important;
    max-width: 100vw !important;
    height: 100vh !important;
    max-height: 100vh !important;
    margin: 0 !important;
    border-radius: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
}
html body #fkModal.open .fk-modal-body {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    padding: 0 !important;
}
html body #fkModal.open .cv-modal-head,
html body #fkModal.open .cv-modal-filters {
    flex: 0 0 auto !important;
}
html body #fkModal.open .cv-modal-code {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
}
html body #fkModal.open .cv-modal-code iframe {
    width: 100% !important;
    height: 100% !important;
    border: 0 !important;
}


/* fkFixedTerminalHeight: impede scroll indesejado no input do terminal */
.fk-terminal-input-wrap{
  scroll-margin-bottom:24px;
  overflow-anchor:none;
}
.fk-terminal-input{
  scroll-margin-bottom:24px;
}

/* ─── scroll-margin: alvos de âncoras não ficam escondidos pelo header sticky ─── */
.fk-terminal-card,
.fk-terminal-body,
.fk-term-line,
[id^="fkTerm"] {
    scroll-margin-top: 140px;   /* altura topbar (60) + tabs (40) + subtabs (40) */
}

/* Para os títulos das secções do dashboard */
.fk-card-title,
.fk-findings-head,
.fk-report-head {
    scroll-margin-top: 140px;
}

/* Código dentro do iframe (coverage-inline) */
#code tr,
table#code tr {
    scroll-margin-top: 90px;   /* breadcrumb + título */
}

/* ─── Esconder o input do terminal de análise ───
   Este terminal só corre subcomandos "beaver", não é um shell.
   O input (e o prompt "$") só deve aparecer num shell real.
   Para o mostrar num shell a sério, basta adicionar a classe
   .shell-enabled ao .fk-terminal-card:
       .fk-terminal-card.shell-enabled .fk-terminal-input-wrap { display: flex; }
*/
.fk-terminal-card:not(.shell-enabled) .fk-terminal-input-wrap {
    display: none !important;
}


/* ═══════════════════════════════════════════════
 *   TABS DO TOPBAR (Unit Tests ativa, resto bloqueado)
 * ═══════════════════════════════════════════════ */
.fk-top-tabs {
    display: flex;
    gap: 6px;
    margin-left: 24px;
    margin-right: auto;
    align-items: center;
}

.fk-top-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 10px;
    font-family: inherit;
    font-size: .84rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid transparent;
    background: transparent;
    color: #8895A7;
    cursor: pointer;
    transition: all .15s ease;
}

/* ── Ativa (Unit Tests) ── */
.fk-top-tab.active {
    background: linear-gradient(150deg, rgba(255,196,107,.22), rgba(255,154,60,.14));
    color: #FF9A3C;
    border-color: rgba(255,154,60,.45);
    box-shadow:
        0 0 0 1px rgba(255,154,60,.15) inset,
        0 6px 18px -8px rgba(255,140,60,.5);
    cursor: default;
}
.fk-top-tab.active::before {
    content: "";
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FF9A3C;
    box-shadow: 0 0 6px #FF9A3C;
}

/* ── Bloqueadas ── */
.fk-top-tab.locked {
    color: #4E5D70;
    background: rgba(255,255,255,.02);
    border-color: rgba(255,255,255,.05);
    cursor: not-allowed;
}
.fk-top-tab.locked:hover {
    color: #6B7280;
    background: rgba(255,255,255,.03);
}
.fk-top-tab.locked::after {
    content: "PRO";
    font-size: .6rem;
    font-weight: 800;
    letter-spacing: .06em;
    color: #FF9A3C;
    background: rgba(255,154,60,.14);
    padding: 2px 5px;
    border-radius: 4px;
    margin-left: 4px;
}

/* Mobile: esconder as tabs se não couberem */
@media (max-width: 900px) {
    .fk-top-tabs {
        display: none;
    }
}

/* ── Ícone do user no topbar ── */
.fk-user {
    display: inline-flex;
    align-items: center;
    gap: 0;
}
.fk-user-icon {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255,154,60,.15);
    color: #FF9A3C;
    font-size: .72rem;
    margin-right: 6px;
    border: 1px solid rgba(255,154,60,.3);
    flex: none;
}

/* ═══════════════════════════════════════════════
 *   Subtab PRO (bloqueada)
 * ═══════════════════════════════════════════════ */
.fk-subtab.is-pro {
    color: #6B7280 !important;
    background: rgba(255,255,255,.02) !important;
    border-color: rgba(255,255,255,.06) !important;
    cursor: not-allowed !important;
    position: relative;
}
.fk-subtab.is-pro:hover {
    background: rgba(255,154,60,.05) !important;
    color: #9CA3AF !important;
}
.fk-subtab .fk-subtab-badge.pro {
    background: linear-gradient(150deg, #FFC46B, #FF9A3C);
    color: #231202;
    font-size: .58rem;
    font-weight: 800;
    letter-spacing: .06em;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: 6px;
}

/* ═══════════════════════════════════════════════
 *   Modal PRO
 * ═══════════════════════════════════════════════ */
.fk-pro-overlay {
    position: fixed; inset: 0;
    z-index: 9900;
    background: rgba(7,10,15,.75);
    backdrop-filter: blur(8px);
    display: grid;
    place-items: center;
    padding: 20px;
    opacity: 0;
    transition: opacity .25s;
}
.fk-pro-overlay.open { opacity: 1; }

.fk-pro-modal {
    width: 100%;
    max-width: 440px;
    background: linear-gradient(175deg, #131B26, #0C121A);
    border: 1px solid rgba(255,154,60,.25);
    border-radius: 22px;
    padding: 36px 30px 26px;
    text-align: center;
    box-shadow: 0 40px 90px -30px rgba(0,0,0,.95);
    transform: scale(.95);
    transition: transform .3s cubic-bezier(.34,1.3,.64,1);
}
.fk-pro-overlay.open .fk-pro-modal { transform: none; }

.fk-pro-icon {
    font-size: 2.6rem;
    margin-bottom: 14px;
    line-height: 1;
}
.fk-pro-title {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -.025em;
    color: #E8EEF6;
    margin-bottom: 10px;
}
.fk-pro-text {
    font-size: .92rem;
    color: #8895A7;
    line-height: 1.55;
    margin-bottom: 24px;
}
.fk-pro-text b { color: #FFC46B; font-weight: 700; }

.fk-pro-actions {
    display: flex;
    gap: 10px;
}
.fk-pro-btn {
    flex: 1;
    padding: 12px 18px;
    border-radius: 11px;
    font-family: inherit;
    font-size: .88rem;
    font-weight: 700;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition: all .15s;
}
.fk-pro-btn-ghost {
    background: rgba(255,255,255,.04);
    color: #B9C4D4;
    border: 1px solid rgba(255,255,255,.12);
}
.fk-pro-btn-ghost:hover { background: rgba(255,255,255,.08); color: #fff; }

.fk-pro-btn-primary {
    background: linear-gradient(150deg, #FFC46B, #FF9A3C 55%, #FF6B35);
    color: #231202;
    box-shadow: 0 10px 24px -12px rgba(255,140,60,.6);
}
.fk-pro-btn-primary:hover { transform: translateY(-1px); }


/* ── Badge "Ficheiros em análise" (topbar) ── */
.fk-files-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 100px;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.1);
    color: #B9C4D4;
    font-size: .78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    cursor: help;
    transition: all .15s;
    margin-right: 8px;
}
.fk-files-badge:hover {
    background: rgba(255,154,60,.1);
    border-color: rgba(255,154,60,.35);
    color: #FFC46B;
}
.fk-files-badge-icon {
    font-size: .85rem;
    line-height: 1;
}
.fk-files-badge-count {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: .74rem;
    letter-spacing: .02em;
}
