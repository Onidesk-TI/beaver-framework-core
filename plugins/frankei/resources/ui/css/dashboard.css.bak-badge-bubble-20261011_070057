/* ============================================================
   Frankei · Dashboard — Parte 1: Base + Topbar
   ============================================================ */

:root{
  --blue:    #2b5cb8;
  --blue-600:#24509e;
  --blue-50: #f0f4fb;
  --blue-100:#e6ecf8;
  --bg:      #f5f6f8;
  --card:    #ffffff;
  --border:  #d4d8de;
  --border-2:#e6e9ee;
  --text:    #2c3238;
  --muted:   #6b7280;
  --muted-2: #8b95a3;

  --crit:    #d64545;
  --crit-bg: #fdecec;
  --high:    #e07800;
  --high-bg: #fff4e0;
  --med:     #b8860b;
  --med-bg:  #fef9e0;
  --low:     #2b5cb8;
  --low-bg:  #e6ecf8;
  --info:    #6b7280;
  --info-bg: #eef0f4;

  --term-bg: #0d1117;
  --term-fg: #c8d2e0;
  --radius:  10px;
}

*{box-sizing:border-box;margin:0;padding:0}

body{
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
  min-height: 100vh;
}

a{color:inherit;text-decoration:none}

/* ── TOPBAR ── */
.fk-topbar{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 22px;
  background: var(--card);
  border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:100;
  box-shadow:0 1px 4px rgba(20,30,50,.04);
}

.fk-topbar-left{display:flex;align-items:center;gap:16px;min-width:0}

.fk-brand{display:flex;align-items:center;gap:6px;font-size:14px;color:var(--text)}
.fk-brand-logo{font-size:16px}

.fk-path{
  font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;
  font-size:12px;padding:4px 10px;
  background: var(--border-2); color: var(--muted);
  border-radius:6px;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;max-width:520px;
}

.fk-topbar-right{display:flex;align-items:center;gap:14px;font-size:13px}
.fk-user{color:var(--muted)}
.fk-user b{color:var(--text)}

.fk-logout{
  color:var(--blue);font-weight:600;
  padding:6px 12px;border-radius:7px;
  border:1px solid var(--border);transition:background .12s;
}
.fk-logout:hover{background:var(--blue-50)}

/* ── LAYOUT ── */
.fk-layout{
  display:grid;
  grid-template-columns: 320px 1fr;
  gap:20px;
  padding:20px;
  max-width:1600px;
  margin:0 auto;
  align-items:start;
}

@media(max-width:900px){ .fk-layout{grid-template-columns:1fr} }

.fk-side{display:flex;flex-direction:column;gap:16px;position:sticky;top:80px}
.fk-main{display:flex;flex-direction:column;gap:16px;min-width:0}

/* ── CARDS ── */
.fk-card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:16px;
}

.fk-card-title{
  font-size:12.5px;font-weight:700;
  letter-spacing:.06em;text-transform:uppercase;
  color:var(--muted);margin-bottom:12px;
  display:flex;align-items:center;gap:8px;
}

.fk-count{
  background:var(--blue-100);color:var(--blue);
  font-size:11.5px;font-weight:800;
  padding:2px 8px;border-radius:100px;
  letter-spacing:0;
}

/* ── BOTÕES ── */
.fk-btn{
  display:inline-flex;align-items:center;justify-content:center;
  gap:8px;
  padding:10px 16px;
  font-family:inherit;font-size:13.5px;font-weight:600;
  border:1px solid transparent;border-radius:9px;
  cursor:pointer;
  transition: background .15s, border-color .15s, transform .08s;
}

.fk-btn:active{transform:translateY(1px)}
.fk-btn-block{width:100%;margin-bottom:8px}
.fk-btn-block:last-child{margin-bottom:0}

.fk-btn-primary{
  background:var(--blue);color:#fff;
  box-shadow:0 2px 8px rgba(43,92,184,.25);
}
.fk-btn-primary:hover{background:var(--blue-600)}
.fk-btn-primary:disabled{background:#c4ccd8;cursor:not-allowed;box-shadow:none}

.fk-btn-ghost{
  background:transparent;color:var(--muted);
  border-color:var(--border);
}
.fk-btn-ghost:hover:not(:disabled){background:var(--border-2);color:var(--text)}
.fk-btn-ghost:disabled{opacity:.5;cursor:not-allowed}

/* ── STATUS ── */
.fk-status{display:flex;flex-direction:column;gap:8px}
.fk-status-row{display:flex;justify-content:space-between;font-size:13px}
.fk-status-label{color:var(--muted)}
.fk-status-value{font-weight:700;color:var(--text)}

/* ── FILTROS ── */
.fk-filter-group{margin-bottom:14px}
.fk-filter-group:last-child{margin-bottom:0}

.fk-filter-label{
  display:block;font-size:11.5px;font-weight:700;
  letter-spacing:.05em;text-transform:uppercase;
  color:var(--muted-2);margin-bottom:8px;
}

.fk-filter-list{display:flex;flex-wrap:wrap;gap:6px}

.fk-chip{
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 10px;font-size:12px;font-weight:600;
  border-radius:100px;cursor:pointer;
  border:1px solid var(--border);
  background:var(--card);color:var(--muted);
  user-select:none;
  transition: background .12s, border-color .12s, color .12s;
}

.fk-chip input{display:none}

.fk-chip:has(input:checked){
  background:var(--blue-50);border-color:var(--blue);color:var(--blue);
}

.fk-chip-critical:has(input:checked){background:var(--crit-bg);border-color:var(--crit);color:var(--crit)}
.fk-chip-high:has(input:checked){background:var(--high-bg);border-color:var(--high);color:var(--high)}
.fk-chip-medium:has(input:checked){background:var(--med-bg);border-color:var(--med);color:var(--med)}
.fk-chip-low:has(input:checked){background:var(--low-bg);border-color:var(--low);color:var(--low)}
.fk-chip-info:has(input:checked){background:var(--info-bg);border-color:var(--info);color:var(--info)}

/* ── TERMINAL ── */
.fk-test-actions{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 14px;
  margin-bottom:10px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:10px;
}
.fk-test-actions .fk-btn{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:7px 14px;
  font-size:12.5px;
  font-weight:700;
}
.fk-test-hint{
  font-size:11.5px;
  color:var(--muted-2);
  font-family:'JetBrains Mono',monospace;
}

.fk-test-actions{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 14px;
  margin-bottom:10px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:10px;
}
.fk-test-actions .fk-btn{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:7px 14px;
  font-size:12.5px;
  font-weight:700;
}
.fk-test-hint{
  font-size:11.5px;
  color:var(--muted-2);
  font-family:'JetBrains Mono',monospace;
}

.fk-terminal-card{padding:0;overflow:hidden;background:var(--term-bg);border-color:#1a2028}

.fk-terminal-head{
  display:flex;align-items:center;gap:12px;
  padding:10px 16px;
  background:#161b22;
  border-bottom:1px solid #21262d;
}

.fk-terminal-dots{display:flex;gap:6px}
.fk-terminal-dots span{width:10px;height:10px;border-radius:50%}
.fk-terminal-dots span:nth-child(1){background:#ff5f57}
.fk-terminal-dots span:nth-child(2){background:#febc2e}
.fk-terminal-dots span:nth-child(3){background:#28c840}

.fk-terminal-title{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;color:#8b949e;flex:1;
}

.fk-term-engine{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:3px 9px;
  margin-left:8px;
  background:rgba(148, 92, 245, 0.12);
  border:1px solid rgba(148, 92, 245, 0.3);
  border-radius:5px;
  font-size:11px;
  font-weight:700;
  color:#a06ef5;
  font-family:'JetBrains Mono',monospace;
}
.fk-term-engine-icon{ font-size:12px; }
.fk-term-engine-label{ letter-spacing:0.02em; }
.fk-term-engine-caret{ font-size:9px; opacity:0.7; margin-left:2px; }

.fk-term-engine{ position:relative; cursor:pointer; user-select:none; }
.fk-term-engine:hover{ background:rgba(148,92,245,0.2); }

.fk-term-engine-menu{
  display:none;
  position:absolute;
  top:calc(100% + 6px);
  right:0;
  min-width:150px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:8px;
  box-shadow:0 8px 24px -8px rgba(20,30,50,0.25);
  padding:4px;
  z-index:300;
}
.fk-term-engine.open .fk-term-engine-menu{ display:block; }

.fk-term-engine-opt{
  display:flex;
  align-items:center;
  gap:8px;
  width:100%;
  padding:7px 10px;
  background:transparent;
  border:0;
  border-radius:5px;
  cursor:pointer;
  font-family:inherit;
  font-size:12px;
  font-weight:600;
  color:var(--text);
  text-align:left;
  transition:background .12s;
}
.fk-term-engine-opt:hover{ background:var(--bg-2); }
.fk-term-engine-opt[disabled]{ opacity:0.4; cursor:not-allowed; }
.fk-term-engine-opt[aria-current="true"]{ color:#a06ef5; }
.fk-term-engine-opt-icon{ font-size:13px; }

.fk-terminal-status{
  font-family:'JetBrains Mono',monospace;
  font-size:11.5px;color:#8b949e;
  padding:2px 8px;border-radius:100px;
  background:#21262d;
}
.fk-terminal-status.running{color:#febc2e;background:#3d2e00}
.fk-terminal-status.done{color:#28c840;background:#0d3018}
.fk-terminal-status.error{color:#ff5f57;background:#3d0e0e}

.fk-terminal-input-wrap{
  display:flex;
  align-items:center;
  gap:8px;
  padding:10px 14px;
  background:var(--card);
  border-top:1px solid var(--border-2);
  border-radius:0 0 10px 10px;
}
.fk-terminal-prompt{
  color:var(--muted-2);
  font-family:'JetBrains Mono',monospace;
  font-weight:700;
  font-size:13px;
  user-select:none;
}
.fk-terminal-input{
  flex:1;
  background:transparent;
  border:0;
  outline:none;
  color:var(--text);
  font-family:'JetBrains Mono',monospace;
  font-size:13px;
  padding:4px 0;
}
.fk-terminal-input::placeholder{
  color:var(--muted-2);
  opacity:0.5;
}
.fk-terminal-run-btn{
  background:var(--blue);
  color:#fff;
  border:0;
  border-radius:5px;
  padding:5px 10px;
  font-size:11px;
  font-weight:700;
  cursor:pointer;
  transition:opacity .15s;
}
.fk-terminal-run-btn:hover{opacity:.85}
.fk-terminal-run-btn:disabled{opacity:.4;cursor:not-allowed}

.fk-terminal-body{
  /* fkFixedTerminalHeight: altura fixa — não cresce, não dança */
  font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;
  font-size:12.5px;line-height:1.75;
  color:var(--term-fg);
  padding:16px 20px;
  height:320px;
  max-height:320px;
  overflow-y:auto;
  overflow-anchor:none;   /* impede o browser de "ancorar" e arrastar a página */
}

.fk-term-line{white-space:pre-wrap;word-break:break-word}
.fk-term-muted{color:#6e7681}
.fk-term-cmd{color:#79c0ff;font-weight:700}
.fk-term-ok{color:#56d364}
.fk-term-warn{color:#febc2e}
.fk-term-err{color:#ff7b72}
.fk-term-info{color:#8b949e}

/* ── FINDINGS ── */
.fk-findings-card{padding:0;overflow:hidden}

.fk-findings-head{
  padding:14px 18px;
  background:var(--card);
  border-bottom:1px solid var(--border);
}

.fk-findings-head .fk-card-title{margin-bottom:0}

.fk-findings-body{padding:0;max-height:600px;overflow-y:auto}

.fk-empty{
  padding:40px 24px;text-align:center;color:var(--muted-2);
}
.fk-empty-icon{font-size:36px;margin-bottom:12px;opacity:.5}
.fk-empty p{font-size:14px;font-weight:600;color:var(--muted);margin-bottom:4px}
.fk-empty small{font-size:12px}

.fk-finding{
  display:grid;grid-template-columns:auto 1fr auto;
  gap:14px;align-items:center;
  padding:14px 18px;
  border-bottom:1px solid var(--border-2);
  cursor:pointer;
  transition:background .12s;
  animation:fkSlide .3s ease;
}
.fk-finding:last-child{border-bottom:0}
.fk-finding:hover{background:var(--blue-50)}

@keyframes fkSlide{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

.fk-sev{
  font-size:10.5px;font-weight:800;letter-spacing:.05em;
  text-transform:uppercase;
  padding:4px 9px;border-radius:6px;
  white-space:nowrap;
}
.fk-sev.critical{background:var(--crit-bg);color:var(--crit);border:1px solid #f3c1c1}
.fk-sev.high{background:var(--high-bg);color:var(--high);border:1px solid #f0d49c}
.fk-sev.medium{background:var(--med-bg);color:var(--med);border:1px solid #f0e3a8}
.fk-sev.low{background:var(--low-bg);color:var(--low);border:1px solid #c3d3ef}
.fk-sev.info{background:var(--info-bg);color:var(--info);border:1px solid #d4d8de}

.fk-findings-filters{
  display:flex;
  flex-direction:column;
  gap:4px;
  margin-top:8px;
  padding:8px 0 0;
  font-size:11px;
  color:var(--muted);
  border-top:1px dashed var(--border-2);
}
.fk-filters-line{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:4px;
}
.fk-filters-line-off{ opacity:0.55; }
.fk-filters-key{
  font-weight:700;
  color:var(--muted-2);
  margin-right:4px;
}
.fk-fchip{
  display:inline-block;
  padding:2px 6px;
  border-radius:4px;
  font-size:10.5px;
  font-weight:600;
  background:var(--bg-2);
  border:1px solid var(--border-2);
  color:var(--muted);
}
.fk-fchip-on{
  background:#e8f5e8;
  border-color:#b8dcb8;
  color:#2a5d2a;
}
.fk-fchip-off{
  background:transparent;
  border-color:var(--border-2);
  color:var(--muted-2);
  text-decoration:line-through;
  opacity:0.7;
}

.fk-finding-main{min-width:0}

.fk-attention{
  display:inline-block;
  margin-right:4px;
  font-size:0.7em;
  vertical-align:middle;
  line-height:1;
}
.fk-attention-yes{ opacity:1; }
.fk-attention-no  { opacity:0.4; }
.fk-attention-med { opacity:0.85; }

.fk-finding-title{
  font-size:13.5px;font-weight:600;color:var(--text);
  margin-bottom:3px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.fk-finding-meta{
  font-size:11.5px;color:var(--muted-2);
  font-family:'JetBrains Mono',monospace;
  display:flex;gap:10px;
}
.fk-finding-meta b{color:var(--muted);font-weight:600}

.fk-finding-db{
  font-size:11px;font-weight:700;
  padding:3px 8px;border-radius:6px;
  background:var(--blue-50);color:var(--blue);
  border:1px solid var(--blue-100);
  white-space:nowrap;
}

/* ── MODAL ── */
.fk-modal{
  position:fixed;inset:0;z-index:1000;
  background:rgba(20,30,50,.7);
  backdrop-filter:blur(4px);
  display:none;align-items:center;justify-content:center;
  padding:24px;
}
.fk-modal.open{display:flex}

.fk-modal-content{
  background:var(--card);border-radius:14px;
  max-width:640px;width:100%;max-height:88vh;overflow-y:auto;
  position:relative;
  box-shadow:0 24px 60px -12px rgba(0,0,0,.35);
}

.fk-modal-close{
  position:absolute;top:14px;right:14px;
  width:36px;height:36px;border-radius:9px;
  display:grid;place-items:center;
  background:transparent;border:0;cursor:pointer;
  color:var(--muted);font-size:16px;
  transition:background .12s;
}
.fk-modal-close:hover{background:var(--border-2);color:var(--text)}

.fk-modal-body{padding:28px}

.fk-modal-sev{
  display:inline-block;
  font-size:11px;font-weight:800;letter-spacing:.06em;
  text-transform:uppercase;
  padding:5px 11px;border-radius:7px;
  margin-bottom:12px;
}

.fk-modal-title{
  font-size:20px;font-weight:800;
  letter-spacing:-.01em;margin-bottom:8px;
  color:var(--text);
}

.fk-modal-sub{
  font-size:13px;color:var(--muted);
  margin-bottom:24px;
  font-family:'JetBrains Mono',monospace;
}

.fk-modal-section{margin-bottom:20px}
.fk-modal-section:last-child{margin-bottom:0}

.fk-modal-label{
  font-size:11.5px;font-weight:700;
  letter-spacing:.06em;text-transform:uppercase;
  color:var(--muted-2);margin-bottom:6px;
}

.fk-modal-text{font-size:13.5px;color:var(--text);line-height:1.6}

.fk-modal-code{
  background:var(--term-bg);color:var(--term-fg);
  font-family:'JetBrains Mono',monospace;
  font-size:12.5px;
  padding:14px 16px;border-radius:8px;
  overflow-x:auto;white-space:pre;
  border:1px solid #21262d;
}

/* ══════════════════════════════════════════════════════════
   TABS PRINCIPAIS
   ══════════════════════════════════════════════════════════ */

.fk-tabs{
  display:flex;
  flex-wrap:wrap;
  gap:4px;
  padding:8px 20px 0;
  background:var(--card);
  border-bottom:1px solid var(--border);
  position:sticky;
  top:56px;
  z-index:90;
}

.fk-tab{
  display:inline-flex;align-items:center;gap:8px;
  padding:10px 16px;
  font-family:inherit;font-size:13px;font-weight:600;
  color:var(--muted);
  background:transparent;
  border:0;
  border-bottom:2px solid transparent;
  cursor:pointer;
  transition:color .15s,border-color .15s;
  white-space:nowrap;
}

.fk-tab:hover{color:var(--text)}

.fk-tab.active{
  color:var(--blue);
  border-bottom-color:var(--blue);
}

.fk-tab[disabled]{
  color:var(--muted-2);
  opacity:.55;
  cursor:not-allowed;
}

.fk-tab[disabled]:hover{color:var(--muted-2)}

.fk-tab-icon{font-size:15px}

.fk-tab-badge{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:18px;height:18px;padding:0 5px;
  font-size:10.5px;font-weight:800;
  border-radius:100px;
  background:var(--border-2);color:var(--muted);
}

.fk-tab.active .fk-tab-badge{
  background:var(--blue-100);color:var(--blue);
}

.fk-tab-badge.has-crit{background:var(--crit-bg);color:var(--crit)}
.fk-tab-badge.has-high{background:var(--high-bg);color:var(--high)}
.fk-tab-badge.soon{background:#f3f4f6;color:#9ca3af;font-size:9.5px;letter-spacing:.04em}

/* ══════════════════════════════════════════════════════════
   SUB-TABS
   ══════════════════════════════════════════════════════════ */

.fk-subtabs{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  padding:10px 20px;
  background:var(--blue-50);
  border-bottom:1px solid var(--border);
  position:sticky;
  top:105px;
  z-index:89;
}

.fk-subtab{
  display:inline-flex;align-items:center;gap:6px;
  padding:6px 12px;
  font-family:inherit;font-size:12px;font-weight:600;
  color:var(--muted);
  background:var(--card);
  border:1px solid var(--border);
  border-radius:100px;
  cursor:pointer;
  transition:all .15s;
}

.fk-subtab:hover{border-color:var(--blue);color:var(--blue)}

.fk-subtab.active{
  background:var(--blue);color:#fff;border-color:var(--blue);
}

.fk-subtab-badge{
  font-size:10px;font-weight:800;
  padding:1px 5px;border-radius:100px;
  background:rgba(255,255,255,.25);
}

.fk-subtab:not(.active) .fk-subtab-badge{
  background:var(--border-2);color:var(--muted);
}

/* ══════════════════════════════════════════════════════════
   PLACEHOLDER (tab "em breve")
   ══════════════════════════════════════════════════════════ */

.fk-placeholder{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:60px 24px;
  text-align:center;
}

.fk-placeholder-icon{font-size:56px;margin-bottom:16px;opacity:.7}
.fk-placeholder h2{font-size:22px;font-weight:800;margin-bottom:8px;color:var(--text)}
.fk-placeholder p{font-size:14px;color:var(--muted);max-width:520px;margin:0 auto 20px;line-height:1.6}

.fk-placeholder-list{
  display:flex;flex-wrap:wrap;gap:8px;justify-content:center;
  max-width:640px;margin:0 auto;
}

.fk-placeholder-item{
  font-size:12px;font-weight:600;
  padding:5px 11px;border-radius:100px;
  background:var(--blue-50);color:var(--blue);
  border:1px solid var(--blue-100);
}

/* BOTÃO "CORRER TUDO" NA TOPBAR */
.fk-btn-run-all{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 14px;
  font-family:inherit;font-size:12.5px;font-weight:700;
  color:#fff;
  background:linear-gradient(135deg,#3d6dd0,var(--blue) 60%,var(--blue-600));
  border:0;border-radius:8px;
  cursor:pointer;
  box-shadow:0 2px 8px rgba(43,92,184,.25);
  transition:transform .08s,box-shadow .15s;
}

.fk-btn-run-all:hover{
  box-shadow:0 4px 12px rgba(43,92,184,.35);
}

.fk-btn-run-all:active{transform:translateY(1px)}
.fk-btn-run-all:disabled{opacity:.5;cursor:not-allowed;box-shadow:none}

@media(max-width:640px){
  .fk-tabs{padding:6px 12px 0;top:52px}
  .fk-tab{padding:8px 10px;font-size:12px}
  .fk-tab-badge{display:none}
  .fk-subtabs{padding:8px 12px;top:96px}
  .fk-btn-run-all span:not(:first-child){display:none}
}

/* ══════════════════════════════════════════════════════════
   SETTINGS (icon ⚙️ + dropdown)
   ══════════════════════════════════════════════════════════ */

.fk-settings-wrap{position:relative;display:inline-block}

.fk-settings-btn{
  display:grid;place-items:center;
  width:36px;height:36px;
  background:transparent;
  border:1px solid transparent;
  border-radius:8px;
  color:var(--muted);
  cursor:pointer;
  transition:background .12s,color .12s,border-color .12s;
}

.fk-settings-btn:hover{
  background:var(--border-2);
  color:var(--text);
}

.fk-settings-wrap.open .fk-settings-btn{
  background:var(--blue-50);
  color:var(--blue);
  border-color:var(--blue-100);
}

.fk-settings-menu{
  position:absolute;
  top:calc(100% + 8px);
  right:0;
  min-width:280px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:12px;
  box-shadow:0 12px 36px -12px rgba(20,30,50,.25), 0 0 0 1px rgba(0,0,0,.02);
  padding:8px;
  z-index:200;
  opacity:0;
  visibility:hidden;
  transform:translateY(-6px);
  transition:opacity .15s,transform .15s,visibility .15s;
}

.fk-settings-wrap.open .fk-settings-menu{
  opacity:1;
  visibility:visible;
  transform:translateY(0);
}

.fk-settings-head{
  font-size:11px;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--muted-2);
  padding:8px 12px 10px;
}

.fk-settings-section{padding:4px 0}

.fk-settings-input-row{
  display:flex;
  flex-direction:column;
  gap:4px;
  padding:8px 12px;
}
.fk-settings-input-row label{
  font-size:12px;
  font-weight:600;
  color:var(--text);
}
.fk-settings-input-row input[type="number"],
.fk-settings-input-row input[type="text"]{
  padding:6px 10px;
  border:1px solid var(--border);
  border-radius:6px;
  font-size:13px;
  font-family:inherit;
  background:var(--card);
  color:var(--text);
  outline:none;
  transition:border-color .15s;
}
.fk-settings-input-row input:focus{
  border-color:var(--blue);
}
.fk-settings-input-row small{
  font-size:11px;
  color:var(--muted-2);
}

.fk-settings-label{
  font-size:11px;font-weight:700;letter-spacing:.05em;
  text-transform:uppercase;
  color:var(--muted-2);
  padding:4px 12px 8px;
}

.fk-settings-opt{
  display:flex;align-items:flex-start;gap:10px;
  padding:9px 12px;
  border-radius:8px;
  cursor:pointer;
  transition:background .1s;
  user-select:none;
}

.fk-settings-opt:hover{background:var(--blue-50)}

.fk-settings-opt input{display:none}

.fk-settings-opt::before{
  content:"";
  flex:none;
  width:16px;height:16px;
  margin-top:2px;
  border:1.5px solid var(--border);
  border-radius:50%;
  transition:border-color .15s,background .15s;
  position:relative;
}

.fk-settings-opt input:checked ~ span::before{
  content:"";
  position:absolute;
}

.fk-settings-opt:has(input:checked)::before{
  border-color:var(--blue);
  background:var(--blue);
  box-shadow:inset 0 0 0 3px var(--card);
}

.fk-settings-opt span{display:flex;flex-direction:column;flex:1;min-width:0}
.fk-settings-opt b{font-size:13px;font-weight:600;color:var(--text);line-height:1.3}
.fk-settings-opt small{font-size:11.5px;color:var(--muted-2);margin-top:2px}
.fk-settings-opt:has(input:checked) b{color:var(--blue)}

.fk-settings-sep{
  height:1px;
  background:var(--border-2);
  margin:8px 4px;
}

.fk-settings-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 12px;
  border-radius:8px;
  font-size:13px;font-weight:500;
  color:var(--text);
  cursor:pointer;
  transition:background .1s;
}

.fk-settings-item:hover{background:var(--blue-50);color:var(--blue)}

.fk-settings-item-danger:hover{background:var(--crit-bg);color:var(--crit)}


/* ── Botão auto-fix no modal ── */
.fk-modal-actions{
  display:flex;gap:10px;flex-wrap:wrap;
  margin-top:24px;
  padding-top:20px;
  border-top:1px solid var(--border-2);
}

.fk-btn-fix{
  display:inline-flex;align-items:center;gap:6px;
  padding:10px 16px;
  font-family:inherit;font-size:13px;font-weight:600;
  border:1px solid transparent;
  border-radius:9px;
  cursor:pointer;
  transition:background .15s,transform .08s;
}

.fk-btn-fix-primary{
  background:var(--blue);color:#fff;
  box-shadow:0 2px 8px rgba(43,92,184,.25);
}
.fk-btn-fix-primary:hover{background:var(--blue-600)}
.fk-btn-fix-primary:disabled{background:#c4ccd8;cursor:not-allowed}

.fk-btn-fix-ghost{
  background:transparent;color:var(--muted);
  border-color:var(--border);
}
.fk-btn-fix-ghost:hover{background:var(--border-2);color:var(--text)}

.fk-fixed-badge{
  display:inline-flex;align-items:center;gap:4px;
  padding:2px 8px;
  border-radius:100px;
  background:#e6f7ee;
  color:#1f9d55;
  font-size:11px;font-weight:700;
  margin-left:8px;
}

/* Diff visual */
.fk-diff{
  background:#0d1117;
  border-radius:8px;
  padding:14px 16px;
  margin:12px 0;
  font-family:'JetBrains Mono',monospace;
  font-size:12.5px;
  line-height:1.6;
  overflow-x:auto;
  border:1px solid #21262d;
}

.fk-diff-add{color:#56d364}
.fk-diff-rem{color:#ff7b72}
.fk-diff-ctx{color:#8b949e}

/* ══════════════════════════════════════════════════════════
   SETTINGS — Tabs horizontais dentro do menu
   ══════════════════════════════════════════════════════════ */

.fk-settings-head-bar{
  display:flex;align-items:center;justify-content:space-between;
  padding:10px 14px 8px;
}

.fk-settings-title{
  font-size:12.5px;font-weight:800;letter-spacing:.06em;
  text-transform:uppercase;
  color:var(--text);
}

.fk-settings-close{
  width:26px;height:26px;
  display:grid;place-items:center;
  background:transparent;border:0;
  border-radius:6px;
  color:var(--muted);font-size:14px;
  cursor:pointer;transition:background .12s,color .12s;
}
.fk-settings-close:hover{background:var(--border-2);color:var(--text)}

.fk-settings-tabs{
  display:flex;
  border-bottom:1px solid var(--border-2);
  padding:0 8px;
  gap:2px;
  overflow-x:auto;
  scrollbar-width:thin;
  scrollbar-color:var(--border-2) transparent;
}
.fk-settings-tabs::-webkit-scrollbar{height:4px}
.fk-settings-tabs::-webkit-scrollbar-thumb{background:var(--border-2);border-radius:2px}

.fk-settings-tab{
  flex:0 0 auto;
  padding:9px 12px;
  font-family:inherit;
  font-size:12px;font-weight:700;
  color:var(--muted);
  background:transparent;
  border:0;
  border-bottom:2px solid transparent;
  cursor:pointer;
  white-space:nowrap;
  transition:color .15s,border-color .15s;
}

.fk-settings-tab:hover{color:var(--text)}

.fk-settings-tab.active{
  color:var(--blue);
  border-bottom-color:var(--blue);
}

.fk-settings-body{
  padding:6px 0 8px;
  max-height:70vh;
  overflow-y:auto;
}

.fk-settings-panel{display:none}
.fk-settings-panel.active{display:block}

/* Override: dropdown maior para caber 6 tabs + opcoes */
.fk-settings-menu{
  min-width:560px;
  max-width:640px;
}
@media (max-width:700px){
  .fk-settings-menu{
    min-width:auto;
    max-width:95vw;
    width:95vw;
    right:8px;
  }
}

/* ══════════════════════════════════════════════════════════
   TABS — Estados visuais (running / done / error)
   ══════════════════════════════════════════════════════════ */

.fk-tab.fk-tab-running{
  color: var(--high);
  border-bottom-color: var(--high);
  animation: fkTabPulse 1.4s ease-in-out infinite;
}

.fk-tab.fk-tab-running .fk-tab-icon{
  display: inline-block;
  animation: fkTabSpin 1.2s linear infinite;
}

.fk-tab.fk-tab-running .fk-tab-badge{
  background: var(--high-bg);
  color: var(--high);
  font-family: 'JetBrains Mono', monospace;
}

.fk-tab.fk-tab-done{
  color: var(--green);
  border-bottom-color: var(--green);
}

.fk-tab.fk-tab-done .fk-tab-badge{
  background: var(--green-bg);
  color: var(--green);
}

.fk-tab.fk-tab-error{
  color: var(--crit);
  border-bottom-color: var(--crit);
}

.fk-tab.fk-tab-error .fk-tab-badge{
  background: var(--crit-bg);
  color: var(--crit);
}

/* Sub-tabs */
.fk-subtab.fk-subtab-running{
  background: var(--high-bg);
  border-color: var(--high);
  color: var(--high);
}

.fk-subtab.fk-subtab-done{
  background: var(--green-bg);
  border-color: var(--green);
  color: var(--green);
}

@keyframes fkTabPulse{
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.5; }
}

@keyframes fkTabSpin{
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* Ícone check verde quando done */
.fk-tab.fk-tab-done .fk-tab-icon{
  position: relative;
}

.fk-tab.fk-tab-done .fk-tab-icon::after{
  content: "✓";
  position: absolute;
  right: -6px;
  bottom: -4px;
  font-size: 10px;
  font-weight: 800;
  color: #fff;
  background: var(--green);
  border-radius: 50%;
  width: 14px;
  height: 14px;
  display: grid;
  place-items: center;
  border: 1.5px solid var(--card);
}

/* ══════════════════════════════════════════════════════════
   Toggles nas settings (100% compatível — sem :has)
   ══════════════════════════════════════════════════════════ */

.fk-settings-toggle{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:10px 12px;
  border-radius:8px;
  cursor:pointer;
  transition:background .12s;
  user-select:none;
}

.fk-settings-toggle:hover{background:var(--blue-50)}

/* Esconder o checkbox real (mas manter acessível) */
.fk-settings-toggle input[type="checkbox"]{
  position:absolute;
  opacity:0;
  pointer-events:none;
  width:0;
  height:0;
}

/* Track visual */
.fk-settings-toggle .fk-switch-track{
  position:relative;
  display:block;
  flex:none;
  width:34px;
  height:20px;
  margin-top:1px;
  border-radius:100px;
  background:#c4ccd8;
  transition:background .18s;
}

.fk-settings-toggle .fk-switch-track::after{
  content:"";
  position:absolute;
  left:2px;
  top:2px;
  width:16px;
  height:16px;
  border-radius:50%;
  background:#fff;
  transition:transform .18s;
  box-shadow:0 1px 3px rgba(0,0,0,.25);
}

/* Estado ligado — usa + (adjacente) */
.fk-settings-toggle input[type="checkbox"]:checked + .fk-switch-track{
  background:var(--blue);
}

.fk-settings-toggle input[type="checkbox"]:checked + .fk-switch-track::after{
  transform:translateX(14px);
}

/* Texto */
.fk-settings-toggle > span:last-child{
  display:flex;
  flex-direction:column;
  flex:1;
  min-width:0;
}

.fk-settings-toggle b{
  font-size:13px;
  font-weight:600;
  color:var(--text);
  line-height:1.3;
}

.fk-settings-toggle small{
  font-size:11.5px;
  color:var(--muted-2);
  margin-top:2px;
}

/* ══════════════════════════════════════════════════════════
   BARRA DE PROGRESSO (acima do terminal)
   ══════════════════════════════════════════════════════════ */

.fk-progress-wrap{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:14px 18px;
  margin-bottom:16px;
  animation: fkProgressFadeIn .3s ease;
}

@keyframes fkProgressFadeIn{
  from { opacity:0; transform:translateY(-6px); }
  to   { opacity:1; transform:none; }
}

.fk-progress-steps{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:12px;
  font-size:12.5px;
  font-weight:600;
}

.fk-progress-step{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:4px 10px;
  border-radius:100px;
  background:var(--border-2);
  color:var(--muted);
  transition:background .25s, color .25s;
}

.fk-progress-step.fk-step-running{
  background:var(--high-bg);
  color:var(--high);
  animation: fkProgressPulse 1.4s ease-in-out infinite;
}

.fk-progress-step.fk-step-done{
  background:var(--green-bg);
  color:var(--green);
}

.fk-progress-step.fk-step-done::after{
  content:"✓";
  font-weight:800;
  margin-left:2px;
}

.fk-progress-step.fk-step-error{
  background:var(--crit-bg);
  color:var(--crit);
}

.fk-progress-arrow{
  color:var(--muted-2);
  font-size:12px;
  opacity:.5;
}

.fk-progress-bar{
  height:6px;
  background:var(--border-2);
  border-radius:100px;
  overflow:hidden;
  margin-bottom:8px;
}

/* Fill base — AZUL sólido */
.fk-progress-fill{
  height:100%;
  background: #2b5cb8;
  border-radius:100px;
  transition:width .35s cubic-bezier(.4,0,.2,1);
  position:relative;
}

.fk-progress-fill::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent);
  animation: fkProgressShine 1.4s linear infinite;
}

/* Verde discreto no fim */
.fk-progress-fill.fk-fill-done{
  background: #1f9d55;
}

.fk-progress-fill.fk-fill-done::after{
  display:none;
}

/* Vermelho se erro */
.fk-progress-fill.fk-fill-error{
  background: #d64545;
}

.fk-progress-label{
  font-size:12px;
  color:var(--muted);
  font-family:'JetBrains Mono', monospace;
}

@keyframes fkProgressPulse{
  0%, 100% { opacity:1; }
  50%      { opacity:.55; }
}

@media(max-width:640px){
  .fk-progress-steps{font-size:11px; gap:4px}
  .fk-progress-arrow{display:none}
}

/* ── Botão "Corrigir" ao lado do Código ── */
.fk-modal-label-row{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:6px;
}

.fk-modal-label-row .fk-modal-label{margin-bottom:0}

.fk-btn-fix-inline{
  display:inline-flex;align-items:center;gap:4px;
  padding:5px 10px;
  font-family:inherit;font-size:11.5px;font-weight:700;
  border:1px solid var(--blue);
  border-radius:7px;
  background:var(--blue);
  color:#fff;
  cursor:pointer;
  transition:background .15s,transform .08s;
  white-space:nowrap;
}

.fk-btn-fix-inline:hover{background:var(--blue-600)}
.fk-btn-fix-inline:active{transform:translateY(1px)}
.fk-btn-fix-inline:disabled{opacity:.6;cursor:not-allowed}

.fk-btn-fix-inline.fk-fix-done{
  background:var(--green);
  border-color:var(--green);
}

.fk-btn-fix-inline.fk-fix-error{
  background:var(--crit);
  border-color:var(--crit);
}

/* ── Ações na linha de finding (🔧 / 👁) ── */
.fk-finding{
  grid-template-columns: auto 1fr auto auto;
}

.fk-finding-actions{
  display:flex;
  gap:4px;
  align-items:center;
}

.fk-action-btn{
  display:grid;
  place-items:center;
  width:28px;
  height:28px;
  font-size:14px;
  font-family:inherit;
  border-radius:7px;
  border:1px solid var(--border);
  background:var(--card);
  color:var(--muted);
  cursor:pointer;
  transition:background .12s, border-color .12s, color .12s, transform .08s;
}

.fk-action-btn:hover{
  background:var(--blue-50);
  border-color:var(--blue);
  color:var(--blue);
}

.fk-action-btn:active{transform:translateY(1px)}
.fk-action-btn:disabled{opacity:.6;cursor:not-allowed}

.fk-action-btn.fk-action-done{
  background:var(--green-bg);
  border-color:var(--green);
  color:var(--green);
  cursor:default;
}

.fk-action-btn.fk-action-error{
  background:var(--crit-bg);
  border-color:var(--crit);
  color:var(--crit);
}

.fk-finding.fk-finding-fixed{
  background: #f7fdf9;
}

.fk-finding.fk-finding-fixed .fk-finding-title{
  color:var(--green);
}

/* Badge inline para findings corrigidos */
.fk-fixed-badge-inline{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:4px 10px;
  border-radius:100px;
  background:var(--green-bg);
  color:var(--green);
  border:1px solid rgba(31,157,85,.3);
  font-size:11.5px;
  font-weight:700;
  white-space:nowrap;
}

/* ══════════════════════════════════════════════════════════
   Botão ⚠️ — findings críticos sem auto-fix
   ══════════════════════════════════════════════════════════ */

.fk-action-btn.fk-action-manual{
  border-color: rgba(214,69,69,.4);
  color: var(--crit);
  background: var(--crit-bg);
  font-size:15px;
}

.fk-action-btn.fk-action-manual:hover{
  background: var(--crit);
  border-color: var(--crit);
  color: #fff;
}

.fk-action-btn.fk-action-manual:active{
  transform: translateY(1px);
}

/* ══════════════════════════════════════════════════════════
   REPORT BUTTON (head do terminal)
   ══════════════════════════════════════════════════════════ */

.fk-term-report-btn{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:4px 10px;
  margin-left:8px;
  background:rgba(60,170,90,0.12);
  border:1px solid rgba(60,170,90,0.3);
  border-radius:5px;
  font-size:11px;
  font-weight:700;
  color:#3caa5a;
  cursor:pointer;
  font-family:inherit;
  transition:background .15s;
}
.fk-term-report-btn:hover{ background:rgba(60,170,90,0.22); }

/* ══════════════════════════════════════════════════════════
   REPORT MODAL (maior, dedicada)
   ══════════════════════════════════════════════════════════ */

.fk-report-modal-content{
  max-width:1100px;
  width:92vw;
  max-height:88vh;
  display:flex;
  flex-direction:column;
  padding:0;
  overflow:hidden;
}

.fk-report-head{
  padding:20px 28px 14px;
  border-bottom:1px solid var(--border-2);
}
.fk-report-title{
  margin:0 0 6px;
  font-size:18px;
  font-weight:700;
  color:var(--text);
}
.fk-report-summary{
  font-size:13px;
  color:var(--muted);
  font-family:'JetBrains Mono',monospace;
}

.fk-report-body{
  display:flex;
  flex:1;
  min-height:0;
  overflow:hidden;
}

.fk-report-side{
  width:240px;
  flex-shrink:0;
  padding:18px 20px;
  border-right:1px solid var(--border-2);
  overflow-y:auto;
}
