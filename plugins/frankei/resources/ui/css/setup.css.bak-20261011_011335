/* ============================================================
   Frankei · Setup + Topbar do dashboard
   Paleta: #2b5cb8 (azul) + #f5f6f8 (cinza claro)
   ============================================================ */

:root {
  --fk-blue: #2b5cb8;
  --fk-blue-600: #24509e;
  --fk-blue-100: #e6ecf8;
  --fk-blue-50: #f0f4fb;
  --fk-bg: #f5f6f8;
  --fk-card: #ffffff;
  --fk-border: #d4d8de;
  --fk-border-2: #e6e9ee;
  --fk-text: #2c3238;
  --fk-muted: #6b7280;
  --fk-muted-2: #8b95a3;
  --fk-green: #1f9d55;
  --fk-green-bg: #e6f7ee;
  --fk-red: #d64545;
  --fk-red-bg: #fdecec;
  --fk-amber: #f5a623;
  --fk-amber-bg: #fff4e0;
  --fk-radius: 10px;
  --fk-shadow: 0 4px 16px rgba(20, 30, 50, .06);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0
}

body {
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--fk-bg);
  color: var(--fk-text);
  font-size: 14px;
  line-height: 1.55;
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none
}

/* ════════════════════════════════════════════
   SETUP · Página /frankei/path
   ════════════════════════════════════════════ */

.fk-setup-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.fk-setup-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 28px;
  background: var(--fk-card);
  border-bottom: 1px solid var(--fk-border);
}

.fk-setup-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
}

.fk-setup-logo {
  font-size: 20px
}

.fk-setup-user {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 13px;
  color: var(--fk-muted);
}

.fk-link-logout {
  color: var(--fk-blue);
  font-weight: 600;
}

.fk-link-logout:hover {
  text-decoration: underline
}

.fk-setup-main {
  flex: 1;
  max-width: 640px;
  width: 100%;
  margin: 0 auto;
  padding: 56px 24px 40px;
}

.fk-steps {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 32px;
}

.fk-step {
  font-size: 12px;
  font-weight: 600;
  color: var(--fk-muted-2);
  padding: 4px 10px;
  border-radius: 100px;
  background: transparent;
}

.fk-step-done {
  color: var(--fk-green);
  background: var(--fk-green-bg)
}

.fk-step-active {
  color: var(--fk-blue);
  background: var(--fk-blue-100)
}

.fk-step-line {
  flex: 1;
  height: 1px;
  background: var(--fk-border);
  max-width: 40px;
}

.fk-setup-title {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -.02em;
  margin-bottom: 8px;
  color: var(--fk-text);
}

.fk-setup-sub {
  font-size: 14px;
  color: var(--fk-muted);
  margin-bottom: 28px;
}

.fk-form {
  display: flex;
  flex-direction: column;
  gap: 18px
}

.fk-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--fk-text);
  margin-bottom: -8px;
}

.fk-input-group {
  position: relative;
  display: flex;
  align-items: center;
}

.fk-input-icon {
  position: absolute;
  left: 14px;
  font-size: 16px;
  pointer-events: none;
}

.fk-input {
  width: 100%;
  padding: 13px 44px 13px 44px;
  font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  font-size: 13.5px;
  color: var(--fk-text);
  background: var(--fk-card);
  border: 1.5px solid var(--fk-border);
  border-radius: var(--fk-radius);
  outline: none;
  transition: border-color .15s, box-shadow .15s;
}

.fk-input::placeholder {
  color: var(--fk-muted-2)
}

.fk-input:focus {
  border-color: var(--fk-blue);
  box-shadow: 0 0 0 3px var(--fk-blue-100);
}

.fk-input.fk-input-ok {
  border-color: var(--fk-green);
  box-shadow: 0 0 0 3px var(--fk-green-bg);
}

.fk-input.fk-input-err {
  border-color: var(--fk-red);
  box-shadow: 0 0 0 3px var(--fk-red-bg);
}

.fk-input-status {
  position: absolute;
  right: 14px;
  font-size: 14px;
  pointer-events: none;
}

.fk-input-status.ok {
  color: var(--fk-green)
}

.fk-input-status.err {
  color: var(--fk-red)
}

.fk-input-status.loading {
  color: var(--fk-blue)
}

.fk-checks {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12.5px;
  color: var(--fk-muted);
  padding: 0 2px;
  min-height: 20px;
}

.fk-check {
  display: flex;
  align-items: center;
  gap: 8px;
  animation: fkFadeIn .2s ease;
}

.fk-check-ico {
  font-size: 13px;
  width: 16px;
  text-align: center
}

.fk-check-ico.ok {
  color: var(--fk-green)
}

.fk-check-ico.err {
  color: var(--fk-red)
}

.fk-check-ico.muted {
  color: var(--fk-muted-2)
}

.fk-checks-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.fk-chip {
  font-size: 11.5px;
  font-weight: 600;
  padding: 3px 9px;
  border-radius: 100px;
  background: var(--fk-blue-50);
  color: var(--fk-blue);
  border: 1px solid var(--fk-blue-100);
}

@keyframes fkFadeIn {
  from {
    opacity: 0;
    transform: translateY(-2px)
  }

  to {
    opacity: 1;
    transform: none
  }
}

/* Aviso privacidade */
.fk-privacy {
  display: flex;
  gap: 12px;
  padding: 14px 16px;
  background: var(--fk-blue-50);
  border: 1px solid var(--fk-blue-100);
  border-radius: var(--fk-radius);
  font-size: 12.5px;
  color: var(--fk-text);
  line-height: 1.6;
}

.fk-privacy-ico {
  font-size: 18px;
  flex: none
}

.fk-privacy b {
  color: var(--fk-blue);
  font-weight: 700
}

.fk-privacy p {
  margin: 4px 0 6px;
  color: var(--fk-muted)
}

.fk-privacy ul {
  margin: 0;
  padding-left: 18px;
  color: var(--fk-muted)
}

.fk-privacy li {
  margin: 2px 0
}

.fk-free-note {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 10px 14px;
  background: var(--fk-amber-bg);
  border: 1px solid #f5deb5;
  border-radius: var(--fk-radius);
  font-size: 12.5px;
  color: #8a5a00;
}

.fk-free-note b {
  color: #6b4500
}

.fk-alert {
  padding: 11px 14px;
  border-radius: var(--fk-radius);
  font-size: 13px;
  margin-bottom: 8px;
}

.fk-alert-error {
  background: var(--fk-red-bg);
  color: var(--fk-red);
  border: 1px solid #f3c1c1;
}

.fk-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 8px;
}

.fk-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 11px 20px;
  font-family: inherit;
  font-size: 13.5px;
  font-weight: 600;
  border: 1px solid transparent;
  border-radius: var(--fk-radius);
  cursor: pointer;
  transition: background .15s, border-color .15s, transform .08s;
}

.fk-btn:active {
  transform: translateY(1px)
}

.fk-btn-primary {
  background: var(--fk-blue);
  color: #fff;
  box-shadow: 0 2px 8px rgba(43, 92, 184, .25);
}

.fk-btn-primary:hover {
  background: var(--fk-blue-600)
}

.fk-btn-primary:disabled {
  background: #c4ccd8;
  cursor: not-allowed;
  box-shadow: none;
}

.fk-btn-ghost {
  background: transparent;
  color: var(--fk-muted);
  border-color: var(--fk-border);
}

.fk-btn-ghost:hover {
  background: var(--fk-border-2);
  color: var(--fk-text)
}

.fk-btn-arrow {
  font-size: 15px;
  transition: transform .15s
}

.fk-btn-primary:hover:not(:disabled) .fk-btn-arrow {
  transform: translateX(2px)
}

.fk-setup-foot {
  padding: 18px 28px;
  text-align: center;
  font-size: 12px;
  color: var(--fk-muted-2);
  display: flex;
  justify-content: center;
  gap: 8px;
}

/* ════════════════════════════════════════════
   DASHBOARD · Topbar
   ════════════════════════════════════════════ */

.fk-dash-body {
  background: var(--fk-bg);
  min-height: 100vh;
}

.fk-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 22px;
  background: var(--fk-card);
  border-bottom: 1px solid var(--fk-border);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 1px 4px rgba(20, 30, 50, .04);
}

.fk-topbar-left {
  display: flex;
  align-items: center;
  gap: 16px;
  min-width: 0;
}

.fk-topbar-brand {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  color: var(--fk-text);
}

.fk-topbar-logo {
  font-size: 16px
}

.fk-topbar-path {
  font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
  font-size: 12px;
  padding: 4px 10px;
  background: var(--fk-border-2);
  color: var(--fk-muted);
  border-radius: 6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 480px;
}

.fk-topbar-right {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 13px;
}

.fk-topbar-user {
  color: var(--fk-muted)
}

.fk-topbar-user b {
  color: var(--fk-text)
}

.fk-topbar-logout {
  color: var(--fk-blue);
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 7px;
  border: 1px solid var(--fk-border);
  transition: background .12s;
}

.fk-topbar-logout:hover {
  background: var(--fk-blue-50)
}

.fk-dash-main {
  padding: 20px;
  min-height: calc(100vh - 60px);
}

/* ── Imagem hero do setup ── */
.fk-hero-img {
  text-align: left;
  margin: 0 0 18px;
}

.fk-hero-img img {
  max-width: 600px;
  width: 100%;
  height: auto;
  display: block;
  border-radius: 10px;
  box-shadow: 0 8px 22px -12px rgba(43, 92, 184, .25);
}

@media(max-width: 620px) {
  .fk-hero-img img {
    max-width: 90px
  }
}
/* ── Tecnologias ── */
.fk-tech-section{
  display: flex; flex-direction: column; gap: 8px;
}

.fk-radio-row{
  display: flex; flex-wrap: wrap; gap: 8px;
}

.fk-radio{
  display: inline-flex; align-items: center; gap: 7px;
  padding: 8px 14px;
  background: var(--fk-card);
  border: 1.5px solid var(--fk-border);
  border-radius: 100px;
  font-size: 13px; font-weight: 500;
  cursor: pointer;
  transition: border-color .15s, background .15s, color .15s;
  user-select: none;
}

.fk-radio:hover{border-color: #b8c2d0}

.fk-radio input{
  display: none;
}

.fk-radio input:checked + span{
  color: var(--fk-blue);
  font-weight: 700;
}

.fk-radio:has(input:checked){
  border-color: var(--fk-blue);
  background: var(--fk-blue-50);
  box-shadow: 0 0 0 3px var(--fk-blue-100);
}

.fk-checkbox-grid{
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 8px;
}

.fk-checkbox{
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 12px;
  background: var(--fk-card);
  border: 1.5px solid var(--fk-border);
  border-radius: 8px;
  font-size: 13px;
  cursor: pointer;
  transition: border-color .15s, background .15s;
  user-select: none;
}

.fk-checkbox:hover{border-color: #b8c2d0}

.fk-checkbox input{
  appearance: none;
  width: 16px; height: 16px;
  border: 1.5px solid var(--fk-border);
  border-radius: 4px;
  background: #fff;
  position: relative;
  cursor: pointer;
  transition: background .12s, border-color .12s;
  flex: none;
}

.fk-checkbox input:checked{
  background: var(--fk-blue);
  border-color: var(--fk-blue);
}

.fk-checkbox input:checked::after{
  content: "";
  position: absolute;
  left: 4px; top: 1px;
  width: 5px; height: 9px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.fk-checkbox:has(input:checked){
  border-color: var(--fk-blue);
  background: var(--fk-blue-50);
}

.fk-checkbox:has(input:checked) span{
  color: var(--fk-blue);
  font-weight: 600;
}
