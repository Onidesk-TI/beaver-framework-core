{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://onidesk.com/schemas/beaver-theme.json",
    "title": "Beaver Theme Manifest",
    "type": "object",
    "required": [
        "name",
        "slug",
        "version",
        "beaver_version"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "beaver_version": {
            "type": "string"
        },
        "api_version": {
            "type": "string",
            "default": "1.0.0"
        },
        "author": {
            "type": "string"
        },
        "description": {
            "type": "string",
            "maxLength": 200
        },
        "license": {
            "type": "string"
        },
        "homepage": {
            "type": "string"
        },
        "screenshot": {
            "type": "string"
        },
        "parent": {
            "type": ["string", "null"]
        },
        "colors": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "supports": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "uniqueItems": true
        },
        "assets": {
            "type": "object",
            "additionalProperties": true
        }
    }
}
