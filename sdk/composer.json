{
    "name": "onidesk/beaver-sdk",
    "description": "SDK oficial para desenvolvimento de plugins do Beaver Framework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Beaver\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beaver\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
